			</Properties>
			<Item class="ModuleScript" referent="2">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 카메라 초안 (GDD 5.4). 각도는 도, 거리는 studs.
return {
	DefaultMode = "Sky", -- "Sky" | "First" (W1 A/B 대상)

	Distance = 16,
	SkyDistanceBonus = 10, -- SkyCamAltitude에 이르면 이만큼 더 뒤로 빠진다
	SkyCamAltitude = 500,
	Fov = 70,
	FovMax = 82,
	FocusHeight = 2,
	FirstPersonHeight = 1.5,

	DefaultPitch = -15,
	PitchMin = -80,
	PitchMax = 60,

	-- 다이브 캠: 하강 중이고 발밑이 DiveMinDrop보다 깊으면 시선을 DiveAngle만큼 내린다
	DiveAngle = 55, -- 35에서는 높이 떨어질 때 바로 아래 착지점이 화면 밖으로 나갔다 (2026-11-03 플레이테스트)
	DiveMinFallSpeed = 8,
	DiveMinDrop = 10,
	DiveInRate = 5,
	DiveOutRate = 7,

	MouseSensitivity = 0.3, -- 도/픽셀
	TouchSensitivity = 0.4,
	GamepadSpeed = 200, -- 도/초
	StickDeadzone = 0.2,
	ZoomMin = 6,
	ZoomMax = 40,
	ZoomStep = 2,

	MarkerEnabled = false, -- 기본은 그림자만 (사용자 요청 2026-11-04: 그림자가 보여서 파란 링은 없어도 된다). L로 켠다
	MarkerPredictSeconds = 4,
	MarkerStep = 0.05,

	-- 아찔함 (사용자 요청 2026-11-04: 높이 뛰면 고소공포가 느껴질 만큼)
	-- fall은 낙하 속도(종단 속도에서 1), void는 발밑 깊이(VoidDepthFull에서 1)
	FallFovBonus = 16, -- 종단 속도로 떨어질 때 넓어지는 시야(도)
	FallShake = 0.16, -- 최대 화면 흔들림(studs). 설정에서 끌 수 있게 한다
	FallShakeFrom = 0.55, -- fall이 이 값을 넘으면 흔들리기 시작
	VoidDepthFull = 600,
	VoidMinDepth = 40, -- 발밑이 이보다 얕으면 아찔함 연출을 하지 않는다
	EdgeProbeDistance = 6, -- 바라보는 방향으로 이만큼 앞이 허공이면 "가장자리"
	EdgeIntensity = 0.45,
	WindVolumeMin = 0.03,
	WindVolumeMax = 0.9,
	VignetteMax = 0.5,
	SpeedLineRate = 160,
	DropMeterMin = 60, -- 발밑이 이보다 깊을 때만 "아래로 n m"를 보여 준다
}
]]></ProtectedString>
					<string name="ScriptGuid">{BB81F08A-4CF4-4287-8E64-269803A7546E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Camera</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003e0</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 이동 물리 초안 (GDD 5.6). 단위: studs, 초. W1 토이에서 조정한다.
return {
	Gravity = 110,
	WalkSpeed = 20,
	AirSpeed = 28,
	JumpVelocity = { 70, 90, 120 }, -- 1단(지면) · 2단 · 3단
	PerfectMultiplier = 1.15,
	PerfectWindow = 0.10, -- 정점 기준 ±초
	-- 연속 퍼펙트 연출 단계 (GDD 5.2). 연출만 커지고 초속은 그대로다. 문구는 Strings PerfectTier1..
	PerfectStreakTiers = {
		{ from = 1, color = { 255, 205, 60 } },
		{ from = 2, color = { 255, 150, 50 } },
		{ from = 4, color = { 255, 95, 170 } },
		{ from = 6, color = { 175, 110, 255 } },
		{ from = 10, color = { 90, 220, 255 } },
	},
	PerfectStreakGroundGrace = 1.0, -- 땅에 이보다 오래 머물면 연속이 끊긴다
	TerminalFall = 160,
	StompDive = 180,
	StompBounce = 95,
	StompRestoreJumps = 1,
	BuddyBounceMult = 1.4,
	StaggerSpeed = 6, -- 러시에서 밟혀 휘청이는 동안의 걷기 속도 (점프는 막힌다)
	BouncePadVelocity = 150,
	UpdraftVelocity = 60,
	PufflingRespawn = 3,

	-- 관대함 장치 (GDD 5.5)
	CoyoteTime = 0.12,
	JumpBuffer = 0.12,

	-- 입력·판정 내부값
	JumpPressGap = 0.15, -- JumpRequest가 한 번 누를 때 여러 번 오는 것을 한 번으로 묶는 간격
	GroundLockTime = 0.12, -- 발사 직후 지면 판정을 무시하는 시간
	LaunchOvershootTolerance = 1, -- Humanoid가 덧붙인 초속이 이보다 크면 Config 초속으로 되돌린다
	LandingMaxVy = 1, -- 이보다 빠르게 올라가는 중이면 바닥이 감지돼도 착지가 아니다 (구름 통과)
	ProbeRadius = 1.5, -- 밟기 판정 구체 반경
	ProbeLookahead = 1,
	CloudSnap = 0.75, -- 발이 구름 윗면에서 이만큼 아래까지는 착지 허용

	BellRadius = 14,
	BellCooldown = 3,
	AltitudeZeroY = 0, -- 고도 0 m 기준 높이 (광장 윗면)
	FallResetY = -600, -- 구름 바다(World.CloudSeaY) 속. 길게 떨어지는 동안의 아찔함이 연출의 일부다
}
]]></ProtectedString>
