				</Color3>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Services</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8e5</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="RBX84129E68357A4667846A08A9D9D08168">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- Remote 인스턴스 생성과 요청 빈도 제한. 클라이언트가 보내는 것은 "의도"뿐이고 판단은 서비스가 한다
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"
folder.Parent = ReplicatedStorage

local lastCall: { [Player]: { [string]: number } } = {}

local function allowed(player: Player, name: string, minInterval: number): boolean
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local now = os.clock()
	if now - (calls[name] or -math.huge) < minInterval then
		return false
	end
	calls[name] = now
	return true
end

function Net.handleFunction(name: string, minInterval: number, handler: (Player, ...any) -> ...any)
	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = folder
	remote.OnServerInvoke = function(player, ...)
		if not allowed(player, name, minInterval) then
			return nil
		end
		return handler(player, ...)
	end
end

function Net.handleEvent(name: string, minInterval: number, handler: (Player, ...any) -> ())
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	remote.OnServerEvent:Connect(function(player, ...)
		if allowed(player, name, minInterval) then
			handler(player, ...)
		end
	end)
end

-- 서버가 보내기만 하는 이벤트 (클라이언트가 보내는 것은 받지 않는다)
function Net.event(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

function Net.forget(player: Player)
	lastCall[player] = nil
end

return Net
]]></ProtectedString>
					<string name="ScriptGuid">{FE1E81B2-4098-4B05-9125-A4FBB88954BD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Net</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8e6</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1B6EF18DA5164278BC4545EE42B2BB40">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 프로필 읽기·쓰기는 여기서만 한다 (CLAUDE.md). 세션 잠금과 저장(주기·퇴장·서버 종료)은 ProfileStore가 맡는다.
-- 새 필드는 TEMPLATE에 더하면 접속할 때 Reconcile로 채워진다. 기존 값의 뜻이 바뀌면 SCHEMA_VERSION을 올리고 변환 단계를 더한다.
-- Studio에서 API 접근이 꺼져 있으면 ProfileStore가 메모리 저장소를 쓴다 (플레이를 멈추면 사라짐).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ProfileStore = require(script.Parent.Parent.Packages.ProfileStore)
local Strings = require(ReplicatedStorage.Shared.Strings)

local DataService = {}

local SCHEMA_VERSION = 1
-- Studio 테스트 데이터가 실제 플레이어 데이터에 섞이지 않게 저장소를 나눈다
local STORE_NAME = if RunService:IsStudio() then "SkyhopProfile_Studio" else "SkyhopProfile"

export type Profile = {
	schemaVersion: number,
	coins: number,
	requests: { [string]: { medal: string, bestTime: number } },
	owned: { [string]: boolean }, -- 산 상점 물건 id
	equipped: { [string]: string }, -- 칸(Config Shop.Categories) -> 물건 id
	shards: { [string]: boolean }, -- 주운 숨은 별조각 id (Config Collectibles)
}

local TEMPLATE: Profile =
	{ schemaVersion = SCHEMA_VERSION, coins = 0, requests = {}, owned = {}, equipped = {}, shards = {} }

local store = ProfileStore.New(STORE_NAME, TEMPLATE)
local sessions: { [Player]: any } = {}

-- 클라이언트 표시용. 판단은 항상 서버의 프로필로 한다
local function publish(player: Player, data: Profile)
	player:SetAttribute("Coins", data.coins)
	player:SetAttribute("RequestProgress", HttpService:JSONEncode(data.requests))
	player:SetAttribute("ShopOwned", HttpService:JSONEncode(data.owned))
	player:SetAttribute("ShopEquipped", HttpService:JSONEncode(data.equipped))
	player:SetAttribute("Shards", HttpService:JSONEncode(data.shards))
end

local function load(player: Player)
	local profile = store:StartSessionAsync("Player_" .. player.UserId, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})
	if not profile then
		if player.Parent == Players then
			player:Kick(Strings.get(player.LocaleId, "KickLoadFailed"))
		end
		return
	end
	profile:AddUserId(player.UserId) -- 데이터 삭제 요청(GDPR) 대응
	profile:Reconcile()
	-- 다른 서버가 세션을 가져가면 여기서는 더 쓰지 않는다
	profile.OnSessionEnd:Connect(function()
		if sessions[player] == profile then
			sessions[player] = nil
			player:Kick(Strings.get(player.LocaleId, "KickSessionMoved"))
		end
	end)
	if player.Parent ~= Players then
		profile:EndSession()
		return
	end
	sessions[player] = profile
	publish(player, profile.Data)
end

function DataService.get(player: Player): Profile?
	local profile = sessions[player]
	return if profile then profile.Data else nil
end

function DataService.update(player: Player, mutate: (Profile) -> ())
	local profile = sessions[player]
	if not profile then
		return
	end
	mutate(profile.Data)
	publish(player, profile.Data)
end

function DataService.start()
	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		local profile = sessions[player]
		sessions[player] = nil
		if profile then
			profile:EndSession()
		end
	end)
end

return DataService
]]></ProtectedString>
					<string name="ScriptGuid">{86F34DDF-5F1E-4CA5-9845-CD4949E2C77B}</string>
