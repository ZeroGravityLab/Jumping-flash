		{
			id = "c1_flour",
			chapter = 1,
			resident = "Bram",
			type = "Delivery",
			item = "Flour",
			requires = { "c1_murk" },
			-- 징검다리 섬을 건너 허브 빵집(모모)까지
			target = { surface = { -54, 30, 0 }, island = "Skyhaven" },
			gold = 32,
			silver = 55,
			minTime = 14,
		},
		{
			id = "c1_ribbons",
			chapter = 1,
			resident = "Wren",
			type = "Collect",
			item = "Ribbon",
			-- 풍차 꼭대기, 바운스 꽃 위, 퍼플링 줄, 상승 기류 끝, 5·6번 나선 섬
			points = {
				{ air = { 22, 118, -18 } },
				{ air = { 96, 95, -10 } },
				{ air = { 84, 110, 40 } },
				{ air = { -38, 240, -52 } },
				{ satellite = { 5, 3 } },
				{ satellite = { 6, 3 } },
			},
			gold = 60,
			silver = 100,
			minTime = 18,
		},
		{
			id = "c1_kite_race",
			chapter = 1,
			resident = "Wren",
			type = "Race",
			requires = { "c1_ribbons" },
			-- 지름길: 바운스 꽃(높이 약 12)에서 튀어 오른 뒤 2·3단을 퍼펙트로 뛰면 4번 정원(208)보다 약 42 높이 올라
			-- 여유 있게 닿는다 (2026-11-04 Studio 실측, 금 4.7초). 퍼펙트가 없으면 약 9만 넘어 가장자리에 아슬아슬하게 걸쳐야 한다.
			-- 정원 바로 밑에서 뛰면 정원 바닥에 머리를 부딪힌다. 돌아가는 길은 3번 정원을 거친다
			points = {
				{ air = { 90, 70, -20 } },
