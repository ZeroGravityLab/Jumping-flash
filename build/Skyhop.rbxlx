				<Item class="ModuleScript" referent="18">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 점프·퍼펙트(연속 단계)·밟기·착지 연출. 클라이언트 전용.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Movement = require(ReplicatedStorage.Config.Movement)
local MovementLogic = require(ReplicatedStorage.Shared.MovementLogic)

-- Roblox 클라이언트 내장 사운드 (2026-11-02 로컬 content/sounds에서 확인). 전용 사운드는 아트 단계에서 교체
local SOUND_ID = {
	Jump = "rbxasset://sounds/action_jump.mp3",
	Land = "rbxasset://sounds/action_jump_land.mp3",
	Chime = "rbxasset://sounds/volume_slider.ogg",
}
local JUMP_PITCH = { 1, 1.26, 1.5 } -- 도·미·솔
-- 연속 퍼펙트 차임은 장음계로 한 음씩 오른다 (반음 수). 끝에 닿으면 높은 도에 머문다
local SCALE_STEPS = { 0, 2, 4, 5, 7, 9, 11, 12 }
local CHIME_BASE = 1.2
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local AURA_FROM_TIER = 3 -- 이 단계부터 연속이 끊길 때까지 몸에 반짝이가 붙는다

local COLOR = {
	Ring = Color3.fromRGB(255, 255, 255),
	Perfect = Color3.fromRGB(255, 205, 60),
	Shockwave = Color3.fromRGB(230, 240, 255),
}

local BOUNCE_COLOR = {
	stomp = Color3.fromRGB(255, 120, 200),
	pad = Color3.fromRGB(255, 212, 60),
	buddy = Color3.fromRGB(120, 255, 160),
}

local FLAT = CFrame.Angles(0, 0, math.rad(90))

local Effects = {}

local folder: Instance

local function play(name: string, speed: number, volume: number)
	local sound = Instance.new("Sound")
	sound.SoundId = SOUND_ID[name]
	sound.PlaybackSpeed = speed
	sound.Volume = volume
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

local function ring(position: Vector3, color: Color3, fromSize: number, toSize: number, duration: number)
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Color = color
	part.Transparency = 0.2
	part.Size = Vector3.new(0.2, fromSize, fromSize)
	part.CFrame = CFrame.new(position) * FLAT
	part.Parent = folder
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(part, info, { Size = Vector3.new(0.2, toSize, toSize), Transparency = 1 }):Play()
	Debris:AddItem(part, duration + 0.1)
end

local function tierColor(tier: number): Color3
	local rgb = Movement.PerfectStreakTiers[tier].color
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function sparkleEmitter(color: Color3): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE_TEXTURE
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new(0, 1)
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Rate = 0
	return emitter
end

-- 발밑에서 반짝이가 사방으로 한 번 터진다
local function sparkleBurst(position: Vector3, color: Color3, count: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = folder
	local emitter = sparkleEmitter(color)
	emitter.Parent = anchor
	emitter:Emit(count)
	Debris:AddItem(anchor, 1.2)
end

local function perfectChime(streak: number)
	local step = SCALE_STEPS[math.min(streak, #SCALE_STEPS)]
	play("Chime", CHIME_BASE * 2 ^ (step / 12), 0.6)
end

-- 기본 캐릭터 점프음은 단계별 음으로, 낙하음은 Vertigo의 바람 소리로 대신한다
local MUTED_DEFAULT_SOUNDS = { Jumping = true, FreeFalling = true }

local function muteDefaultJumpSound(character: Model)
	local root = character:WaitForChild("HumanoidRootPart")
	local function mute(child: Instance)
		if child:IsA("Sound") and MUTED_DEFAULT_SOUNDS[child.Name] then
			child.Volume = 0
		end
	end
	for _, child in root:GetChildren() do
		mute(child)
	end
	root.ChildAdded:Connect(mute)
end

function Effects.start(hop)
	folder = hop.localFolder

	local aura: ParticleEmitter? = nil
	local function clearAura()
		if aura then
			aura:Destroy()
			aura = nil
		end
	end
	local function setAura(tier: number)
		local root = hop.rootPart()
		if not root then
			return
		end
		if not aura or aura.Parent ~= root then
			clearAura()
			-- 몸을 감싸고, 날아가면 꼬리처럼 남는다
			aura = sparkleEmitter(tierColor(tier))
			aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.2), NumberSequenceKeypoint.new(1, 0) })
			aura.Speed = NumberRange.new(2, 5)
			aura.Drag = 1
			aura.Lifetime = NumberRange.new(0.7, 1.2)
			aura.Parent = root
		end
		aura.Color = ColorSequence.new(tierColor(tier), Color3.new(1, 1, 1))
		aura.Rate = 10 + tier * 10
	end

	hop.onJump:Connect(function(index, perfect, position, streak)
		play("Jump", JUMP_PITCH[index] or 1, 0.5)
		if not perfect then
			if index > 1 then
				ring(position, COLOR.Ring, 2, 9, 0.35)
			end
			return
		end
		-- 연속 단계가 오를수록 링이 커지고, 2단계부터 링이 겹치며 반짝이가 터진다
		local tier = MovementLogic.perfectTier(Movement, streak)
		local color = tierColor(tier)
		ring(position, color, 2, 14 + tier * 2, 0.35)
		if tier >= 2 then
			task.delay(0.08, ring, position, color, 4, 20 + tier * 4, 0.45)
			sparkleBurst(position, color, 6 + tier * 4)
		end
		if tier >= AURA_FROM_TIER then
			setAura(tier)
		end
		perfectChime(streak)
	end)
	hop.onPerfectStreakEnd:Connect(clearAura)

	hop.onBounce:Connect(function(kind, combo, position)
		-- 연쇄할수록 음이 오른다
		play("Jump", 1.5 + math.min(combo, 6) * 0.08, 0.6)
		ring(position, BOUNCE_COLOR[kind] or COLOR.Ring, 3, 12, 0.3)
	end)

	hop.onLand:Connect(function(stomped, position)
		if stomped then
			play("Land", 0.7, 0.8)
			ring(position, COLOR.Shockwave, 3, 22, 0.4)
		end
	end)

	-- 러시에서 밟혀 휘청: 쿵 소리와 머리 위를 도는 별
	hop.onStaggered:Connect(function(seconds)
		play("Land", 0.5, 1)
		local root = hop.rootPart()
		if not root then
			return
		end
		local stars = {}
		for i = 1, 3 do
			local star = Instance.new("Part")
			star.Name = "DizzyStar"
			star.Shape = Enum.PartType.Ball
			star.Anchored = true
			star.CanCollide = false
			star.CanQuery = false
			star.CanTouch = false
			star.CastShadow = false
			star.Material = Enum.Material.Neon
			star.Color = COLOR.Perfect
			star.Size = Vector3.new(0.9, 0.9, 0.9)
			star.Parent = folder
			stars[i] = star
		end
		local started = os.clock()
		local connection
		connection = RunService.RenderStepped:Connect(function()
			local t = os.clock() - started
			if t > seconds or not root.Parent then
				for _, star in stars do
					star:Destroy()
				end
				connection:Disconnect()
				return
			end
			for i, star in stars do
				local angle = t * 9 + i * math.pi * 2 / 3
				star.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(angle) * 1.8, 3.4, math.sin(angle) * 1.8))
			end
		end)
	end)

	hop.onBell:Connect(function(position)
		play("Chime", 0.5, 1)
		ring(position, COLOR.Perfect, 4, 40, 0.8)
	end)

	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(muteDefaultJumpSound)
	if player.Character then
		task.spawn(muteDefaultJumpSound, player.Character)
	end
end

return Effects
]]></ProtectedString>
						<string name="ScriptGuid">{B90A7DE6-3112-4AE9-9D0B-A4E6D2B5B040}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Effects</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003ef</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="19">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 3단 점프·정점 퍼펙트·스톰프·반동 (GDD 5.1~5.5).
-- 로컬 캐릭터 물리는 클라이언트 소유라 여기서 즉시 처리한다. 지면 점프는 Humanoid 기본 입력에 맡긴다.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Movement = require(ReplicatedStorage.Config.Movement)
local MovementLogic = require(ReplicatedStorage.Shared.MovementLogic)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Tags = require(ReplicatedStorage.Shared.Tags)

local player = Players.LocalPlayer

local HopController = {
	onJump = Signal.new(), -- (index, perfect, feetPosition, perfectStreak)
	onPerfectStreakEnd = Signal.new(), -- (끊기기 전 연속 퍼펙트 횟수)
	onBounce = Signal.new(), -- (kind: "stomp" | "pad" | "buddy", combo, feetPosition, part?)
	onLand = Signal.new(), -- (stomped, feetPosition)
	onBell = Signal.new(), -- (feetPosition)
	onRespawn = Signal.new(), -- 구름 바다로 떨어져 되돌아왔을 때
	onStaggered = Signal.new(), -- (seconds, reason?) 휘청일 때 (러시 밟힘, 보스 번개 "zap")
	stats = {
		startedAt = os.clock(),
		airJumps = {}, -- ToyStats.AirJump 목록
		stomps = 0,
		bells = 0,
		maxAltitude = 0,
		bestPerfectStreak = 0,
	},
	localFolder = nil :: Folder?, -- 복제되지 않는 클라이언트 전용 파트
}

local character, humanoid, root

local jumpsUsed = 0
local grounded = true
local arcLaunched = false
local stomping = false
local combo = 0
local perfectStreak = 0
local landedAt = -math.huge
local staggerUntil = 0
local staggering = false
local lastGroundedAt = -math.huge
local groundLockUntil = 0
local lastLaunchAt = -math.huge
local lastJumpRequestAt = -math.huge
local bufferedJumpAt = -math.huge
local launchVelocity: number? = nil -- Humanoid가 덧붙인 초속을 되돌릴 목표값
local lastBellAt = -math.huge
local nearBell = false
local safePosition: Vector3? = nil -- 떨어졌을 때 돌아올 곳: 마지막으로 가장자리가 아닌 땅에 서 있던 자리
local lastSafeCheckAt = 0

local cloudParts, updraftParts, bellParts

local probeParams = RaycastParams.new()
probeParams.FilterType = Enum.RaycastFilterType.Exclude

local function trackTag(tag: string): { BasePart }
	local list = CollectionService:GetTagged(tag)
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
		table.insert(list, instance)
	end)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		local index = table.find(list, instance)
		if index then
			table.remove(list, index)
		end
	end)
	return list
end

local function feetOffset(): number
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return 3
	end
	return humanoid.HipHeight + root.Size.Y / 2
end

function HopController.character(): Model?
	return character
end

function HopController.rootPart(): BasePart?
	return root
end

function HopController.isGrounded(): boolean
	return grounded
end

function HopController.isStomping(): boolean
	return stomping
end

function HopController.verticalSpeed(): number
	return if root then root.AssemblyLinearVelocity.Y else 0
end

function HopController.feetPosition(): Vector3
	return root.Position - Vector3.new(0, feetOffset(), 0)
end

function HopController.altitude(): number
	if not root then
		return 0
	end
	return math.max(0, HopController.feetPosition().Y - Movement.AltitudeZeroY)
end

function HopController.jumpsLeft(): number
	local used = jumpsUsed
	if not grounded and used == 0 and os.clock() - lastGroundedAt > Movement.CoyoteTime then
		used = 1
	end
	return MovementLogic.maxJumps(Movement) - used
end

local function launch(velocity: number)
	lastLaunchAt = os.clock()
	groundLockUntil = lastLaunchAt + Movement.GroundLockTime
	grounded = false
	arcLaunched = true
	stomping = false
	humanoid.WalkSpeed = Movement.AirSpeed
	-- Humanoid가 점프 상태에서 JumpPower를 초속으로 쓰므로 둘을 맞춘다
	humanoid.JumpPower = velocity
	launchVelocity = velocity
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(v.X, velocity, v.Z)
end

local function land(now: number)
	local wasStomping = stomping
	grounded = true
	jumpsUsed = 0
	arcLaunched = false
	stomping = false
	combo = 0
	landedAt = now
	humanoid.WalkSpeed = Movement.WalkSpeed
	humanoid.JumpPower = Movement.JumpVelocity[1]
	HopController.onLand:Fire(wasStomping, HopController.feetPosition())

	if now - bufferedJumpAt <= Movement.JumpBuffer then
		bufferedJumpAt = -math.huge
		jumpsUsed = 1
		launch(Movement.JumpVelocity[1])
		HopController.onJump:Fire(1, false, HopController.feetPosition(), perfectStreak)
	end
end

local function endPerfectStreak()
	if perfectStreak > 0 then
		local ended = perfectStreak
		perfectStreak = 0
		HopController.onPerfectStreakEnd:Fire(ended)
	end
end

local function resetAirState()
	endPerfectStreak()
	jumpsUsed = 0
	grounded = false
	arcLaunched = false
	stomping = false
	combo = 0
	lastGroundedAt = -math.huge
	bufferedJumpAt = -math.huge
	humanoid.WalkSpeed = Movement.AirSpeed
	humanoid.JumpPower = Movement.JumpVelocity[1]
end

local function respawnAfterFall()
	local target
	if safePosition then
		target = CFrame.new(safePosition + Vector3.new(0, 3, 0))
	else
		local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		target = if spawn then spawn.CFrame + Vector3.new(0, 5, 0) else CFrame.new(0, 20, 0)
	end
	character:PivotTo(target)
	root.AssemblyLinearVelocity = Vector3.zero
	resetAirState()
	HopController.onRespawn:Fire()
end

local safeParams = RaycastParams.new()
safeParams.FilterType = Enum.RaycastFilterType.Exclude

-- 발밑 사방이 모두 땅이면(가장자리가 아니면) 돌아올 자리로 기억한다
local function rememberSafeGround(now: number)
	if now - lastSafeCheckAt < 0.5 then
		return
	end
	lastSafeCheckAt = now
	safeParams.FilterDescendantsInstances = { character, HopController.localFolder }
	local feet = HopController.feetPosition()
	for _, offset in { Vector3.new(4, 0, 0), Vector3.new(-4, 0, 0), Vector3.new(0, 0, 4), Vector3.new(0, 0, -4) } do
		if not workspace:Raycast(feet + offset + Vector3.new(0, 2, 0), Vector3.new(0, -8, 0), safeParams) then
			return
		end
	end
	safePosition = root.Position
end

local function onJumpPressed()
	if not root or humanoid.Health <= 0 or grounded then
		return -- 지면 점프는 Humanoid 기본 입력이 처리한다
	end
	local now = os.clock()
	if now < staggerUntil then
		return -- 휘청이는 동안은 점프할 수 없다
	end
	local rising = root.AssemblyLinearVelocity.Y > Movement.LandingMaxVy
	if humanoid.FloorMaterial ~= Enum.Material.Air and not rising and now >= groundLockUntil then
		return -- 이번 프레임에 막 착지했다
	end

	local jump = MovementLogic.resolveAirJump(Movement, {
		jumpsUsed = jumpsUsed,
		sinceGrounded = now - lastGroundedAt,
		vy = root.AssemblyLinearVelocity.Y,
		arcLaunched = arcLaunched,
	})
	if not jump then
		bufferedJumpAt = now
		return
	end

	jumpsUsed = jump.index
	launch(jump.velocity)
	if jump.index > 1 then
		table.insert(HopController.stats.airJumps, {
			t = now - HopController.stats.startedAt,
			perfect = jump.perfect,
		})
		if jump.perfect then
			perfectStreak += 1
			HopController.stats.bestPerfectStreak = math.max(HopController.stats.bestPerfectStreak, perfectStreak)
		else
			endPerfectStreak()
		end
	end
	HopController.onJump:Fire(jump.index, jump.perfect, HopController.feetPosition(), perfectStreak)
end

-- 휘청: seconds 동안 느리게 걷고 점프할 수 없다. 공중이었다면 공중 점프를 jumpsLost만큼 잃는다.
-- reason: nil = 러시에서 라이벌에게 밟힘(서버 확인 뒤 RushHud가 부른다), "zap" = 보스 번개
function HopController.stagger(seconds: number, jumpsLost: number, reason: string?)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	staggerUntil = os.clock() + seconds
	if not grounded then
		jumpsUsed = math.min(math.max(jumpsUsed, 1) + jumpsLost, MovementLogic.maxJumps(Movement))
	end
	HopController.onStaggered:Fire(seconds, reason)
end

function HopController.stomp()
	if not root or grounded or stomping or humanoid.Health <= 0 then
		return
	end
	stomping = true
	humanoid.WalkSpeed = 0 -- 급강하 중에는 수평 이동을 막는다
	root.AssemblyLinearVelocity = Vector3.new(0, -Movement.StompDive, 0)
end

local function bounce(kind: string, velocity: number, part: BasePart?)
	if kind == "pad" then
		jumpsUsed = 1
	else
		jumpsUsed = MovementLogic.jumpsAfterBounce(Movement, jumpsUsed)
		combo += 1
	end
	launch(velocity)
	HopController.onBounce:Fire(kind, combo, HopController.feetPosition(), part)
end

local function popPuffling(part: BasePart)
	part.Transparency = 1
	part.CanQuery = false
	task.delay(Movement.PufflingRespawn, function()
		part.Transparency = 0
		part.CanQuery = true
	end)
end

local function isOtherCharacter(part: BasePart): boolean
	local model = part:FindFirstAncestorOfClass("Model")
	return model ~= nil and model ~= character and Players:GetPlayerFromCharacter(model) ~= nil
end

local function probeBelow(extra: number): RaycastResult?
	probeParams.FilterDescendantsInstances = { character, HopController.localFolder }
	local distance = math.max(0.1, feetOffset() - Movement.ProbeRadius + extra)
	return workspace:Spherecast(root.Position, Movement.ProbeRadius, Vector3.new(0, -distance, 0), probeParams)
end

-- 하강 중 발밑에 밟을 것이 있으면 튀어 오른다
local function tryBounce(hit: RaycastResult): boolean
	local part = hit.Instance
	if CollectionService:HasTag(part, Tags.Stompable) then
		popPuffling(part)
		HopController.stats.stomps += 1
		bounce("stomp", Movement.StompBounce, part)
	elseif CollectionService:HasTag(part, Tags.BouncePad) then
		bounce("pad", Movement.BouncePadVelocity, part)
	elseif isOtherCharacter(part) then
		bounce("buddy", Movement.StompBounce * Movement.BuddyBounceMult, part)
	else
		return false
	end
	return true
end

local function isInside(part: BasePart, position: Vector3): boolean
	local localPosition = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(localPosition.X) <= half.X
		and math.abs(localPosition.Y) <= half.Y
		and math.abs(localPosition.Z) <= half.Z
end

local function applyUpdraft()
	for _, updraft in updraftParts do
		if isInside(updraft, root.Position) then
			local v = root.AssemblyLinearVelocity
			if grounded then
				launch(Movement.UpdraftVelocity)
			elseif v.Y < Movement.UpdraftVelocity then
				stomping = false
				humanoid.WalkSpeed = Movement.AirSpeed
				arcLaunched = true
				root.AssemblyLinearVelocity = Vector3.new(v.X, Movement.UpdraftVelocity, v.Z)
			end
			jumpsUsed = math.max(jumpsUsed, 1)
			return
		end
	end
end

-- 파트 윗면의 월드 높이. 구름 원판은 원기둥을 눕혀 놓아서 Size.Y가 지름이다 (Size.Y/2를 쓰면 구름에 설 수 없었다)
local function topOf(part: BasePart): number
	local cf, size = part.CFrame, part.Size
	local halfHeight = (
		math.abs(cf.XVector.Y) * size.X
		+ math.abs(cf.YVector.Y) * size.Y
		+ math.abs(cf.ZVector.Y) * size.Z
	) / 2
	return cf.Position.Y + halfHeight
end

-- 일방향 구름: 발이 윗면보다 아래면 통과. 로컬 충돌만 바꾸므로 다른 플레이어에게 영향이 없다
local function updateClouds(feetY: number)
	for _, cloud in cloudParts do
		local top = topOf(cloud)
		cloud.CanCollide = feetY >= top - Movement.CloudSnap
	end
end

-- 종 반경에 들어오는 순간에만 울린다 (옆에 서 있는 동안 반복해서 울리지 않게)
local function checkBells(now: number)
	local near = false
	for _, bell in bellParts do
		if (bell.Position - root.Position).Magnitude <= Movement.BellRadius then
			near = true
			break
		end
	end
	if near and not nearBell and now - lastBellAt >= Movement.BellCooldown then
		lastBellAt = now
		HopController.stats.bells += 1
		HopController.onBell:Fire(HopController.feetPosition())
	end
	nearBell = near
end

local function step(dt: number)
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local now = os.clock()

	if root.Position.Y < Movement.FallResetY then
		respawnAfterFall()
		return
	end

	updateClouds(HopController.feetPosition().Y)
	applyUpdraft()

	local v = root.AssemblyLinearVelocity
	local vy = MovementLogic.clampFall(Movement, v.Y, stomping)
	if vy ~= v.Y then
		root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
	end

	-- Humanoid 점프는 JumpPower보다 약 5% 큰 초속을 낸다 (2026-11-03 플레이테스트 실측). Config 값으로 되돌린다
	if launchVelocity then
		local elapsed = now - lastLaunchAt
		local target = launchVelocity - workspace.Gravity * elapsed
		if vy > target + Movement.LaunchOvershootTolerance then
			vy = target
			root.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
			launchVelocity = nil
		elseif elapsed > Movement.GroundLockTime then
			launchVelocity = nil
		end
	end

	if not grounded and vy < 0 then
		local hit = probeBelow(math.max(Movement.ProbeLookahead, -vy * dt * 1.5))
		if hit and tryBounce(hit) then
			return
		end
	elseif grounded then
		local hit = probeBelow(0.5)
		if hit and CollectionService:HasTag(hit.Instance, Tags.BouncePad) then
			bounce("pad", Movement.BouncePadVelocity)
			return
		end
	end

	-- 일방향 구름을 뚫고 올라가는 순간에도 바닥이 감지되므로, 올라가는 중에는 착지로 보지 않는다
	local onFloor = humanoid.FloorMaterial ~= Enum.Material.Air and now >= groundLockUntil
	if onFloor and not grounded and vy <= Movement.LandingMaxVy then
		land(now)
	elseif not onFloor and grounded and now >= groundLockUntil then
		grounded = false
		lastGroundedAt = now
		humanoid.WalkSpeed = Movement.AirSpeed
	end
	if grounded and onFloor then
		rememberSafeGround(now)
	end
	if grounded and now - landedAt > Movement.PerfectStreakGroundGrace then
		endPerfectStreak()
	end

	if humanoid.JumpPower ~= Movement.JumpVelocity[1] and now - lastLaunchAt > Movement.GroundLockTime then
		humanoid.JumpPower = Movement.JumpVelocity[1]
	end
	-- 휘청: 지면 점프도 막고 느리게 걷는다 (위에서 되돌린 값을 덮어쓴다)
	if now < staggerUntil then
		staggering = true
		humanoid.WalkSpeed = Movement.StaggerSpeed
		humanoid.JumpPower = 0
	elseif staggering then
		staggering = false
		humanoid.WalkSpeed = if grounded then Movement.WalkSpeed else Movement.AirSpeed
		humanoid.JumpPower = Movement.JumpVelocity[1]
	end

	checkBells(now)
	HopController.stats.maxAltitude = math.max(HopController.stats.maxAltitude, HopController.altitude())
end

local function onStateChanged(_, newState: Enum.HumanoidStateType)
	if newState ~= Enum.HumanoidStateType.Jumping then
		return
	end
	local now = os.clock()
	if now - lastLaunchAt <= Movement.GroundLockTime or now < staggerUntil then
		return -- launch()가 일으킨 점프, 또는 휘청이는 동안(JumpPower 0)의 헛점프
	end
	-- Humanoid 기본 입력으로 뛴 지면 점프. 점프 키를 누른 채 착지하면 land()보다 먼저 올 수 있다
	lastLaunchAt = now
	launchVelocity = Movement.JumpVelocity[1]
	groundLockUntil = now + Movement.GroundLockTime
	grounded = false
	arcLaunched = true
	stomping = false
	combo = 0
	jumpsUsed = 1
	humanoid.WalkSpeed = Movement.AirSpeed
	HopController.onJump:Fire(1, false, HopController.feetPosition(), perfectStreak)
end

local function onCharacterAdded(newCharacter: Model)
	-- 첫 캐릭터가 아니면 죽었다 되살아난 것이다. 낙하 복귀와 같이 알린다 (진행 중 의뢰 실패)
	local revived = character ~= nil
	humanoid, root = nil, nil
	character = newCharacter
	humanoid = newCharacter:WaitForChild("Humanoid")
	root = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid.UseJumpPower = true
	resetAirState()
	humanoid.WalkSpeed = Movement.WalkSpeed
	humanoid.StateChanged:Connect(onStateChanged)
	if revived then
		safePosition = nil
		HopController.onRespawn:Fire()
	end
end

function HopController.start()
	local folder = Instance.new("Folder")
	folder.Name = "SkyhopLocal"
	folder.Parent = workspace
	HopController.localFolder = folder

	cloudParts = trackTag(Tags.Cloud)
	updraftParts = trackTag(Tags.Updraft)
	bellParts = trackTag(Tags.Bell)

	player.CharacterAdded:Connect(onCharacterAdded)
	if player.Character then
		task.spawn(onCharacterAdded, player.Character)
	end

	-- JumpRequest는 한 번 눌러도 여러 번 오고, 누르고 있으면 계속 온다. 간격으로 새 입력만 골라낸다
	UserInputService.JumpRequest:Connect(function()
		local now = os.clock()
		local isNewPress = now - lastJumpRequestAt > Movement.JumpPressGap
		lastJumpRequestAt = now
		if isNewPress then
			onJumpPressed()
		end
	end)

	ContextActionService:BindAction("SkyhopStomp", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			HopController.stomp()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonX)

	RunService.Heartbeat:Connect(step)
end

return HopController
]]></ProtectedString>
						<string name="ScriptGuid">{AFB0D5B3-54BD-4851-83D3-A6755CFEEDE0}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">HopController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003f0</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="20">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 착지 예상 지점 링과 발밑 그림자 (GDD 5.4). 클라이언트 전용이라 복제되지 않는다.
-- 그림자는 공중에 있는 동안 늘 그리고, 링만 켜고 끈다 (L)
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraConfig = require(ReplicatedStorage.Config.Camera)
local MovementLogic = require(ReplicatedStorage.Shared.MovementLogic)
local Signal = require(ReplicatedStorage.Shared.Signal)
local Tags = require(ReplicatedStorage.Shared.Tags)

local FLAT = CFrame.Angles(0, 0, math.rad(90)) -- 원기둥 축을 세워 원판으로 눕힌다
local MARKER_DIAMETER = 8
local MARKER_TRANSPARENCY = 0.15
local SHADOW_TRANSPARENCY = 0.35

-- 발판이 흰색·하늘색 계열이라 기본 마커는 진한 파랑으로 대비를 준다
local COLOR = {
	Default = Color3.fromRGB(0, 140, 255),
	Stompable = Color3.fromRGB(255, 120, 200),
	BouncePad = Color3.fromRGB(255, 212, 60),
	Buddy = Color3.fromRGB(120, 255, 160),
	Shadow = Color3.fromRGB(20, 30, 50),
}

local LandingMarker = {
	enabled = CameraConfig.MarkerEnabled,
	onToggled = Signal.new(),
}

local function disc(parent: Instance, diameter: number, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.2, diameter, diameter)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = material
	part.Color = color
	part.Transparency = 1
	part.Parent = parent
	return part
end

local function colorFor(part: BasePart): Color3
	if CollectionService:HasTag(part, Tags.Stompable) then
		return COLOR.Stompable
	elseif CollectionService:HasTag(part, Tags.BouncePad) then
		return COLOR.BouncePad
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if model and Players:GetPlayerFromCharacter(model) then
		return COLOR.Buddy
	end
	return COLOR.Default
end

local function predictLanding(feet: Vector3, velocity: Vector3, params: RaycastParams): RaycastResult?
	local gravity = workspace.Gravity
	local previous = feet
	local t = 0
	while t < CameraConfig.MarkerPredictSeconds do
		t += CameraConfig.MarkerStep
		local x, y, z = MovementLogic.trajectoryPoint(feet, velocity, gravity, t)
		local point = Vector3.new(x, y, z)
		-- 올라가는 구간은 건너뛴다: 일방향 구름은 아래에서 통과하기 때문
		if point.Y < previous.Y then
			local hit = workspace:Raycast(previous, point - previous, params)
			if hit then
				return hit
			end
		end
		previous = point
	end
	return nil
end

function LandingMarker.start(hop)
	local marker = disc(hop.localFolder, MARKER_DIAMETER, COLOR.Default, Enum.Material.Neon)
	local shadow = disc(hop.localFolder, 4, COLOR.Shadow, Enum.Material.SmoothPlastic)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	RunService.RenderStepped:Connect(function()
		local root = hop.rootPart()
		if not (root and not hop.isGrounded()) then
			marker.Transparency = 1
			shadow.Transparency = 1
			return
		end

		params.FilterDescendantsInstances = { hop.character(), hop.localFolder }
		local feet = hop.feetPosition()

		local landing = LandingMarker.enabled and predictLanding(feet, root.AssemblyLinearVelocity, params)
		if landing then
			marker.Transparency = MARKER_TRANSPARENCY
			marker.Color = colorFor(landing.Instance)
			marker.CFrame = CFrame.new(landing.Position + Vector3.new(0, 0.12, 0)) * FLAT
		else
			marker.Transparency = 1
		end

		local below = workspace:Raycast(feet, Vector3.new(0, -2000, 0), params)
		if below then
			shadow.Transparency = SHADOW_TRANSPARENCY
			shadow.CFrame = CFrame.new(below.Position + Vector3.new(0, 0.08, 0)) * FLAT
		else
			shadow.Transparency = 1
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.L then
			LandingMarker.enabled = not LandingMarker.enabled
			LandingMarker.onToggled:Fire(LandingMarker.enabled)
		end
	end)
end

return LandingMarker
]]></ProtectedString>
						<string name="ScriptGuid">{377F48B9-3F3D-4FF3-B183-759DA57B7F9B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">LandingMarker</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003f1</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="21">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 스카이 캠(3인칭)과 1인칭. 하강하면 시선이 자동으로 아래를 향한다 (다이브 캠, GDD 5.4).
-- 기본 카메라 모듈은 Scriptable 타입에서 멈추므로 시점·마우스 동작은 전부 여기서 맡는다.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraConfig = require(ReplicatedStorage.Config.Camera)
local Movement = require(ReplicatedStorage.Config.Movement)
local Signal = require(ReplicatedStorage.Shared.Signal)

local player = Players.LocalPlayer

local SkyCamera = {
	mode = CameraConfig.DefaultMode, -- "Sky" | "First"
	onModeChanged = Signal.new(),
	shakeEnabled = true, -- 멀미에 약한 사람을 위해 설정에서 끌 수 있게 둔다
}

local fallEffect = 0 -- 0~1, 빠르게 떨어질수록 커진다

-- 빠른 낙하: 시야가 넓어지고 화면이 미세하게 떨린다 (고소공포 연출)
local function fallKick(hop, dt: number): (number, Vector3)
	local target = math.clamp((-hop.verticalSpeed() - 30) / (Movement.TerminalFall - 30), 0, 1)
	fallEffect += (target - fallEffect) * (1 - math.exp(-6 * dt))
	local fovBonus = CameraConfig.FallFovBonus * fallEffect
	local shake = Vector3.zero
	if SkyCamera.shakeEnabled and fallEffect > CameraConfig.FallShakeFrom then
		local amount = CameraConfig.FallShake
			* (fallEffect - CameraConfig.FallShakeFrom)
			/ (1 - CameraConfig.FallShakeFrom)
		local t = os.clock() * 14
		shake = Vector3.new(math.noise(t, 0.3), math.noise(0.7, t), math.noise(t, 1.9)) * amount
	end
	return fovBonus, shake
end

local PITCH_MIN = math.rad(CameraConfig.PitchMin)
local PITCH_MAX = math.rad(CameraConfig.PitchMax)

local yaw = 0
local pitch = math.rad(CameraConfig.DefaultPitch)
local autoPitch = 0
local zoom = CameraConfig.Distance
local rotating = false
local cameraTouches = {}
local stick = Vector2.zero

-- 일방향 구름처럼 지금 통과 중인 것에 카메라가 걸리지 않게 충돌 여부를 따른다
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
occlusionParams.RespectCanCollide = true

local dropParams = RaycastParams.new()
dropParams.FilterType = Enum.RaycastFilterType.Exclude

local function turn(yawDelta: number, pitchDelta: number)
	yaw -= yawDelta
	pitch = math.clamp(pitch - pitchDelta, PITCH_MIN, PITCH_MAX)
end

local function setCharacterHidden(character: Model, hidden: boolean)
	local modifier = if hidden then 1 else 0
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") or item:IsA("Decal") then
			item.LocalTransparencyModifier = modifier
		end
	end
end

-- 카메라가 캐릭터 뒤에서 target 쪽을 보게 돌린다 (러시 출발처럼 순간이동한 뒤)
function SkyCamera.faceToward(target: Vector3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local d = target - root.Position
	if Vector3.new(d.X, 0, d.Z).Magnitude > 1e-3 then
		yaw = math.atan2(-d.X, -d.Z)
	end
end

function SkyCamera.toggle()
	SkyCamera.mode = if SkyCamera.mode == "Sky" then "First" else "Sky"
	local character = player.Character
	if character and SkyCamera.mode == "Sky" then
		setCharacterHidden(character, false)
	end
	SkyCamera.onModeChanged:Fire(SkyCamera.mode)
end

-- 떨어지는 중이고 발밑이 충분히 깊을 때만 내려다본다 (작은 턱에서는 흔들지 않는다)
local function isDiving(hop, exclude: { Instance }): boolean
	if hop.isGrounded() or hop.verticalSpeed() > -CameraConfig.DiveMinFallSpeed then
		return false
	end
	dropParams.FilterDescendantsInstances = exclude
	return workspace:Raycast(hop.feetPosition(), Vector3.new(0, -CameraConfig.DiveMinDrop, 0), dropParams) == nil
end

local function update(hop, dt: number)
	local camera = workspace.CurrentCamera
	local character = hop.character()
	local root = hop.rootPart()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (camera and root and humanoid) then
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	if stick.Magnitude > CameraConfig.StickDeadzone then
		local speed = math.rad(CameraConfig.GamepadSpeed) * dt
		turn(stick.X * speed, -stick.Y * speed)
	end

	local exclude = { character, hop.localFolder }
	local target = if isDiving(hop, exclude) then math.rad(CameraConfig.DiveAngle) else 0
	local rate = if target > autoPitch then CameraConfig.DiveInRate else CameraConfig.DiveOutRate
	autoPitch += (target - autoPitch) * (1 - math.exp(-rate * dt))

	local rotation = CFrame.fromEulerAnglesYXZ(math.clamp(pitch - autoPitch, PITCH_MIN, PITCH_MAX), yaw, 0)
	local altitude01 = math.clamp(hop.altitude() / CameraConfig.SkyCamAltitude, 0, 1)
	local fovBonus, shake = fallKick(hop, dt)
	camera.FieldOfView = CameraConfig.Fov + (CameraConfig.FovMax - CameraConfig.Fov) * altitude01 + fovBonus

	if SkyCamera.mode == "First" then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		humanoid.AutoRotate = false
		root.CFrame = CFrame.new(root.Position) * CFrame.fromEulerAnglesYXZ(0, yaw, 0)
		setCharacterHidden(character, true)
		local eye = root.Position + Vector3.new(0, CameraConfig.FirstPersonHeight, 0)
		camera.CFrame = CFrame.new(eye + shake) * rotation
		camera.Focus = CFrame.new(eye)
	else
		UserInputService.MouseBehavior = if rotating
			then Enum.MouseBehavior.LockCurrentPosition
			else Enum.MouseBehavior.Default
		humanoid.AutoRotate = true
		local focus = root.Position + Vector3.new(0, CameraConfig.FocusHeight, 0)
		local back = -rotation.LookVector * (zoom + CameraConfig.SkyDistanceBonus * altitude01)
		occlusionParams.FilterDescendantsInstances = exclude
		local hit = workspace:Raycast(focus, back, occlusionParams)
		if hit then
			back = back.Unit * math.max(0.5, (hit.Position - focus).Magnitude - 0.5)
		end
		camera.CFrame = CFrame.new(focus + back + shake) * rotation
		camera.Focus = CFrame.new(focus)
	end
end

function SkyCamera.start(hop)
	player.CharacterAdded:Connect(function(character)
		local root = character:WaitForChild("HumanoidRootPart")
		local _, characterYaw = root.CFrame:ToEulerAnglesYXZ()
		yaw = characterYaw
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rotating = true
		elseif input.UserInputType == Enum.UserInputType.Touch then
			-- 썸스틱·버튼 위에서 시작한 터치는 processed라 여기 오지 않는다
			cameraTouches[input] = true
		elseif input.KeyCode == Enum.KeyCode.V or input.KeyCode == Enum.KeyCode.ButtonY then
			SkyCamera.toggle()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rotating = false
		elseif input.UserInputType == Enum.UserInputType.Touch then
			cameraTouches[input] = nil
		end
	end)

	UserInputService.InputChanged:Connect(function(input, processed)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.MouseMovement then
			if rotating or SkyCamera.mode == "First" then
				local sensitivity = math.rad(CameraConfig.MouseSensitivity)
				turn(input.Delta.X * sensitivity, input.Delta.Y * sensitivity)
			end
		elseif inputType == Enum.UserInputType.Touch then
			if cameraTouches[input] then
				local sensitivity = math.rad(CameraConfig.TouchSensitivity)
				turn(input.Delta.X * sensitivity, input.Delta.Y * sensitivity)
			end
		elseif inputType == Enum.UserInputType.MouseWheel then
			if not processed then
				local zoomed = zoom - input.Position.Z * CameraConfig.ZoomStep
				zoom = math.clamp(zoomed, CameraConfig.ZoomMin, CameraConfig.ZoomMax)
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	RunService:BindToRenderStep("SkyCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		update(hop, dt)
	end)
end

return SkyCamera
]]></ProtectedString>
						<string name="ScriptGuid">{717D3733-782E-4963-A0E4-8B85D9C69539}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SkyCamera</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003f2</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX175D947EC97D43C190707E19C3E27521">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 아찔함 연출: 발밑이 깊을수록, 빨리 떨어질수록 바람이 거세지고 시야 가장자리가 어두워지며 바람 줄기가 스친다.
-- 구름을 통과하면 하얗게 가려지고, 섬 가장자리에서 아래를 보면 바람이 분다
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local CameraConfig = require(ReplicatedStorage.Config.Camera)
local Movement = require(ReplicatedStorage.Config.Movement)
local World = require(ReplicatedStorage.Config.World)
local Tags = require(ReplicatedStorage.Shared.Tags)

local player = Players.LocalPlayer

-- Roblox 클라이언트 내장 낙하 바람 소리 (2026-11-02 로컬 content/sounds에서 확인)
local WIND_SOUND = "rbxasset://sounds/action_falling.ogg"
local SMOOTHING = 6

local Vertigo = {
	fall = 0, -- 0~1 낙하 속도
	void = 0, -- 0~1 발밑 깊이
	edge = false, -- 섬 가장자리에서 허공을 보고 있는가
	drop = 0, -- 발밑까지 깊이(studs). 땅이 없으면 구름 바다까지
	intensity = 0,
}

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function edgeFrame(parent: Instance, anchor: Vector2, position: UDim2, size: UDim2, rotation: number): Frame
	local frame = Instance.new("Frame")
	frame.AnchorPoint = anchor
	frame.Position = position
	frame.Size = size
	frame.BackgroundColor3 = Color3.fromRGB(10, 18, 40)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	-- 바깥쪽만 진하고 안쪽으로 빠르게 사라져, 띠 네 개가 겹쳐도 사각 틀로 보이지 않게
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = rotation
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.35, 0.65),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Parent = frame
	frame.Parent = parent
	return frame
end

-- 화면 가장자리 어둠. CanvasGroup의 그룹 투명도는 이 환경에서 반영되지 않아(2026-11-04 확인) 프레임마다 투명도를 준다
local function buildVignette(): { Frame }
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopVertigo"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = -1
	gui.Parent = player:WaitForChild("PlayerGui")
	return {
		edgeFrame(gui, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.3, 1), 0),
		edgeFrame(gui, Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.3, 1), 180),
		edgeFrame(gui, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.3), 90),
		edgeFrame(gui, Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.3), 270),
	}
end

-- 카메라 아래에서 위로 솟구치는 바람 줄기. 떨어질수록 많아진다
local function buildSpeedLines(folder: Instance): (BasePart, ParticleEmitter)
	local anchor = Instance.new("Part")
	anchor.Name = "SpeedLines"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(40, 1, 40)
	anchor.Parent = folder
	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.5, 0.8)
	emitter.Speed = NumberRange.new(150, 220)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(3, 3)
	emitter.Size = NumberSequence.new(0.18)
	emitter.Squash = NumberSequence.new(-3)
	emitter.LightEmission = 0.5
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Color = ColorSequence.new(Color3.fromRGB(240, 248, 255))
	emitter.Parent = anchor
	return anchor, emitter
end

-- 카메라가 구름 덩어리 안에 있는가 (구름 파트를 타원체로 본다)
local function insideCloud(puffs: { BasePart }, position: Vector3): boolean
	for _, part in puffs do
		local p = part.CFrame:PointToObjectSpace(position)
		local h = part.Size / 2
		if (p.X / h.X) ^ 2 + (p.Y / h.Y) ^ 2 + (p.Z / h.Z) ^ 2 <= 1 then
			return true
		end
	end
	return false
end

function Vertigo.start(hop)
	local wind = Instance.new("Sound")
	wind.Name = "VertigoWind"
	wind.SoundId = WIND_SOUND
	wind.Looped = true
	wind.Volume = 0
	wind.Parent = SoundService
	wind:Play()

	local vignette = buildVignette()
	local lineAnchor, lines = buildSpeedLines(hop.localFolder)

	-- 구름 속 하얀 가림. 클라이언트에서만 보이게 카메라 아래에 둔다
	local fog = Instance.new("ColorCorrectionEffect")
	fog.Name = "CloudFog"
	fog.Parent = workspace.CurrentCamera or Lighting

	local puffs = CollectionService:GetTagged(Tags.CloudPuff)
	CollectionService:GetInstanceAddedSignal(Tags.CloudPuff):Connect(function(part)
		table.insert(puffs, part)
	end)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local fogAmount = 0

	RunService.RenderStepped:Connect(function(dt)
		local root = hop.rootPart()
		local camera = workspace.CurrentCamera
		if not (root and camera) then
			return
		end
		params.FilterDescendantsInstances = { hop.character(), hop.localFolder }
		local feet = hop.feetPosition()

		-- 지면 높이에서 쏘면 땅을 놓치므로 조금 위에서 쏜다
		local below = workspace:Raycast(feet + Vector3.new(0, 2, 0), Vector3.new(0, -3000, 0), params)
		Vertigo.drop = math.max(0, if below then feet.Y - below.Position.Y else feet.Y - World.CloudSeaY)

		Vertigo.edge = false
		if hop.isGrounded() then
			local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
			if look.Magnitude > 0.01 then
				local ahead = feet + look.Unit * CameraConfig.EdgeProbeDistance + Vector3.new(0, 2, 0)
				Vertigo.edge = workspace:Raycast(ahead, Vector3.new(0, -CameraConfig.VoidMinDepth, 0), params) == nil
			end
		end

		local fallSpeed = -hop.verticalSpeed()
		local fallTarget = clamp01((fallSpeed - 30) / (Movement.TerminalFall - 30))
		local voidTarget = clamp01(
			(Vertigo.drop - CameraConfig.VoidMinDepth) / (CameraConfig.VoidDepthFull - CameraConfig.VoidMinDepth)
		)
		local blend = 1 - math.exp(-SMOOTHING * dt)
		Vertigo.fall += (fallTarget - Vertigo.fall) * blend
		Vertigo.void += (voidTarget - Vertigo.void) * blend
		local edgeTerm = if Vertigo.edge then CameraConfig.EdgeIntensity else 0
		Vertigo.intensity = math.max(Vertigo.fall, Vertigo.void * 0.5, edgeTerm)

		wind.Volume = CameraConfig.WindVolumeMin
			+ (CameraConfig.WindVolumeMax - CameraConfig.WindVolumeMin) * Vertigo.intensity
		wind.PlaybackSpeed = 0.8 + Vertigo.fall * 0.5
		for _, frame in vignette do
			frame.BackgroundTransparency = 1 - Vertigo.intensity * CameraConfig.VignetteMax
		end

		lineAnchor.CFrame = CFrame.new(camera.CFrame.Position - Vector3.new(0, 45, 0))
		lines.Rate = if Vertigo.fall > 0.2 then CameraConfig.SpeedLineRate * Vertigo.fall else 0

		local inCloud = insideCloud(puffs, camera.CFrame.Position)
		fogAmount += ((if inCloud then 1 else 0) - fogAmount) * (1 - math.exp(-8 * dt))
		fog.Brightness = fogAmount * 0.45
		fog.Saturation = -fogAmount * 0.6
	end)
end

return Vertigo
]]></ProtectedString>
						<string name="ScriptGuid">{BAAE2ADE-E861-46EC-B017-D7C5CA819CC4}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Vertigo</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0000e4a6</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF9175B7301DE4BFBA82A21BC60785651">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 풍경을 살아 있게: 풍차 날개 회전, 열기구 흔들림, 갈매기 떼 선회(날갯짓·활공), 구름 흐름. 모두 클라이언트 로컬 움직임
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Tags = require(ReplicatedStorage.Shared.Tags)

local Ambience = {}

local BALLOON_BOB = 5
local BALLOON_SPEED = 0.35
local CLOUD_WANDER = 40
local CLOUD_SPEED = 0.025
-- 갈매기: 날갯짓하다가 활공하기를 되풀이한다 (CYCLE초마다 FLAP_SHARE만큼 날갯짓)
local GULL_CYCLE = 3.6
local GULL_FLAP_SHARE = 0.5
local GULL_FLAP_SPEED = 8
local GULL_FLAP_ANGLE = 0.55 -- 어깨 뼈 회전 (라디안). 날개 끝 뼈는 그 0.6배를 더 굽힌다
local GULL_BANK = 0.28 -- 선회 쪽으로 기우는 각도 (라디안)
-- 왼쪽 날개(-X)는 몸통 앞 방향 축으로 +회전하면 올라가고, 오른쪽은 -회전하면 올라간다 (2026-11-04 Studio 확인)
local WING_SIDE = { WingL1 = 1, WingL2 = 1, WingR1 = -1, WingR2 = -1 }
local WING_TIP = { WingL2 = true, WingR2 = true }

type GullRig = { bones: { { bone: Bone, axis: Vector3, side: number, tip: boolean } } }
local gullRigs: { [Model]: GullRig } = {}

-- 뼈마다 몸통 앞 방향 축을 뼈 기준으로 한 번만 구해 둔다 (모든 Transform이 비어 있을 때)
local function rigFor(bird: Model): GullRig
	local rig = gullRigs[bird]
	if rig then
		return rig
	end
	rig = { bones = {} }
	local forward = bird:GetPivot().LookVector
	for _, bone in bird:GetDescendants() do
		if bone:IsA("Bone") and WING_SIDE[bone.Name] then
			table.insert(rig.bones, {
				bone = bone,
				axis = bone.WorldCFrame:VectorToObjectSpace(forward),
				side = WING_SIDE[bone.Name],
				tip = WING_TIP[bone.Name] == true,
			})
		end
	end
	gullRigs[bird] = rig
	bird.Destroying:Connect(function()
		gullRigs[bird] = nil
	end)
	return rig
end

-- 갈매기 한 마리: 떼 안 자리 + 새마다 다른 흔들림·기울기로 기준점을 옮기고, 날개 뼈를 굽힌다
local function poseGull(bird: Model, flock: CFrame, t: number, bank: number)
	local offset = bird:GetAttribute("Offset") :: Vector3?
	local phase = (bird:GetAttribute("Phase") :: number?) or 0
	local s = (bird:GetAttribute("Scale") :: number?) or 1
	if not offset then
		return
	end
	local rig = rigFor(bird)
	local cycle = (t / GULL_CYCLE + phase) % 1
	local flap = if cycle < GULL_FLAP_SHARE
		then math.sin(t * GULL_FLAP_SPEED + phase * 5) * GULL_FLAP_ANGLE
		else 0.08 + math.sin(t * 1.3 + phase) * 0.04 -- 활공: 날개를 살짝 들고 바람에 떤다
	local drift = Vector3.new(math.sin(t * 0.7 + phase) * 0.8, math.sin(t * 1.1 + phase * 2) * 1.2, 0) * s
	bird:PivotTo(
		flock
			* CFrame.new(offset + drift)
			* CFrame.Angles(math.sin(t * 0.9 + phase) * 0.06, 0, bank + math.sin(t * 0.6 + phase) * 0.08)
	)
	for _, entry in rig.bones do
		local angle = flap * entry.side * (if entry.tip then 0.6 else 1)
		entry.bone.Transform = CFrame.fromAxisAngle(entry.axis, angle)
	end
end

function Ambience.start()
	local spinners, balloons, flocks, clouds = {}, {}, {}, {}

	local function trackSpin(model: Instance)
		local center = model:GetAttribute("SpinCenter")
		local axis = model:GetAttribute("SpinAxis")
		if not (model:IsA("Model") and center and axis) then
			return
		end
		local hub = CFrame.new(center)
		table.insert(spinners, {
			model = model,
			hub = hub,
			offset = hub:ToObjectSpace(model:GetPivot()),
			axis = axis,
			speed = model:GetAttribute("SpinSpeed") or 0.3,
		})
	end

	local function trackDrift(model: Instance)
		if model:IsA("Model") then
			table.insert(
				balloons,
				{ model = model, base = model:GetPivot(), phase = model:GetAttribute("DriftPhase") or 0 }
			)
		end
	end

	local function trackOrbit(model: Instance)
		if model:IsA("Model") then
			table.insert(flocks, {
				model = model,
				center = model:GetAttribute("OrbitCenter"),
				radius = model:GetAttribute("OrbitRadius") or 60,
				speed = model:GetAttribute("OrbitSpeed") or 0.1,
				phase = model:GetAttribute("OrbitPhase") or 0,
			})
		end
	end

	local function each(tag: string, handler: (Instance) -> ())
		for _, inst in CollectionService:GetTagged(tag) do
			handler(inst)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(handler)
	end
	each(Tags.Spin, trackSpin)
	each(Tags.Drift, trackDrift)
	each(Tags.Orbit, trackOrbit)

	-- 구름 덩어리는 모델 단위로 흘려보낸다 (태그는 파트에 붙어 있다)
	local seenClouds = {}
	each(Tags.CloudPuff, function(part)
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not seenClouds[model] then
			seenClouds[model] = true
			table.insert(
				clouds,
				{ model = model, base = model:GetPivot(), phase = model:GetAttribute("DriftPhase") or 0 }
			)
		end
	end)

	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, s in spinners do
			s.model:PivotTo(s.hub * CFrame.fromAxisAngle(s.axis, t * s.speed) * s.offset)
		end
		for _, b in balloons do
			local bob = math.sin(t * BALLOON_SPEED + b.phase) * BALLOON_BOB
			b.model:PivotTo(b.base * CFrame.new(0, bob, 0) * CFrame.Angles(0, math.sin(t * 0.05 + b.phase) * 0.3, 0))
		end
		for _, f in flocks do
			local angle = f.phase + t * f.speed
			local position = f.center
				+ Vector3.new(math.cos(angle) * f.radius, math.sin(t * 0.5 + f.phase) * 3, math.sin(angle) * f.radius)
			local tangent = Vector3.new(-math.sin(angle), 0, math.cos(angle)) * math.sign(f.speed)
			local frame = CFrame.lookAt(position, position + tangent)
			if f.model:GetAttribute("Flock") then
				-- 갈매기 떼: 새마다 따로 자세를 잡는다. 원을 돌므로 늘 안쪽으로 기운다
				local bank = -GULL_BANK * math.sign(f.speed)
				for _, bird in f.model:GetChildren() do
					if bird:IsA("Model") then
						poseGull(bird, frame, t, bank)
					end
				end
			else
				f.model:PivotTo(frame)
			end
		end
		for _, c in clouds do
			local offset = Vector3.new(
				math.sin(t * CLOUD_SPEED + c.phase) * CLOUD_WANDER,
				0,
				math.cos(t * CLOUD_SPEED * 0.8 + c.phase) * CLOUD_WANDER
			)
			c.model:PivotTo(c.base + offset)
		end
	end)
end

return Ambience
]]></ProtectedString>
