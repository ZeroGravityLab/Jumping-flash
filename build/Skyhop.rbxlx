return {
	Music = {
		Skyhaven = { id = 1842285620, volume = 0.3 }, -- "Pleasure Trip": 가볍고 밝은 곡
		WindmillMeadow = { id = 1839885864, volume = 0.3 }, -- "Silly Things": 익살스러운 민속풍
