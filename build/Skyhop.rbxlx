			{ "slab", 0, 70, 30, 12 },
			{ "updraft", -30, 70, 0, 60 },
		},
		path = { 1, 2, 3 },
	},
	{
		id = "PuffTower",
		difficulty = 4,
		platforms = { { "puff", 15, 30, 15 }, { "puff", -15, 95, 15 }, { "slab", 0, 140, -20, 10 } },
		path = { 1, 2, 3 },
	},
	{
		id = "Needles",
		difficulty = 5,
		platforms = { { "slab", 40, 40, 20, 6 }, { "slab", 0, 85, 45, 6 }, { "slab", -40, 125, 15, 6 } },
		path = { 1, 2, 3 },
	},
	{
		id = "Meadow",
		difficulty = 1,
		rest = true,
		platforms = { { "slab", 0, 50, 25, 30 }, { "cloud", -20, 100, 0, 24 } },
		path = { 1, 2 },
	},
}
]]></ProtectedString>
