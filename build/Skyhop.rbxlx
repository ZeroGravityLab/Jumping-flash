					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 의뢰와 주민 (GDD 6.4~6.6). 좌표는 섬 중심 기준.
-- surface 좌표 {x, z, 높이}: 그 자리 맨 위 표면(지붕·땅) 위로 높이만큼 띄운다. 이 지점 주변엔 나무를 심지 않는다
-- air 좌표 {x, y, z}: 섬 윗면 높이 기준의 고정 위치
-- satellite 좌표 {n, 높이}: 그 섬의 n번째 나선 섬 윗면 위
-- 좌표에 island를 적으면 주민의 섬 대신 그 섬 기준이다 (섬을 건너는 배달)
-- item: 수집·배달 물건의 모양 (없으면 편지·화분)
-- 경주(Race): 연이 플레이어 머리 위에서 출발해 points를 지나 target에 kiteTime초 뒤에 닿는다. 그보다 먼저 target에 닿아야 한다
-- 시간은 초. minTime보다 빨리 끝난 보고는 서버가 거절한다
return {
	MedalCoins = { bronze = 15, silver = 25, gold = 40 },

	-- boss: 그 장의 보스 의뢰. 이기면 섬이 되살아난다 (RequestLogic.isRestored)
	Chapters = {
		[1] = { island = "WindmillMeadow", bossAt = 6, boss = "c1_boss" },
	},

	-- 주민 이야기 (GDD 6.6): final 의뢰를 처음 끝내면 엔딩 카드가 뜨고 허브가 바뀐다 (그 플레이어에게만).
	-- 바뀐 모습은 클라이언트 Requests/Stories의 같은 id 빌더가 만들고, 카드를 닫으면 showAt 주민에게,
	-- 또는 showSpot 자리(이름은 Strings StoryPlace_<id>)로 길 안내한다.
	-- spots는 island 중심 기준 {x, z, 반경?}이고, 월드 생성 때 그 반경(없으면 8) 안에 나무를 심지 않는다
	Stories = {
		{
			id = "Bakery",
			resident = "Bram",
			final = "c1_flour",
			showAt = "Momo",
			island = "Skyhaven",
			spots = { stall = { -30, 24 }, bun = { -22, 44 } },
			house = { -66, 46 }, -- 모모 뒤 집: 굴뚝 연기와 지붕 위 통통 빵
		},
		-- 레아: 허브 가장자리 등대에 불이 켜지고 구름배가 섬 둘레를 돈다. 꼭대기 전망대에 설 수 있다
		{
			id = "Lighthouse",
			resident = "Rhea",
			final = "c1_dive",
			showSpot = "tower",
			island = "Skyhaven",
			spots = { tower = { -108, -84, 18 } },
		},
		-- 렌: 허브 하늘에 연 계단(일방향 발판). 꼭대기 큰 연은 바운스 패드
		{
			id = "Kites",
			resident = "Wren",
			final = "c1_summit_race",
			showSpot = "hill",
			island = "Skyhaven",
			spots = { hill = { 44, -100, 34 } },
		},
		-- 1장 보스를 이기면 풍차 초원이 되살아난다 (먹구름이 걷히고 무지개)
		{ id = "Chapter1", final = "c1_boss", island = "WindmillMeadow", spots = {} },
	},

	Residents = {
		{ id = "Pip", island = "Skyhaven", x = 28, z = 34, yaw = 210, color = { 120, 170, 230 } },
		{ id = "Momo", island = "Skyhaven", x = -44, z = 18, yaw = 120, color = { 240, 170, 150 } },
		{ id = "Rhea", island = "WindmillMeadow", x = -36, z = 22, yaw = 160, color = { 170, 140, 220 } },
		{ id = "Bram", island = "WindmillMeadow", x = -4, z = 34, yaw = 150, color = { 214, 180, 110 } },
		{ id = "Wren", island = "WindmillMeadow", x = 66, z = 8, yaw = 90, color = { 110, 200, 170 } },
	},

	Requests = {
		{
			id = "tut_letters",
			chapter = 0,
			resident = "Pip",
			type = "Collect",
			points = {
				{ surface = { -66, 46, 3 } },
				{ surface = { 62, 58, 3 } },
				{ surface = { -24, -84, 3 } },
				{ surface = { 84, -44, 3 } },
			},
			gold = 45,
			silver = 75,
			minTime = 10,
		},
		{
			id = "tut_lanterns",
			chapter = 0,
			resident = "Momo",
			type = "Beacons",
			points = {
				{ surface = { -112, 30, 0 } },
				{ surface = { 104, 92, 0 } },
				{ surface = { 22, -122, 0 } },
			},
			gold = 35,
			silver = 60,
			minTime = 6,
		},
		{
			id = "tut_dive",
			chapter = 0,
			resident = "Pip",
			type = "Rings",
			requires = { "tut_letters" },
			-- 구름 계단 꼭대기에서 뛰어내리며 통과한다
			points = {
				{ air = { 128, 158, 56 } },
				{ air = { 136, 122, 48 } },
				{ air = { 144, 86, 40 } },
				{ air = { 150, 50, 32 } },
			},
			gold = 30,
			silver = 50,
			minTime = 4,
		},
		{
			id = "c1_delivery",
			chapter = 1,
			resident = "Rhea",
			type = "Delivery",
			-- 스톰프하면 화분이 깨진다
			target = { surface = { 58, -70, 0 } },
			gold = 25,
			silver = 45,
			minTime = 5,
		},
		{
			id = "c1_beacons",
			chapter = 1,
			resident = "Rhea",
			type = "Beacons",
			points = {
				{ satellite = { 2, 0 } },
				{ satellite = { 4, 0 } },
				{ satellite = { 6, 0 } },
			},
			gold = 70,
			silver = 120,
			minTime = 15,
		},
		{
			id = "c1_dive",
			chapter = 1,
			resident = "Rhea",
			type = "Rings",
			requires = { "c1_beacons" },
			-- 정상(470 m)의 종 옆에서 뛰어내려 섬까지 내려오는 다이빙
			points = {
				{ air = { 10, 420, 36 } },
				{ air = { 24, 340, 56 } },
				{ air = { 36, 260, 70 } },
				{ air = { 46, 180, 78 } },
				{ air = { 52, 100, 80 } },
			},
			gold = 110,
			silver = 180,
			minTime = 12,
		},
		{
			id = "c1_laundry",
			chapter = 1,
			resident = "Bram",
			type = "Collect",
			item = "Laundry",
			-- 지붕, 나선 섬 정원, 상승 기류 속, 퍼플링 줄 끝, 바운스 꽃 위
			points = {
				{ surface = { -66, 58, 3 } },
				{ surface = { 58, -70, 3 } },
				{ satellite = { 1, 3 } },
				{ satellite = { 2, 3 } },
				{ satellite = { 3, 3 } },
				{ air = { -38, 170, -52 } },
				{ air = { 124, 186, 40 } },
				{ air = { -20, 100, 90 } },
			},
			gold = 90,
			silver = 150,
			minTime = 25,
		},
		{
			id = "c1_murk",
			chapter = 1,
			resident = "Bram",
			type = "Murk",
			requires = { "c1_laundry" },
			-- 집 지붕에서 시작해 마을 위를 감아 오른다. 땅에 닿으면 터뜨린 머크가 다시 뭉친다
			points = {
				{ surface = { -66, 58, 5 } },
				{ air = { -46, 48, 78 } },
				{ air = { -17, 60, 70 } },
				{ air = { -4, 72, 42 } },
				{ air = { -17, 84, 14 } },
				{ air = { -46, 96, 6 } },
				{ air = { -71, 108, 24 } },
			},
			gold = 22,
			silver = 40,
			minTime = 8,
