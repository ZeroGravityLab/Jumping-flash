			<Item class="ModuleScript" referent="RBX1A18B94BE63540579D3D5EBD97A3A036">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 클라우드 러시 규칙 (순수 함수, Roblox·Lune 공용): 해일 높이, 순위, 보상
local RushLogic = {}

export type Entry = { id: any, maxHeight: number, rangAt: number? }

-- 라운드 시작 뒤 elapsed초의 해일 높이 (탑 바닥 기준). TideDelay까지는 0, 그 뒤로 점점 빨라진다
function RushLogic.tideHeight(cfg, elapsed: number): number
	local t = elapsed - cfg.TideDelay
	if t <= 0 then
		return 0
	end
	return cfg.TideStartSpeed * t + cfg.TideAccel * t * t / 2
end

-- 순위: 종을 먼저 울린 사람, 그다음 최고 높이. 원본을 바꾸지 않는다
function RushLogic.rank(entries: { Entry }): { Entry }
	local sorted = table.clone(entries)
	table.sort(sorted, function(a, b)
		if a.rangAt and b.rangAt then
			return a.rangAt < b.rangAt
		elseif a.rangAt or b.rangAt then
			return a.rangAt ~= nil
		end
		return a.maxHeight > b.maxHeight
	end)
	return sorted
end

-- 라이벌 밟기를 인정하는가: 밟은 쪽이 위에 있고 가까우며, 밟힌 쪽이 무적이 아니다
-- rise = 밟은 쪽 루트 높이 - 밟힌 쪽 루트 높이, reach = 두 루트의 수평 거리
function RushLogic.canStomp(cfg, rise: number, reach: number, now: number, immuneUntil: number?): boolean
	return rise >= cfg.StompMinRise
		and rise <= cfg.StompMaxRise
		and reach <= cfg.StompMaxReach
		and now >= (immuneUntil or 0)
end

-- 코인: 높이(MetersPerCoin마다 1) + 순위 보너스(경쟁 상대가 있을 때만) + 종 보너스
function RushLogic.coins(cfg, heightMeters: number, rank: number, total: number, rang: boolean): number
	local coins = math.floor(math.max(heightMeters, 0) / cfg.MetersPerCoin)
	if total >= cfg.RankBonusMinPlayers then
		coins += cfg.RankBonus[rank] or 0
	end
	if rang then
		coins += cfg.BellBonus
	end
	return coins
end

return RushLogic
]]></ProtectedString>
					<string name="ScriptGuid">{A746F298-3552-45FE-9893-C2DE4F8B49F7}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RushLogic</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000ce957</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXFA3B5FA5FB44455583A32B2573ACEB27">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- MovementGuard 규칙 (GDD 14.2, 순수 함수). 서버가 일정 간격으로 본 높이를 넣으면 이상한 상승을 찾는다.
--   상승 예산: 새 최고 높이(peak)를 넘는 만큼 예산을 쓴다. 예산은 GuardRiseBurst까지 차고 초당 GuardRiseRate로 회복한다.
--     이미 가 본 높이로 돌아오는 것(낙하 후 안전 위치 복귀 등)은 예산을 쓰지 않는다.
--   비행: GuardMaxRiseTime초 넘게 쉬지 않고 오른다
local GuardLogic = {}

export type State = { budget: number, peak: number, lastY: number, risingFor: number }

function GuardLogic.new(cfg, y: number): State
	return { budget = cfg.GuardRiseBurst, peak = y, lastY = y, risingFor = 0 }
end

-- 한 번 본 결과. 문제가 없으면 true, 있으면 false와 이유("rise" | "flying"). 문제가 있으면 state를 바꾸지 않는다
function GuardLogic.step(cfg, state: State, y: number, dt: number): (boolean, string?)
	local budget = math.min(cfg.GuardRiseBurst, state.budget + cfg.GuardRiseRate * dt)
	local risingFor = if y > state.lastY + cfg.GuardRisingStep then state.risingFor + dt else 0
	if risingFor > cfg.GuardMaxRiseTime then
		return false, "flying"
	end
	local gain = y - state.peak
	if gain > budget then
		return false, "rise"
	end
	if gain > 0 then
		budget -= gain
		state.peak = y
	end
	state.budget = budget
	state.risingFor = risingFor
	state.lastY = y
	return true, nil
end

-- 되돌린 뒤: 그 높이에서 다시 본다 (연속 상승 시간도 처음부터)
function GuardLogic.reset(state: State, y: number)
	state.lastY = y
	state.risingFor = 0
end

return GuardLogic
]]></ProtectedString>
					<string name="ScriptGuid">{800CD2C6-DF2F-4025-9B12-469090289B5E}</string>
