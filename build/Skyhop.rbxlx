				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">World</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000020fe</UniqueId>
			</Properties>
			<Item class="ModuleScript" referent="RBXA9C4899A099549DC928C9A3D9B8AD23D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 떠 있는 섬 지형. 몸통 모양은 Shared/WorldGen이 계산하고 여기서는 Terrain에 채우기만 한다
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldGen = require(ReplicatedStorage.Shared.WorldGen)

local IslandTerrain = {}

local LAYER_MATERIAL = {
	soil = Enum.Material.Ground,
	sand = Enum.Material.Sandstone,
	rock = Enum.Material.Rock,
}

export type Options = {
	hills: number?,
	plazaRadius: number?,
}

-- top은 잔디 윗면 중심
function IslandTerrain.build(top: Vector3, radius: number, depth: number, seed: number, options: Options?)
	local terrain = workspace.Terrain
	local opts = options or {}

	for _, piece in WorldGen.islandBody(radius, depth, top.Y, seed) do
		local center = Vector3.new(top.X + piece.x, piece.y, top.Z + piece.z)
		local material = LAYER_MATERIAL[piece.layer]
		if piece.shape == "slice" then
			terrain:FillCylinder(CFrame.new(center), piece.h, piece.r, material)
		else
			terrain:FillBall(center, piece.r, material)
		end
	end

	terrain:FillCylinder(CFrame.new(top - Vector3.new(0, 8, 0)), 12, radius * 0.97, Enum.Material.Ground)
	terrain:FillCylinder(CFrame.new(top - Vector3.new(0, 2.5, 0)), 5, radius, Enum.Material.Grass)

	-- 완만한 언덕: 구의 윗부분만 지면 위로 나오게 묻는다
	local plazaRadius = opts.plazaRadius or 0
	local rng = WorldGen.rng(seed + 101)
	for _ = 1, opts.hills or 0 do
		local angle = rng:range(0, math.pi * 2)
		local dist = rng:range(plazaRadius + 30, radius * 0.7)
		local r = rng:range(18, 36)
		local rise = r * rng:range(0.22, 0.36)
		local center = top + Vector3.new(math.cos(angle) * dist, rise - r, math.sin(angle) * dist)
		terrain:FillBall(center, r, Enum.Material.Grass)
	end

	if plazaRadius > 0 then
		terrain:FillCylinder(CFrame.new(top - Vector3.new(0, 1, 0)), 2, plazaRadius, Enum.Material.Cobblestone)
	end
end

return IslandTerrain
]]></ProtectedString>
					<string name="ScriptGuid">{B9A0E5D1-1A95-4292-8F95-5BB5B77B5FD2}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">IslandTerrain</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000020ff</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXA82D9732AE8F441983325860A90512D8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 무료 에셋(ServerStorage.Assets)을 섬 위에 배치한다. 출처와 정화 방법은 ASSETS.md
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)
local WorldGen = require(ReplicatedStorage.Shared.WorldGen)

local Decor = {}

local TREE_VARIANTS = { "", "F", "T" }

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.FilterDescendantsInstances = { workspace.Terrain }

function Decor.assets(): Folder?
	return ServerStorage:FindFirstChild("Assets")
end

function Decor.template(category: string, name: string): Model?
	local assets = Decor.assets()
	local folder = assets and assets:FindFirstChild(category)
	return folder and folder:FindFirstChild(name) :: Model?
end

-- 지형 윗면. 너무 가파른 비탈이면 nil
function Decor.groundAt(x: number, aboveY: number, z: number): RaycastResult?
	local hit = workspace:Raycast(Vector3.new(x, aboveY + 150, z), Vector3.new(0, -500, 0), groundParams)
	if hit and hit.Normal.Y >= 0.7 then
		return hit
	end
	return nil
end

function Decor.place(template: Model, position: Vector3, yaw: number, scale: number, parent: Instance): Model
	local model = template:Clone()
	if scale ~= 1 then
		-- ScaleTo는 제작자가 저장한 원래 크기 기준의 절댓값이라, 지금 배율에 곱해야 한다
		model:ScaleTo(model:GetScale() * scale)
	end
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0))
	model.Parent = parent
	return model
end

local function setPassThrough(model: Model)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
end

local function pick(rng, list)
	return list[1 + math.floor(rng:next() * #list)]
end

export type ScatterSpec = {
	seed: number,
	radius: number,
	plazaRadius: number?,
	treePalette: { number },
	trees: number,
	flowers: number,
	rocks: number,
	treeScale: { number }?,
}

-- 잎이 sky 제외 구역(의뢰 랜턴 등)을 덮는 나무인가
local function shadesSky(x: number, z: number, canopy: number, exclusions: { any }): boolean
	for _, e in exclusions do
		if e.sky and (x - e.x) ^ 2 + (z - e.z) ^ 2 < (e.r + canopy) ^ 2 then
			return true
		end
	end
	return false
end

-- 섬 하나에 나무·꽃·바위를 흩뿌린다. exclusions는 섬 중심 기준 {x, z, r, sky?}
function Decor.scatterIsland(top: Vector3, spec: ScatterSpec, exclusions: { any }, parent: Instance)
	local rng = WorldGen.rng(spec.seed + 500)
	local inner = (spec.plazaRadius or 0) + 8
	local treeScale = spec.treeScale or { 0.65, 1.1 }

	local treePoints = WorldGen.scatter(spec.seed + 1, spec.trees, inner, spec.radius * 0.86, 15, exclusions)
	for _, p in treePoints do
		local name = "Tree_Tree" .. pick(rng, spec.treePalette) .. pick(rng, TREE_VARIANTS)
		local template = Decor.template("Trees", name)
		local yaw, scale = rng:range(0, 360), rng:range(treeScale[1], treeScale[2])
		if
			template and not shadesSky(p.x, p.z, (template:GetAttribute("Footprint") :: number) * scale / 2, exclusions)
		then
			local hit = Decor.groundAt(top.X + p.x, top.Y, top.Z + p.z)
			if hit then
				Decor.place(template, hit.Position - Vector3.new(0, 1, 0), yaw, scale, parent)
			end
		end
	end

	-- 꽃: 작은 꽃 몇 송이를 한 무더기로, 가끔 꽃덤불
	local flowerSmall = Decor.template("Plants", "Flower_Small")
	local flowerBush = Decor.template("Plants", "FlowerBush")
	local flowerPoints = WorldGen.scatter(spec.seed + 2, spec.flowers, inner, spec.radius * 0.9, 7, exclusions)
	for _, p in flowerPoints do
		local useBush = rng:next() < 0.25
		local clusterSize = if useBush then 1 else 3
		for _ = 1, clusterSize do
			local x = top.X + p.x + rng:range(-4, 4)
			local z = top.Z + p.z + rng:range(-4, 4)
			local hit = Decor.groundAt(x, top.Y, z)
			local template = if useBush then flowerBush else flowerSmall
			if hit and template then
				local scale = if useBush then rng:range(0.8, 1.3) else rng:range(1.4, 2.4)
				setPassThrough(Decor.place(template, hit.Position, rng:range(0, 360), scale, parent))
			end
		end
	end

	local rockPoints = WorldGen.scatter(spec.seed + 3, spec.rocks, inner, spec.radius * 0.92, 18, exclusions)
	for _, p in rockPoints do
		local hit = Decor.groundAt(top.X + p.x, top.Y, top.Z + p.z)
		local template = Decor.template("Rocks", "Rock_" .. (1 + math.floor(rng:next() * 6)))
		if hit and template then
			local scale = rng:range(0.7, 1.7)
			local rock =
				Decor.place(template, hit.Position - Vector3.new(0, scale, 0), rng:range(0, 360), scale, parent)
			-- 원본이 눈처럼 하얀 돌이라 따뜻한 돌색으로 칠한다
			local tone = rng:range(0.85, 1)
			for _, part in rock:GetDescendants() do
				if part:IsA("BasePart") then
					part.Color = Color3.fromRGB(176 * tone, 166 * tone, 152 * tone)
				end
			end
		end
	end
end

-- 건물 {이름, x, z, 방향(도), 배율?} (섬 중심 기준)
function Decor.building(top: Vector3, spec: { any }, parent: Instance): Model?
	local name, x, z, yaw, scale = spec[1], spec[2], spec[3], spec[4], spec[5] or 1
	local template = Decor.template("Buildings", name)
	local hit = Decor.groundAt(top.X + x, top.Y, top.Z + z)
	if not (template and hit) then
		warn("[Decor] building skipped:", name)
		return nil
	end
	local model = Decor.place(template, hit.Position - Vector3.new(0, 1, 0), yaw, scale, parent)

	-- 풍차 날개는 클라이언트(Ambience)가 돌린다
	local fan = model:FindFirstChild("Fan", true)
	local house = model:FindFirstChild("House", true)
	if fan and house and fan:IsA("Model") and house:IsA("Model") then
		local fanCenter = fan:GetBoundingBox().Position
		local axis = (fanCenter - house:GetBoundingBox().Position) * Vector3.new(1, 0, 1)
		fan:SetAttribute("SpinCenter", fanCenter)
		fan:SetAttribute("SpinAxis", axis.Unit)
		fan:SetAttribute("SpinSpeed", 0.35)
		CollectionService:AddTag(fan, Tags.Spin)
	end
	return model
end

-- 징검다리 작은 섬 {x, 윗면 y, z, 배율}
function Decor.steppingStone(spec: { number }, index: number, parent: Instance): Model?
	local template = Decor.template("Islets", "Islet_" .. (1 + (index - 1) % 3))
	if not template then
		return nil
	end
	local scale = spec[4]
	local height = (template:GetAttribute("Height") :: number) * scale
	return Decor.place(template, Vector3.new(spec[1], spec[2] - height, spec[3]), index * 47, scale, parent)
end

-- 열기구와 갈매기 떼: 위치만 정하고 움직임은 클라이언트(Ambience)가 맡는다
local GULLS_PER_FLOCK = 6
local GULL_SPACING = 7 -- 템플릿 날개폭(약 4.4)의 배율 1 기준 V자 간격

-- 갈매기 떼: Assets/Sky/Gull(날개 뼈대 WingL1·L2·R1·R2가 있는 스킨 메시, ASSETS.md)을 느슨한 V자로 세운다 (앞이 -Z).
-- 날갯짓·활공·흔들림·기울기는 클라이언트 Ambience가 뼈대와 기준점으로 매 프레임 정한다
local function gullFlock(template: Model, center: Vector3, scale: number, rng, parent: Instance): Model
	local flock = Instance.new("Model")
	flock.Name = "Gulls"
	flock:SetAttribute("Flock", true)
	for i = 1, GULLS_PER_FLOCK do
		local rank = i // 2
		local side = if i % 2 == 0 then -1 else 1
		local offset = if i == 1
			then Vector3.zero
			else Vector3.new(
				side * rank * GULL_SPACING + rng:range(-1.5, 1.5),
				rng:range(-2, 2),
				rank * GULL_SPACING * 0.8 + rng:range(-1.5, 1.5)
			) * scale
		local bird = template:Clone()
		bird:ScaleTo(bird:GetScale() * scale)
		bird:PivotTo(CFrame.new(center + offset))
		bird:SetAttribute("Offset", offset)
		bird:SetAttribute("Phase", rng:range(0, math.pi * 2))
		bird:SetAttribute("Scale", scale)
		bird.Parent = flock
	end
	flock.WorldPivot = CFrame.new(center)
	flock.Parent = parent
	return flock
end

function Decor.skyLife(config, parent: Instance)
	local balloon = Decor.template("Sky", "Balloon")
	local gullTemplate = Decor.template("Sky", "Gull")

	local rng = WorldGen.rng(config.Balloons.seed)
	for _ = 1, config.Balloons.count do
		if not balloon then
			break
		end
		local angle = rng:range(0, math.pi * 2)
		local dist = rng:range(config.Balloons.minDistance, config.Balloons.maxDistance)
		local position = Vector3.new(
			math.cos(angle) * dist,
			rng:range(config.Balloons.minY, config.Balloons.maxY),
			math.sin(angle) * dist
		)
		local model = Decor.place(balloon, position, rng:range(0, 360), rng:range(2.2, 3.2), parent)
		setPassThrough(model)
		model:SetAttribute("DriftPhase", rng:range(0, math.pi * 2))
		CollectionService:AddTag(model, Tags.Drift)
	end

	rng = WorldGen.rng(config.BirdFlocks.seed)
	for _ = 1, config.BirdFlocks.count do
		local angle = rng:range(0, math.pi * 2)
		local dist = rng:range(config.BirdFlocks.minDistance, config.BirdFlocks.maxDistance)
		local center = Vector3.new(
			math.cos(angle) * dist,
			rng:range(config.BirdFlocks.minY, config.BirdFlocks.maxY),
			math.sin(angle) * dist
		)
		if not gullTemplate then
			break
		end
		local model = gullFlock(gullTemplate, center, rng:range(1.6, 2.4), rng, parent)
		model:SetAttribute("OrbitCenter", center)
		model:SetAttribute("OrbitRadius", rng:range(40, 110))
		model:SetAttribute("OrbitSpeed", rng:range(0.08, 0.16) * (if rng:next() < 0.5 then -1 else 1))
		model:SetAttribute("OrbitPhase", rng:range(0, math.pi * 2))
		CollectionService:AddTag(model, Tags.Orbit)
	end
end

return Decor
]]></ProtectedString>
					<string name="ScriptGuid">{58A5948A-887B-4C8E-B7C4-8C0D96752995}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Decor</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00002101</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1C67B54471064ECC91B599349D4365C4">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 이동 장치: 종, 바운스 꽃, 퍼플링, 구름 계단, 상승 기류 (GDD 8.2~8.3). 허브의 지도 탁자도 여기서 만든다.
-- 태그로 동작을 정하고(HopController가 읽는다) 모양은 파트로 만든다
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)
local Decor = require(script.Parent.Decor)

local Features = {}

local COLOR = {
	Stone = Color3.fromRGB(226, 220, 208),
	StoneDark = Color3.fromRGB(176, 164, 150),
	Bell = Color3.fromRGB(255, 200, 70),
	Stem = Color3.fromRGB(96, 168, 92),
	Petal = Color3.fromRGB(255, 160, 200),
	Cap = Color3.fromRGB(255, 214, 80),
	Cloud = Color3.fromRGB(250, 252, 255),
	Puffling = Color3.fromRGB(255, 246, 252),
	Cheek = Color3.fromRGB(255, 170, 200),
	Eye = Color3.fromRGB(40, 40, 60),
	MapSky = Color3.fromRGB(150, 200, 245),
	Wood = Color3.fromRGB(150, 104, 66),
	ShopStripe = Color3.fromRGB(90, 160, 240),
	ShopStripeLight = Color3.fromRGB(245, 248, 255),
	ShopGold = Color3.fromRGB(214, 160, 50),
	ShopBoot = Color3.fromRGB(230, 70, 80),
}

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	return p
end

local function decorative(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

-- 세로축 원기둥의 회전 (Roblox 원기둥은 X축이 길이 방향)
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function groundOrTop(top: Vector3, x: number, z: number): Vector3
	local hit = Decor.groundAt(top.X + x, top.Y, top.Z + z)
	return if hit then hit.Position else Vector3.new(top.X + x, top.Y, top.Z + z)
end

-- 종탑: 돌기둥 위에 황금 종
function Features.Bell(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	local model = Instance.new("Model")
	model.Name = "BellTower"
	part({
		Name = "Plinth",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, 16, 16),
		CFrame = CFrame.new(base + Vector3.new(0, 1, 0)) * UPRIGHT,
		Color = COLOR.StoneDark,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	part({
		Name = "Pillar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(24, 6, 6),
		CFrame = CFrame.new(base + Vector3.new(0, 14, 0)) * UPRIGHT,
		Color = COLOR.Stone,
		Material = Enum.Material.Limestone,
		Parent = model,
	})
	part({
		Name = "Crown",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 12, 12),
		CFrame = CFrame.new(base + Vector3.new(0, 27, 0)) * UPRIGHT,
		Color = COLOR.StoneDark,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	local bell = part({
		Name = "Bell",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(7, 7, 7),
		CFrame = CFrame.new(base + Vector3.new(0, 32, 0)),
		Color = COLOR.Bell,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = model,
	})
	local light = Instance.new("PointLight")
	light.Color = COLOR.Bell
	light.Range = 18
	light.Brightness = 1.5
	light.Parent = bell
	CollectionService:AddTag(bell, Tags.Bell)
	model.Parent = parent
end

-- 지도 탁자: 돌 받침 위 하늘빛 원판에 작은 섬들. 말을 걸면 하늘 지도가 열린다 (클라이언트 SkyMap)
function Features.MapTable(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	local model = Instance.new("Model")
	model.Name = "MapTable"
	part({
		Name = "Stand",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3.2, 4, 4),
		CFrame = CFrame.new(base + Vector3.new(0, 1.6, 0)) * UPRIGHT,
		Color = COLOR.StoneDark,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	local face = part({
		Name = "Face",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 10, 10),
		CFrame = CFrame.new(base + Vector3.new(0, 3.5, 0)) * UPRIGHT,
		Color = COLOR.MapSky,
		Parent = model,
	})
	-- 허브, 1장 섬, 아직 흐린 섬들
	for _, isle in
		{
			{ 0, 0, 2.2, COLOR.Stem },
			{ 2.8, -0.6, 1.8, COLOR.Stem },
			{ -2.6, -2.2, 1.2, COLOR.StoneDark },
			{ -3.1, 1.6, 1.2, COLOR.StoneDark },
			{ 0.2, 3.4, 1.2, COLOR.StoneDark },
			{ 3.1, 2.4, 1.2, COLOR.StoneDark },
		}
	do
		decorative(part({
			Name = "Isle",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(isle[3] * 0.5, isle[3], isle[3]),
			CFrame = CFrame.new(base + Vector3.new(isle[1], 3.8 + isle[3] * 0.25, isle[2])) * UPRIGHT,
			Color = isle[4],
			Material = Enum.Material.Grass,
			Parent = model,
		}))
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "View map" -- 클라이언트가 언어에 맞게 바꾼다
	prompt.ObjectText = "Sky Map"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("SkyMap", true)
	prompt.Parent = face
	model.Parent = parent
end

-- 상점 가판대: 줄무늬 차양, 금화 간판, 진열한 부츠와 궤적 리본. 말을 걸면 코인 상점이 열린다 (클라이언트 ShopUi)
-- 글자 간판은 언어마다 달라서 두지 않는다
function Features.ShopStall(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	local face = top + Vector3.new(spec.face[1], 0, spec.face[2])
	local facing = CFrame.lookAt(base, Vector3.new(face.X, base.Y, face.Z))
	local function at(x: number, y: number, z: number): CFrame
		return facing * CFrame.new(x, y, z)
	end
	local model = Instance.new("Model")
	model.Name = "ShopStall"
	local counter = part({
		Name = "Counter",
		Size = Vector3.new(9, 3.2, 3),
		CFrame = at(0, 1.6, 0),
		Color = COLOR.Wood,
		Material = Enum.Material.WoodPlanks,
		Parent = model,
	})
	for _, x in { -4.3, 4.3 } do
		part({
			Name = "Post",
			Size = Vector3.new(0.5, 8, 0.5),
			CFrame = at(x, 4, 1.4),
			Color = COLOR.Wood,
			Parent = model,
		})
	end
	for i = 1, 6 do
		decorative(part({
			Name = "Awning",
			Size = Vector3.new(1.6, 0.2, 4.4),
			CFrame = at(-4 + (i - 0.5) * 1.6, 7.6, -0.2) * CFrame.Angles(math.rad(-16), 0, 0),
			Color = if i % 2 == 0 then COLOR.ShopStripeLight else COLOR.ShopStripe,
			Parent = model,
		}))
	end
	-- 금화 간판
	decorative(part({
		Name = "Coin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 3.4, 3.4),
		CFrame = at(0, 9.6, 1.4) * CFrame.Angles(0, math.rad(90), 0),
		Color = COLOR.Bell,
		Material = Enum.Material.Neon,
		Parent = model,
	}))
	decorative(part({
		Name = "CoinRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 4, 4),
		CFrame = at(0, 9.6, 1.5) * CFrame.Angles(0, math.rad(90), 0),
		Color = COLOR.ShopGold,
		Parent = model,
	}))
	-- 진열: 카운터 위 부츠 한 켤레, 차양 끝의 궤적 리본
	for _, x in { -2.6, -1.4 } do
		decorative(part({
			Name = "DisplayBoot",
			Size = Vector3.new(0.9, 1, 1.4),
			CFrame = at(x, 3.7, -0.2),
			Color = COLOR.ShopBoot,
			Parent = model,
		}))
		decorative(part({
			Name = "DisplaySole",
			Size = Vector3.new(1, 0.25, 1.5),
			CFrame = at(x, 3.3, -0.2),
			Color = COLOR.Cloud,
			Parent = model,
		}))
	end
	for i, color in { COLOR.Petal, COLOR.Cap, COLOR.MapSky } do
		decorative(part({
			Name = "Ribbon",
			Size = Vector3.new(0.5, 2.6, 0.08),
			CFrame = at(-3 + i * 1.5, 5.9, -2.3),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = model,
		}))
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Shop" -- 클라이언트가 언어에 맞게 바꾼다
	prompt.ObjectText = "Sky Shop"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Shop", true)
	prompt.Parent = counter
	model.Parent = parent
end

-- 바운스 꽃: 노란 꽃잎 판을 밟으면 크게 튄다
function Features.BounceFlower(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	local model = Instance.new("Model")
	model.Name = "BounceFlower"
	decorative(part({
		Name = "Stem",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(6, 2.4, 2.4),
		CFrame = CFrame.new(base + Vector3.new(0, 3, 0)) * UPRIGHT,
		Color = COLOR.Stem,
		Parent = model,
	}))
	local cap = part({
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 12, 12),
		CFrame = CFrame.new(base + Vector3.new(0, 6.5, 0)) * UPRIGHT,
		Color = COLOR.Cap,
		Parent = model,
	})
	CollectionService:AddTag(cap, Tags.BouncePad)
	for i = 1, 8 do
		local angle = i / 8 * math.pi * 2
		decorative(part({
			Name = "Petal",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(4, 4, 4),
			CFrame = CFrame.new(base + Vector3.new(math.cos(angle) * 6.5, 6.2, math.sin(angle) * 6.5)),
			Color = COLOR.Petal,
			Parent = model,
		}))
	end
	model.Parent = parent
end

-- 바운스 패드 (러시 탑): 공중에 뜬 노란 원판. 윗면이 top
function Features.padAt(top: Vector3, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "BouncePad"
	local pad = part({
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.4, 12, 12),
		CFrame = CFrame.new(top - Vector3.new(0, 0.7, 0)) * UPRIGHT,
		Color = COLOR.Cap,
		Parent = model,
	})
	CollectionService:AddTag(pad, Tags.BouncePad)
	for i = 1, 8 do
		local angle = i / 8 * math.pi * 2
		decorative(part({
			Name = "Petal",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3.4, 2.4, 3.4),
			CFrame = CFrame.new(top + Vector3.new(math.cos(angle) * 6.4, -1.2, math.sin(angle) * 6.4)),
			Color = COLOR.Petal,
			Parent = model,
		}))
	end
	model.Parent = parent
end

-- 퍼플링: 밟으면 튀어 오르는 구름 덩어리 생물 (충돌 없음, 밟기는 레이캐스트로 판정)
local function puffling(position: Vector3, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "Puffling"
	local body = part({
		Name = "Body",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 8, 8),
		CFrame = CFrame.new(position),
		Color = COLOR.Puffling,
		CanCollide = false,
		CanTouch = false,
		Parent = model,
	})
	CollectionService:AddTag(body, Tags.Stompable)
	for _, side in { -1, 1 } do
		decorative(part({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.1, 1.1, 1.1),
			CFrame = CFrame.new(position + Vector3.new(side * 1.5, 0.8, -3.6)),
			Color = COLOR.Eye,
			Parent = model,
		}))
		decorative(part({
			Name = "Cheek",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(1.4, 0.8, 0.8),
			CFrame = CFrame.new(position + Vector3.new(side * 2.4, -0.6, -3.3)),
			Color = COLOR.Cheek,
			Parent = model,
		}))
	end
	model.Parent = parent
	return body
end

Features.puffling = puffling

-- 퍼플링 줄: heights는 지면 기준 높이, step은 한 마리 사이 수평 간격
function Features.Pufflings(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	for i, height in spec.heights do
		puffling(base + Vector3.new((i - 1) * spec.step, height, 0), parent)
	end
end

-- 일방향 구름 발판: 평평한 원판 하나(Cloud 태그) + 테두리 솜뭉치
local function cloudPlatform(center: Vector3, diameter: number, parent: Instance)
	local model = Instance.new("Model")
	model.Name = "CloudPlatform"
	local top = part({
		Name = "Top",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(3, diameter, diameter),
		CFrame = CFrame.new(center) * UPRIGHT,
		Color = COLOR.Cloud,
		Parent = model,
	})
	CollectionService:AddTag(top, Tags.Cloud)
	for i = 1, 7 do
		local angle = i / 7 * math.pi * 2
		local r = diameter * 0.42
		local size = diameter * (0.28 + (i % 3) * 0.05)
		decorative(part({
			Name = "Puff",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size * 0.7, size),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * r, -1, math.sin(angle) * r)),
			Color = COLOR.Cloud,
			Parent = model,
		}))
	end
	model.Parent = parent
end

Features.cloudPlatform = cloudPlatform

function Features.CloudSteps(top: Vector3, spec, parent: Instance)
	local base = groundOrTop(top, spec.x, spec.z)
	for i = 1, spec.count do
		cloudPlatform(
			base + Vector3.new((i % 2) * 10, spec.rise * i, (i % 3) * 6),
			if i == spec.count then 34 else 26,
			parent
		)
	end
end

-- 상승 기류: 보이지 않는 기둥(Updraft 태그) + 위로 흐르는 바람 입자. 밑면이 base
function Features.updraftAt(base: Vector3, height: number, parent: Instance)
	local column = part({
		Name = "Updraft",
		Size = Vector3.new(18, height, 18),
		CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0)),
		Transparency = 1,
		Parent = parent,
	})
	decorative(column)
	CollectionService:AddTag(column, Tags.Updraft)

	local wind = Instance.new("ParticleEmitter")
	wind.Rate = 40
	wind.Lifetime = NumberRange.new(2.5, 4)
	wind.Speed = NumberRange.new(45, 70)
	wind.EmissionDirection = Enum.NormalId.Top
	wind.SpreadAngle = Vector2.new(4, 4)
	wind.Size = NumberSequence.new(0.5)
	wind.Squash = NumberSequence.new(-2.5)
	wind.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.45),
		NumberSequenceKeypoint.new(1, 1),
	})
	wind.LightEmission = 0.4
	wind.Color = ColorSequence.new(Color3.fromRGB(235, 248, 255))
	wind.Parent = column
end

function Features.Updraft(top: Vector3, spec, parent: Instance)
	Features.updraftAt(groundOrTop(top, spec.x, spec.z), spec.height, parent)
end

return Features
]]></ProtectedString>
					<string name="ScriptGuid">{257D73D5-B5F0-4259-BD2D-5FB07E9C1B55}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Features</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00002103</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXF3664F92B17C4F73BB5D2F05276C0DA5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 구름: 섬 아래 멀리 깔린 구름 바다와, 섬 사이를 떠다니는 구름 덩어리.
-- 모양은 무료 구름 메시(Assets/Sky/Cloud, ASSETS.md)를 크기·방향을 바꿔 반복해 쓴다
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)
local WorldGen = require(ReplicatedStorage.Shared.WorldGen)
local Decor = require(script.Parent.Decor)

local Clouds = {}

-- 대기 안개색(Sky.luau)보다 확실히 밝아야 멀리 아래에서도 구름 바다가 드러난다.
-- 바닥판은 구름 골짜기의 그늘색이다. 뭉게구름보다 어두워야 판이 아니라 구름 무늬로 읽힌다
local CLOUD_COLOR = Color3.fromRGB(255, 255, 255)
local SHADE_COLOR = Color3.fromRGB(244, 247, 255)
local FLOOR_COLOR = Color3.fromRGB(214, 226, 246)
local MAX_PART_SIZE = 2048

local function pass(part: BasePart)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
end

-- 구름 하나: 폭 width, 납작함 flatten(높이 배율), 색
local function cloud(
	template: Model,
	position: Vector3,
	width: number,
	flatten: number,
	yaw: number,
	color: Color3,
	parent: Instance
): Model
	local model = template:Clone()
	local footprint = template:GetAttribute("Footprint") :: number
	model:ScaleTo(model:GetScale() * width / footprint)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			pass(part)
			part.Color = color
			part.Size = part.Size * Vector3.new(1, flatten, 1)
		end
	end
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, math.rad(yaw), 0))
	model.Parent = parent
	return model
end

-- 끝없이 펼쳐진 구름 바다. 바닥판이 틈을 메우고 그 위에 구름이 뭉게뭉게 솟는다
function Clouds.sea(config, parent: Instance)
	local template = Decor.template("Sky", "Cloud")
	local folder = Instance.new("Folder")
	folder.Name = "CloudSea"

	local tiles = math.ceil(config.CloudSeaFloorRadius * 2 / MAX_PART_SIZE)
	local start = -config.CloudSeaFloorRadius + MAX_PART_SIZE / 2
	for ix = 0, tiles - 1 do
		for iz = 0, tiles - 1 do
			local floor = Instance.new("Part")
			floor.Name = "Floor"
			floor.Material = Enum.Material.SmoothPlastic
			floor.Color = FLOOR_COLOR
			floor.Size = Vector3.new(MAX_PART_SIZE, 4, MAX_PART_SIZE)
			floor.CFrame = CFrame.new(start + ix * MAX_PART_SIZE, config.CloudSeaY - 30, start + iz * MAX_PART_SIZE)
			pass(floor)
			floor.Parent = folder
		end
	end

	if template then
		local rng = WorldGen.rng(31)
		for _ = 1, config.CloudSeaPuffs do
			local angle = rng:range(0, math.pi * 2)
			local dist = math.sqrt(rng:range(0, config.CloudSeaRadius ^ 2))
			local position =
				Vector3.new(math.cos(angle) * dist, config.CloudSeaY + rng:range(-24, 18), math.sin(angle) * dist)
			local color = if rng:next() < 0.35 then SHADE_COLOR else CLOUD_COLOR
			cloud(template, position, rng:range(170, 420), rng:range(0.45, 0.75), rng:range(0, 360), color, folder)
		end
	end
	folder.Parent = parent
end

-- 섬 사이 구름 덩어리. CloudPuff 태그로 클라이언트가 천천히 흘려보내고, 통과하면 바람 소리를 낸다
function Clouds.puffs(config, parent: Instance)
	local template = Decor.template("Sky", "Cloud")
	if not template then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "CloudPuffs"
	local spec = config.CloudPuffs
	local rng = WorldGen.rng(37)
	for i = 1, spec.count do
		local angle = rng:range(0, math.pi * 2)
		local dist = rng:range(spec.minDistance, spec.maxDistance)
		local position = Vector3.new(math.cos(angle) * dist, rng:range(spec.minY, spec.maxY), math.sin(angle) * dist)
		local model =
			cloud(template, position, rng:range(50, 150), rng:range(0.6, 0.9), rng:range(0, 360), CLOUD_COLOR, folder)
		model.Name = "Puff" .. i
		model:SetAttribute("DriftPhase", rng:range(0, math.pi * 2))
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Transparency = 0.08
				CollectionService:AddTag(part, Tags.CloudPuff)
			end
		end
	end
	folder.Parent = parent
end

return Clouds
]]></ProtectedString>
					<string name="ScriptGuid">{19A10F8F-CA84-4ED4-8307-EAE8C86C844A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Clouds</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00002105</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX072359F0BF164CABAD578B7BD9A52CE6">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 하늘과 빛. 늦은 오후의 부드러운 햇살, 먼 섬이 푸르게 바래는 대기, 따뜻한 색감
local Lighting = game:GetService("Lighting")

local Sky = {}

local function ensure(className: string, parent: Instance): any
	local existing = parent:FindFirstChildOfClass(className)
	if existing then
		return existing
	end
	local inst = Instance.new(className)
	inst.Parent = parent
	return inst
end

function Sky.apply()
	Lighting.ClockTime = 15.4
	Lighting.GeographicLatitude = 32
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(118, 120, 140)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 160, 186)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.35
	Lighting.ColorShift_Top = Color3.fromRGB(255, 238, 216)
	-- LightingStyle(Realistic)은 스크립트로 못 바꿔 default.project.json과 place에 둔다 (ASSETS.md)

	-- 먼 곳이 푸르게 바래야 높이와 거리가 느껴진다
	local atmosphere = ensure("Atmosphere", Lighting)
	-- 너무 짙으면 발밑 구름 바다가 묻혀 높이 감이 사라진다 (2026-11-04 플레이테스트)
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.04
	atmosphere.Color = Color3.fromRGB(202, 218, 240)
	atmosphere.Decay = Color3.fromRGB(150, 164, 196)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.0

	local bloom = ensure("BloomEffect", Lighting)
	-- 흰 구름이 번쩍이지 않게 문턱을 높게 둔다
	bloom.Intensity = 0.22
	bloom.Size = 24
	bloom.Threshold = 1.9

	local rays = ensure("SunRaysEffect", Lighting)
	rays.Intensity = 0.06
	rays.Spread = 0.55

	local color = ensure("ColorCorrectionEffect", Lighting)
	color.Brightness = 0.03
	color.Contrast = 0.08
	color.Saturation = 0.15
	color.TintColor = Color3.fromRGB(255, 249, 240)

	local depth = ensure("DepthOfFieldEffect", Lighting)
	depth.FarIntensity = 0.06
	depth.FocusDistance = 80
	depth.InFocusRadius = 300
	depth.NearIntensity = 0

	-- 머리 위 흘러가는 입체 구름
	local clouds = ensure("Clouds", workspace.Terrain)
	clouds.Cover = 0.55
	clouds.Density = 0.5
	clouds.Color = Color3.fromRGB(255, 255, 255)

	-- 움직이는 잔디(Terrain.Decoration)는 스크립트에서 바꿀 수 없어 place에 켜 둔다 (ASSETS.md)
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(118, 186, 88))
	terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(150, 118, 88))
	terrain:SetMaterialColor(Enum.Material.Sandstone, Color3.fromRGB(224, 188, 142))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(150, 140, 136))
	terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(206, 196, 182))
end

return Sky
]]></ProtectedString>
					<string name="ScriptGuid">{CE488ABF-DADC-4463-970C-5F6C93FAEA98}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Sky</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00002107</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX14528E5169F44A78876CDEAAFBFAF897">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 월드 조립: Config/World를 읽어 만든다.
-- 1단계 지형을 모두 채우고, 지형 충돌이 반영된 뒤 2단계로 건물·장치·장식을 지면에 올린다
-- (지형을 채운 같은 프레임에는 레이캐스트가 지형을 찾지 못한다. 2026-11-04 플레이테스트에서 확인)
-- 플레이어가 들어오기 전에 끝나야 하므로 Main이 캐릭터 생성을 잠시 막고 호출한다
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Requests = require(ReplicatedStorage.Config.Requests)
local World = require(ReplicatedStorage.Config.World)
local WorldGen = require(ReplicatedStorage.Shared.WorldGen)
local Clouds = require(script.Parent.Clouds)
local Decor = require(script.Parent.Decor)
local Features = require(script.Parent.Features)
local IslandTerrain = require(script.Parent.IslandTerrain)
local Residents = require(script.Parent.Residents)
local Sky = require(script.Parent.Sky)

local WorldBuilder = {}

local TERRAIN_SETTLE_TIMEOUT = 5
local REQUEST_SPOT_RADIUS = 8 -- 랜턴 스톰프 판정 반경과 같다
local RESIDENT_CLEAR_RADIUS = 10 -- 꽃 무더기가 ±4로 퍼지고 바위가 커서 넉넉히 비운다

local function vec(a: { number }): Vector3
	return Vector3.new(a[1], a[2], a[3])
end

local function folderIn(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local TREE_CLEAR_HEIGHT = 50 -- 이보다 낮은 공중 지점도 나무 수관에 묻히지 않게 비워 둔다

-- 이 섬 의뢰·이야기 소품의 바닥 근처 지점(섬 중심 기준)과 의뢰가 쓰는 위성 섬 번호
local function requestSpots(islandId: string): ({ any }, { [number]: boolean })
	local residentIsland = {}
	for _, resident in Requests.Residents do
		residentIsland[resident.id] = resident.island
	end
	local surface, satellites = {}, {}
	for _, request in Requests.Requests do
		local specs = table.clone(request.points or {})
		if request.target then
			table.insert(specs, request.target)
		end
		for _, spec in specs do
			if (spec.island or residentIsland[request.resident]) ~= islandId then
				continue
			end
			if spec.surface then
				table.insert(surface, { x = spec.surface[1], z = spec.surface[2] })
			elseif spec.air and spec.air[2] < TREE_CLEAR_HEIGHT then
				table.insert(surface, { x = spec.air[1], z = spec.air[3] })
			elseif spec.satellite then
				satellites[spec.satellite[1]] = true
			end
		end
	end
	-- 주민 이야기가 끝나면 세울 소품 자리
	for _, story in Requests.Stories do
		if story.island == islandId then
			for _, spot in story.spots do
				table.insert(surface, { x = spot[1], z = spot[2], r = spot[3] })
			end
		end
	end
	return surface, satellites
end

-- 건물·장치 자리를 비워 두고 나무를 심기 위한 제외 구역 (섬 중심 기준)
local function exclusionsFor(island, spots: { any }): { any }
	local list = {}
	if (island.plazaRadius or 0) > 0 then
		table.insert(list, { x = 0, z = 0, r = island.plazaRadius + 6 })
	end
	for _, b in island.buildings or {} do
		local template = Decor.template("Buildings", b[1])
		local footprint = if template then (template:GetAttribute("Footprint") :: number) * (b[5] or 1) else 30
		table.insert(list, { x = b[2], z = b[3], r = footprint * 0.6 + 6 })
	end
	for _, f in island.features or {} do
		table.insert(list, { x = f.x, z = f.z, r = 14 })
	end
	-- 주민 둘레: 바위·꽃이 얼굴을 가리지 않고 위에서도 보이게
	for _, resident in Requests.Residents do
		if resident.island == island.id then
			table.insert(list, { x = resident.x, z = resident.z, r = RESIDENT_CLEAR_RADIUS, sky = true })
		end
	end
	-- 의뢰 지점(랜턴·배달지 등)은 나무 잎이 덮지 않게 한다
	for _, spot in spots do
		table.insert(list, { x = spot.x, z = spot.z, r = spot.r or REQUEST_SPOT_RADIUS, sky = true })
	end
	return list
end

-- 섬 하나의 지형을 채우고, 지면 위에 올릴 작업은 decorate 목록에 미뤄 둔다
local function buildIsland(island, root: Folder, decorate: { () -> () })
	local top = vec(island.center)
	local folder = folderIn(root, island.id)
	local spots, requestSatellites = requestSpots(island.id)
	IslandTerrain.build(top, island.radius, island.depth, island.seed, {
		hills = island.hills,
		plazaRadius = island.plazaRadius,
	})
	table.insert(decorate, function()
		for _, b in island.buildings or {} do
			Decor.building(top, b, folder)
		end
		for _, f in island.features or {} do
			local builder = Features[f.type]
			if builder then
				builder(top, f, folder)
			else
				warn("[WorldBuilder] unknown feature:", f.type)
			end
		end
		Decor.scatterIsland(top, {
			seed = island.seed,
			radius = island.radius,
			plazaRadius = island.plazaRadius,
			treePalette = island.treePalette,
			trees = island.trees,
			flowers = island.flowers,
			rocks = island.rocks,
		}, exclusionsFor(island, spots), folder)
	end)

	-- 섬을 감아 오르는 작은 섬 정원과 꼭대기
	local s = island.satellites
	if s then
		for i, p in WorldGen.spiral(s.count, s.orbit, s.rise, s.startAngle, s.angleStep, top.Y) do
			local satTop = Vector3.new(top.X + p.x, p.y, top.Z + p.z)
			local seed = island.seed * 31 + i
			IslandTerrain.build(satTop, s.radius, s.radius * 2.6, seed)
			-- 의뢰 랜턴이 서는 위성 섬은 가운데를 비우므로 나무가 잎 폭만큼 밀려나 대개 빠진다
			local exclusions = if requestSatellites[i]
				then { { x = 0, z = 0, r = REQUEST_SPOT_RADIUS, sky = true } }
				else {}
			table.insert(decorate, function()
				Decor.scatterIsland(satTop, {
					seed = seed,
					radius = s.radius,
					treePalette = island.treePalette,
					trees = 1,
					flowers = 5,
					rocks = 1,
				}, exclusions, folder)
			end)
		end
	end
	if island.summit then
		local summitTop = Vector3.new(top.X, island.summit.height, top.Z)
		local radius = island.summit.radius
		IslandTerrain.build(summitTop, radius, radius * 3, island.seed * 7, { plazaRadius = 10 })
		table.insert(decorate, function()
			Features.Bell(summitTop, { x = 0, z = 0 }, folder)
			Decor.scatterIsland(summitTop, {
				seed = island.seed * 7,
				radius = radius,
				plazaRadius = 10,
				treePalette = island.treePalette,
				trees = 2,
				flowers = 10,
				rocks = 2,
			}, {}, folder)
		end)
	end
end

-- 멀리 보이는 풍경용 섬. 거리감과 아름다움이 목적이라 장치는 없다
local function buildDistant(root: Folder, decorate: { () -> () })
	local spec = World.DistantIslands
	local folder = folderIn(root, "Distant")
	local rng = WorldGen.rng(spec.seed)
	for i = 1, spec.count do
		local angle = (i / spec.count) * math.pi * 2 + rng:range(-0.15, 0.15)
		local dist = rng:range(spec.minDistance, spec.maxDistance)
		local radius = rng:range(spec.minRadius, spec.maxRadius)
		local top = Vector3.new(math.cos(angle) * dist, rng:range(spec.minY, spec.maxY), math.sin(angle) * dist)
		local seed = spec.seed * 100 + i
		IslandTerrain.build(top, radius, radius * rng:range(1.5, 2.3), seed, { hills = math.floor(radius / 30) })
		local palette = { 1 + math.floor(rng:next() * 10), 1 + math.floor(rng:next() * 10), 1, 3 }
		table.insert(decorate, function()
			Decor.scatterIsland(top, {
				seed = seed,
				radius = radius,
				treePalette = palette,
				trees = math.floor(radius / 9),
				flowers = math.floor(radius / 4),
				rocks = 2,
				treeScale = { 0.8, 1.4 },
			}, {}, folder)
		end)
		task.wait()
	end
end

local function buildSpawn(root: Folder)
	local hub = World.Islands[1]
	local top = vec(hub.center)
	local hit = Decor.groundAt(top.X, top.Y, top.Z + 22)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	spawn.Size = Vector3.new(10, 1, 10)
	local ground = if hit then hit.Position else top + Vector3.new(0, 0, 22)
	-- 처음 눈에 들어오는 것이 종탑 기둥이 아니라 1장 섬 쪽 하늘이 되게 동쪽을 본다
	spawn.CFrame = CFrame.lookAt(ground + Vector3.new(0, 0.5, 0), ground + Vector3.new(1, 0.5, -0.2))
	spawn.Parent = root
end

-- 지형 충돌이 반영될 때까지 허브 중심을 레이캐스트로 확인한다
local function waitForTerrain()
	local hub = vec(World.Islands[1].center)
	local started = os.clock()
	repeat
		task.wait()
	until Decor.groundAt(hub.X, hub.Y, hub.Z) or os.clock() - started > TERRAIN_SETTLE_TIMEOUT
end

function WorldBuilder.build()
	if not Decor.assets() then
		warn(
			"[WorldBuilder] ServerStorage.Assets가 없습니다. tools/ImportAssets.luau로 에셋을 다시 가져오세요"
		)
	end

	local existing = workspace:FindFirstChild("World")
	if existing then
		existing:Destroy()
	end
	workspace.Terrain:Clear()
	local root = Instance.new("Folder")
	root.Name = "World"
	root.Parent = workspace

	Sky.apply()

	local decorate = {}
	for _, island in World.Islands do
		buildIsland(island, root, decorate)
		task.wait()
	end
	buildDistant(root, decorate)
	waitForTerrain()

	for _, job in decorate do
		job()
		task.wait()
	end

	local stones = folderIn(root, "SteppingStones")
	for i, spec in World.SteppingStones do
		Decor.steppingStone(spec, i, stones)
	end
	Clouds.sea(World, root)
	Clouds.puffs(World, root)
	Decor.skyLife(World, folderIn(root, "SkyLife"))
	Residents.build(root)
	buildSpawn(root)
end

return WorldBuilder
]]></ProtectedString>
					<string name="ScriptGuid">{E35EA0F6-354A-47D1-84A9-0F28B80578B8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">WorldBuilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00002109</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX9D9DE97B40B4492C803D5C38F240B7D5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 의뢰를 주는 주민 NPC. 대화는 ProximityPrompt로 시작하고, 프롬프트의 Resident 속성으로 누구인지 알린다.
-- 외형은 기본 R15 몸에 색을 입히고 ResidentLooks의 소품을 붙인다. 서 있는 동안 기본 숨쉬기 동작을 튼다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Requests = require(ReplicatedStorage.Config.Requests)
local World = require(ReplicatedStorage.Config.World)
local Decor = require(script.Parent.Decor)
local ResidentLooks = require(script.Parent.ResidentLooks)

-- Roblox 기본 R15 대기 동작 중 숨쉬기 (507766666은 고개를 옆으로 크게 돌려 말 거는 사람을 안 보는 것처럼 보였다)
local IDLE_ANIMATION = "rbxassetid://507766951"

local Residents = {}

local function islandTop(id: string): Vector3?
	for _, island in World.Islands do
		if island.id == id then
			return Vector3.new(island.center[1], island.center[2], island.center[3])
		end
	end
	return nil
end

local function describe(color: { number }): HumanoidDescription
	local desc = Instance.new("HumanoidDescription")
	local tint = Color3.fromRGB(color[1], color[2], color[3])
	local skin = Color3.fromRGB(255, 220, 190)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = tint
	desc.LeftLegColor = tint:Lerp(Color3.new(0, 0, 0), 0.25)
	desc.RightLegColor = tint:Lerp(Color3.new(0, 0, 0), 0.25)
	return desc
end

local function build(resident, parent: Instance)
	local top = islandTop(resident.island)
	local hit = top and Decor.groundAt(top.X + resident.x, top.Y, top.Z + resident.z)
	if not hit then
		warn("[Residents] no ground for", resident.id)
		return
	end
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(describe(resident.color), Enum.HumanoidRigType.R15)
	end)
	if not ok then
		warn("[Residents] could not create", resident.id, model)
		return
	end
	model.Name = resident.id
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	humanoid.DisplayName = resident.id
	humanoid.NameDisplayDistance = 60
	root.Anchored = true
	local height = humanoid.HipHeight + root.Size.Y / 2
	model:PivotTo(CFrame.new(hit.Position + Vector3.new(0, height, 0)) * CFrame.Angles(0, math.rad(resident.yaw), 0))
	ResidentLooks.apply(model, resident.id, Color3.fromRGB(resident.color[1], resident.color[2], resident.color[3]))

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Talk" -- 클라이언트가 언어에 맞게 바꾼다
	prompt.ObjectText = resident.id
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("Resident", resident.id)
	prompt.Parent = root
	model.Parent = parent

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = IDLE_ANIMATION
	local ok2, track = pcall(animator.LoadAnimation, animator, animation)
	if ok2 then
		track.Looped = true
		track:Play(0)
		track:AdjustSpeed(0.85 + (#resident.id % 4) * 0.08) -- 주민끼리 박자가 맞지 않게
	end
end

function Residents.build(parent: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Residents"
	folder.Parent = parent
	for _, resident in Requests.Residents do
		build(resident, folder)
	end
end

return Residents
]]></ProtectedString>
					<string name="ScriptGuid">{71E9944E-C5DD-43E3-A781-670A40AB61B6}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Residents</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8ee</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3705BFA9B449473FA7A63363EBFDF04A">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 클라우드 러시 탑: TowerGen 배치를 파트로 세운다 (GDD 7.2, 8.1·8.2). 라운드가 끝나면 통째로 지운다.
-- 발판 색은 팔레트(GDD 8.2)를 따른다: 고정 하늘색, 구름 흰색, 바운스 노랑.
-- 고정 발판을 흰색으로 하면 아래 구름 바다와 섞여 위에서 안 보여서(2026-11-04 Studio 확인) 하늘색 두 톤 + 진한 테두리로 한다
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)
local TowerGen = require(ReplicatedStorage.Shared.TowerGen)
local Features = require(script.Parent.Features)

local TowerBuilder = {}

local COLOR = {
	SlabA = Color3.fromRGB(150, 205, 255),
	SlabB = Color3.fromRGB(118, 178, 245),
	Rim = Color3.fromRGB(60, 96, 170),
	Start = Color3.fromRGB(176, 214, 255),
	Summit = Color3.fromRGB(255, 236, 186),
	Pillar = Color3.fromRGB(226, 220, 208),
	Bell = Color3.fromRGB(255, 200, 70),
}
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local ENTRY_DIAMETER = 16

export type Info = { origin: Vector3, top: Vector3, bell: Vector3, height: number }

-- 둥근 고정 발판. 윗면이 top. 위에서 봐도 보이게 아래에 진한 테두리를 깐다
local function slab(top: Vector3, diameter: number, color: Color3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Name = "Slab"
	p.Shape = Enum.PartType.Cylinder
	p.Anchored = true
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = Vector3.new(2, diameter, diameter)
	p.CFrame = CFrame.new(top - Vector3.new(0, 1, 0)) * UPRIGHT
	p.Parent = parent
	local rim = Instance.new("Part")
	rim.Name = "Rim"
	rim.Shape = Enum.PartType.Cylinder
	rim.Anchored = true
	rim.CanCollide = false
	rim.CanQuery = false
	rim.CanTouch = false
	rim.Material = Enum.Material.SmoothPlastic
	rim.Color = COLOR.Rim
	rim.Size = Vector3.new(1.4, diameter + 1.2, diameter + 1.2)
	rim.CFrame = CFrame.new(top - Vector3.new(0, 1.9, 0)) * UPRIGHT
	rim.Parent = parent
	return p
end

local function summitBell(top: Vector3, parent: Instance): BasePart
	local pillar = Instance.new("Part")
	pillar.Name = "BellPillar"
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Anchored = true
	pillar.Material = Enum.Material.Limestone
	pillar.Color = COLOR.Pillar
	pillar.Size = Vector3.new(10, 4, 4)
	pillar.CFrame = CFrame.new(top + Vector3.new(0, 5, 0)) * UPRIGHT
	pillar.Parent = parent
	local bell = Instance.new("Part")
	bell.Name = "RushBell"
	bell.Shape = Enum.PartType.Ball
	bell.Anchored = true
	bell.CanCollide = false
	bell.Material = Enum.Material.Neon
	bell.Color = COLOR.Bell
	bell.Size = Vector3.new(8, 8, 8)
	bell.CFrame = CFrame.new(top + Vector3.new(0, 14, 0))
	bell.Parent = parent
	local light = Instance.new("PointLight")
	light.Color = COLOR.Bell
	light.Range = 40
	light.Brightness = 3
	light.Parent = bell
	-- 클라이언트 종 연출(딩 소리·팝업)은 허브 종과 같은 태그로 받는다. 우승 판정은 서버(RoundService)가 한다
	CollectionService:AddTag(bell, Tags.Bell)
	return bell
end

function TowerBuilder.build(layout: { TowerGen.Placed }, cfg): (Model, Info)
	local origin = Vector3.new(cfg.TowerOrigin[1], cfg.TowerOrigin[2], cfg.TowerOrigin[3])
	local model = Instance.new("Model")
	model.Name = "RushTower"
	slab(origin, cfg.StartRadius * 2, COLOR.Start, model)

	for i, placed in layout do
		local base = origin + Vector3.new(0, (i - 1) * cfg.ChunkHeight, 0)
		if i > 1 then
			slab(base, ENTRY_DIAMETER, COLOR.SlabA, model)
		end
		for n, p in placed.chunk.platforms do
			local kind = p[1]
			local x, z = TowerGen.rotate(p[2], p[4], placed.yaw)
			local at = base + Vector3.new(x, p[3], z)
			if kind == "slab" then
				slab(at, p[5], if n % 2 == 0 then COLOR.SlabA else COLOR.SlabB, model)
			elseif kind == "cloud" then
				Features.cloudPlatform(at - Vector3.new(0, 1.5, 0), p[5], model)
			elseif kind == "pad" then
				Features.padAt(at, model)
			elseif kind == "updraft" then
				Features.updraftAt(at, p[5], model)
			elseif kind == "puff" then
				Features.puffling(at, model)
			else
				warn("[TowerBuilder] unknown platform kind:", kind, placed.chunk.id)
			end
		end
	end

	local height = #layout * cfg.ChunkHeight
	local top = origin + Vector3.new(0, height, 0)
	slab(top, cfg.SummitRadius * 2, COLOR.Summit, model)
	local bell = summitBell(top, model)
	model.Parent = workspace
	return model, { origin = origin, top = top, bell = bell.Position, height = height }
end

return TowerBuilder
]]></ProtectedString>
					<string name="ScriptGuid">{157CF40E-3830-4010-B2B1-EC448A9FAE29}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">TowerBuilder</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000ce959</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX2BFAADE43CA14C2A8438BE8C546B02AB">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 주민 외형 소품 (GDD 6.6). 기본 R15 몸에 모자·얼굴·손에 든 물건을 붙여 누구인지 멀리서도 알아보게 한다.
-- 좌표는 붙일 신체 부위 기준이고 앞이 -Z다 (머리 크기 약 1.16)
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Tags = require(ReplicatedStorage.Shared.Tags)

local ResidentLooks = {}

local UP = CFrame.Angles(0, 0, math.rad(90)) -- 원기둥 축을 세운다
local FRONT = CFrame.Angles(0, math.rad(90), 0) -- 원기둥 축을 앞뒤로

local C = {
	Navy = Color3.fromRGB(46, 64, 122),
	NavyDark = Color3.fromRGB(30, 42, 84),
	Gold = Color3.fromRGB(255, 205, 80),
	Beak = Color3.fromRGB(255, 168, 60),
	Leather = Color3.fromRGB(140, 92, 54),
	LeatherDark = Color3.fromRGB(104, 66, 38),
	Paper = Color3.fromRGB(250, 248, 240),
	White = Color3.fromRGB(252, 252, 250),
	Grey = Color3.fromRGB(196, 196, 204),
	Pink = Color3.fromRGB(255, 150, 176),
	Frame = Color3.fromRGB(84, 54, 36),
	Wood = Color3.fromRGB(196, 146, 92),
	WoodDark = Color3.fromRGB(130, 88, 52),
	Rain = Color3.fromRGB(250, 204, 60),
	Auburn = Color3.fromRGB(150, 74, 46),
	Scarf = Color3.fromRGB(216, 64, 64),
	Lamp = Color3.fromRGB(255, 214, 120),
	Iron = Color3.fromRGB(60, 60, 70),
	Straw = Color3.fromRGB(232, 202, 122),
	Band = Color3.fromRGB(190, 60, 50),
	Beard = Color3.fromRGB(150, 100, 62),
	BeardDark = Color3.fromRGB(110, 70, 42),
	Sack = Color3.fromRGB(238, 230, 210),
	Rope = Color3.fromRGB(176, 140, 90),
	Strap = Color3.fromRGB(70, 52, 40),
	Lens = Color3.fromRGB(110, 220, 210),
	Brass = Color3.fromRGB(214, 170, 80),
	Hair = Color3.fromRGB(92, 60, 40),
	Orange = Color3.fromRGB(255, 140, 50),
	KiteA = Color3.fromRGB(255, 96, 110),
	KiteB = Color3.fromRGB(255, 226, 90),
	KiteC = Color3.fromRGB(90, 170, 255),
}

-- 신체 부위에 용접한 소품 하나. 충돌·판정은 없고 질량도 없다
local function piece(model: Model, baseName: string, props: { [string]: any }, offset: CFrame): BasePart?
	local base = model:FindFirstChild(baseName)
	if not (base and base:IsA("BasePart")) then
		return nil
	end
	local p = Instance.new("Part")
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(p :: any)[key] = value
	end
	p.CFrame = base.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

local function ball(size: Vector3, color: Color3, extra: { [string]: any }?): { [string]: any }
	local props: { [string]: any } = { Shape = Enum.PartType.Ball, Size = size, Color = color }
	for key, value in extra or {} do
		props[key] = value
	end
	return props
end

local function cylinder(length: number, diameter: number, color: Color3, extra: { [string]: any }?): { [string]: any }
	local props: { [string]: any } =
		{ Shape = Enum.PartType.Cylinder, Size = Vector3.new(length, diameter, diameter), Color = color }
	for key, value in extra or {} do
		props[key] = value
	end
	return props
end

local function block(size: Vector3, color: Color3, extra: { [string]: any }?): { [string]: any }
	local props: { [string]: any } = { Size = size, Color = color }
	for key, value in extra or {} do
		props[key] = value
	end
	return props
end

local LOOKS = {}

-- 우체부 새: 남색 우편 모자, 부리, 깃털 날개, 어깨에 멘 우편 가방
function LOOKS.Pip(model: Model, tint: Color3)
	piece(model, "Head", cylinder(0.42, 1.3, C.Navy), CFrame.new(0, 0.6, 0.02) * UP)
	piece(
		model,
		"Head",
		block(Vector3.new(1.05, 0.08, 0.5), C.NavyDark),
		CFrame.new(0, 0.42, -0.72) * CFrame.Angles(math.rad(-12), 0, 0)
	)
	piece(model, "Head", ball(Vector3.new(0.24, 0.24, 0.1), C.Gold), CFrame.new(0, 0.62, -0.65))
	piece(
		model,
		"Head",
		ball(Vector3.new(0.34, 0.24, 0.62), C.Beak),
		CFrame.new(0, -0.1, -0.7) * CFrame.Angles(math.rad(-8), 0, 0)
	)
	for _, side in { -1, 1 } do
		local arm = if side < 0 then "LeftUpperArm" else "RightUpperArm"
		piece(
			model,
			arm,
			block(Vector3.new(0.14, 1.2, 0.95), tint:Lerp(C.White, 0.25)),
			CFrame.new(side * 0.56, -0.1, 0.1) * CFrame.Angles(0, 0, math.rad(side * -6))
		)
	end
	for _, z in { -0.53, 0.53 } do
		piece(
			model,
			"UpperTorso",
			block(Vector3.new(0.24, 2.3, 0.06), C.Leather),
			CFrame.new(0.1, -0.1, z) * CFrame.Angles(0, 0, math.rad(38))
		)
	end
	piece(model, "LowerTorso", block(Vector3.new(0.5, 0.95, 1.05), C.Leather), CFrame.new(1.2, 0.05, 0))
	piece(model, "LowerTorso", block(Vector3.new(0.54, 0.36, 1.08), C.LeatherDark), CFrame.new(1.2, 0.4, 0))
	piece(
		model,
		"LowerTorso",
		block(Vector3.new(0.06, 0.5, 0.72), C.Paper),
		CFrame.new(1.2, 0.72, 0.05) * CFrame.Angles(0, 0, math.rad(-8))
	)
end

-- 빵집 할머니: 요리사 모자, 회색 머리, 동그란 안경, 앞치마, 밀대
function LOOKS.Momo(model: Model, _tint: Color3)
	piece(model, "Head", cylinder(0.7, 1.2, C.White), CFrame.new(0, 0.78, 0) * UP)
	piece(model, "Head", ball(Vector3.new(1.65, 1.0, 1.65), C.White), CFrame.new(0, 1.3, 0))
	for _, side in { -1, 1 } do
		piece(model, "Head", ball(Vector3.new(0.34, 0.62, 0.55), C.Grey), CFrame.new(side * 0.58, 0.05, 0.12))
		-- 안경테: 투명한 알은 흰 얼굴에 묻혀 안 보였다
		local lens = CFrame.new(side * 0.22, 0.15, -0.6)
		for _, y in { -0.16, 0.16 } do
			piece(model, "Head", block(Vector3.new(0.38, 0.05, 0.04), C.Frame), lens * CFrame.new(0, y, 0))
		end
		for _, x in { -0.17, 0.17 } do
			piece(model, "Head", block(Vector3.new(0.05, 0.32, 0.04), C.Frame), lens * CFrame.new(x, 0, 0))
		end
	end
	piece(model, "Head", block(Vector3.new(0.1, 0.05, 0.04), C.Frame), CFrame.new(0, 0.17, -0.6))
	piece(model, "Head", ball(Vector3.new(0.62, 0.62, 0.62), C.Grey), CFrame.new(0, 0.28, 0.62))
	piece(model, "UpperTorso", block(Vector3.new(1.45, 1.25, 0.06), C.White), CFrame.new(0, -0.18, -0.53))
	piece(model, "UpperTorso", block(Vector3.new(0.5, 0.36, 0.07), C.Pink), CFrame.new(0, -0.5, -0.56))
	piece(model, "LowerTorso", block(Vector3.new(1.75, 1.5, 0.06), C.White), CFrame.new(0, -0.65, -0.55))
	piece(model, "RightHand", cylinder(1.8, 0.34, C.Wood), CFrame.new(0, -0.15, -0.2) * FRONT)
	for _, z in { -1.2, 0.8 } do
		piece(model, "RightHand", cylinder(0.35, 0.18, C.WoodDark), CFrame.new(0, -0.15, z) * FRONT)
	end
end

-- 등대지기: 노란 비옷 모자, 땋은 머리, 목도리, 불 켜진 랜턴
function LOOKS.Rhea(model: Model, _tint: Color3)
	piece(model, "Head", cylinder(0.1, 1.95, C.Rain), CFrame.new(0, 0.38, 0.12) * UP)
	piece(model, "Head", ball(Vector3.new(1.32, 0.85, 1.32), C.Rain), CFrame.new(0, 0.62, 0.04))
	for i, y in { -0.2, -0.58, -0.95 } do
		piece(model, "Head", ball(Vector3.one * (0.42 - i * 0.04), C.Auburn), CFrame.new(0, y, 0.64 + i * 0.04))
	end
	piece(model, "UpperTorso", cylinder(0.32, 1.3, C.Scarf), CFrame.new(0, 0.82, 0) * UP)
	piece(
		model,
		"UpperTorso",
		block(Vector3.new(0.36, 0.95, 0.08), C.Scarf),
		CFrame.new(-0.42, 0.2, -0.56) * CFrame.Angles(0, 0, math.rad(8))
	)
	piece(model, "LeftHand", block(Vector3.new(0.08, 0.4, 0.08), C.Iron), CFrame.new(0, -0.3, 0))
	piece(model, "LeftHand", block(Vector3.new(0.62, 0.12, 0.62), C.Iron), CFrame.new(0, -0.5, 0))
	piece(model, "LeftHand", block(Vector3.new(0.62, 0.12, 0.62), C.Iron), CFrame.new(0, -1.15, 0))
	local glow = piece(
		model,
		"LeftHand",
		cylinder(0.5, 0.5, C.Lamp, { Material = Enum.Material.Neon }),
		CFrame.new(0, -0.82, 0) * UP
	)
	if glow then
		local light = Instance.new("PointLight")
		light.Color = C.Lamp
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = glow
	end
end

-- 풍차지기: 밀짚모자, 수염, 등에 진 밀가루 자루, 멜빵
function LOOKS.Bram(model: Model, _tint: Color3)
	-- Fabric 재질은 밀짚색을 칙칙한 갈색으로 만들어서 매끈한 재질을 쓴다
	piece(model, "Head", cylinder(0.1, 2.35, C.Straw), CFrame.new(0, 0.46, 0) * UP)
	piece(model, "Head", cylinder(0.55, 1.25, C.Straw), CFrame.new(0, 0.74, 0) * UP)
	piece(model, "Head", cylinder(0.16, 1.28, C.Band), CFrame.new(0, 0.58, 0) * UP)
	-- 턱수염은 얼굴 아래쪽을 덮는다 (턱 밑에 두면 목에 단 항아리처럼 보였다)
	piece(model, "Head", ball(Vector3.new(1.08, 0.62, 0.4), C.Beard), CFrame.new(0, -0.36, -0.46))
	piece(model, "Head", ball(Vector3.new(0.78, 0.2, 0.24), C.BeardDark), CFrame.new(0, -0.1, -0.62))
	piece(
		model,
		"UpperTorso",
		ball(Vector3.new(1.4, 1.75, 0.95), C.Sack, { Material = Enum.Material.Fabric }),
		CFrame.new(0, 0.05, 0.95)
	)
	piece(model, "UpperTorso", cylinder(0.2, 0.5, C.Rope), CFrame.new(0, 0.95, 0.95) * UP)
	for _, x in { -0.5, 0.5 } do
		piece(model, "UpperTorso", block(Vector3.new(0.18, 1.72, 0.06), C.Strap), CFrame.new(x, 0, -0.53))
	end
end

-- 연 만드는 아이: 머리에 올린 비행 고글, 휘날리는 목도리, 머리 위에 띄운 연 (실은 Beam이라 연이 흔들려도 따라간다)
function LOOKS.Wren(model: Model, _tint: Color3)
	piece(model, "Head", ball(Vector3.new(1.25, 0.55, 1.25), C.Hair), CFrame.new(0, 0.5, 0.06))
	piece(model, "Head", cylinder(0.2, 1.24, C.Strap), CFrame.new(0, 0.3, 0) * UP)
	for _, side in { -1, 1 } do
		piece(model, "Head", cylinder(0.12, 0.5, C.Brass), CFrame.new(side * 0.25, 0.36, -0.6) * FRONT)
		piece(
			model,
			"Head",
			cylinder(0.14, 0.38, C.Lens, { Material = Enum.Material.Glass, Transparency = 0.15 }),
			CFrame.new(side * 0.25, 0.36, -0.64) * FRONT
		)
	end
	piece(model, "UpperTorso", cylinder(0.3, 1.3, C.Orange), CFrame.new(0, 0.82, 0) * UP)
	piece(
		model,
		"UpperTorso",
		block(Vector3.new(0.34, 0.08, 1.7), C.Orange),
		CFrame.new(0.32, 0.7, 1.25) * CFrame.Angles(math.rad(14), math.rad(12), 0)
	)

	local hand = model:FindFirstChild("RightHand")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not (hand and hand:IsA("BasePart") and root and root:IsA("BasePart")) then
		return
	end
	-- 연은 따로 떠 있는 모델이다 (클라이언트 Ambience가 Drift 태그로 천천히 흔든다)
	local kite = Instance.new("Model")
	kite.Name = "WrenKite"
	local at = root.CFrame * CFrame.new(2.5, 9, 3) * CFrame.Angles(math.rad(-25), 0, 0)
	local function kitePart(props: { [string]: any }, offset: CFrame): Part
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.SmoothPlastic
		for key, value in props do
			(p :: any)[key] = value
		end
		p.CFrame = at * offset
		p.Parent = kite
		return p
	end
	local sail = kitePart(block(Vector3.new(2.6, 2.6, 0.08), C.KiteA), CFrame.Angles(0, 0, math.rad(45)))
	kitePart(block(Vector3.new(1.5, 1.5, 0.1), C.KiteB), CFrame.Angles(0, 0, math.rad(45)))
	kitePart(block(Vector3.new(0.08, 3.6, 0.14), C.WoodDark), CFrame.identity)
	kitePart(block(Vector3.new(3.6, 0.08, 0.14), C.WoodDark), CFrame.identity)
	for i = 1, 4 do
		kitePart(
			block(Vector3.new(0.5, 0.3, 0.06), if i % 2 == 0 then C.KiteC else C.KiteB),
			CFrame.new(0, -1.9 - i * 0.65, 0.1) * CFrame.Angles(0, 0, math.rad(if i % 2 == 0 then 20 else -20))
		)
	end
	-- PrimaryPart 대신 기준점을 직접 둔다. 클라이언트가 부품을 받기 전에 기준점을 읽으면 원점(0,0,0)으로 끌려갔다
	kite.WorldPivot = sail.CFrame
	kite:SetAttribute("DriftPhase", 1.3)

	local from = Instance.new("Attachment")
	from.Name = "KiteString"
	from.Parent = hand
	local to = Instance.new("Attachment")
	to.Name = "KiteString"
	to.Position = Vector3.new(0, -0.2, 0.06)
	to.Parent = sail
	local line = Instance.new("Beam")
	line.Attachment0 = from
	line.Attachment1 = to
	line.Width0 = 0.05
	line.Width1 = 0.05
	line.Color = ColorSequence.new(C.Paper)
	line.FaceCamera = true
	line.CurveSize0 = -1.5
	line.Segments = 8
	line.Parent = sail

	kite.Parent = model
	CollectionService:AddTag(kite, Tags.Drift)
end

function ResidentLooks.apply(model: Model, id: string, tint: Color3)
	local look = LOOKS[id]
	if look then
		look(model, tint)
	end
end

return ResidentLooks
]]></ProtectedString>
