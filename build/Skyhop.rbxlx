			gold = 30,
			silver = 42,
			minTime = 12,
		},
		{
			id = "c1_boss",
			chapter = 1,
			boss = true,
			name = "Boss_Thunderhead",
			island = "WindmillMeadow",
			type = "Boss",
			-- 썬더헤드 (GDD 6.3): 정상(월드 470) 위 먹구름. 구름 발판 7개를 감아 올라 꼭대기 피뢰침 3개를 스톰프한다.
			-- 오르는 동안 번개가 떨어질 자리가 먼저 빛난다. 좌표는 섬 윗면(월드 24) 기준, 정상 윗면은 air 446
			gate = { air = { 20, 446, -8 } }, -- 정상의 폭풍 받침대 (도전 프롬프트)
			center = { air = { 0, 592, 0 } }, -- 먹구름 몸통 중심
			points = { -- 반경 48 나선, 28씩 오른다
				{ air = { 48, 476, 0 } },
				{ air = { 27.5, 504, 39.3 } },
				{ air = { -16.4, 532, 45.1 } },
				{ air = { -46.4, 560, 12.4 } },
				{ air = { -36.8, 588, -30.9 } },
				{ air = { 4.2, 616, -47.8 } },
				{ air = { 41.6, 644, -24 } },
			},
			rods = { -- 몸통 위 피뢰침 발판
				{ air = { 20, 672, 10 } },
				{ air = { -14, 690, 18 } },
				{ air = { -6, 708, -20 } },
			},
			fallBelow = 420, -- 발이 이 air 높이보다 내려가면 실패 (정상 아래로 떨어짐)
			gold = 45,
			silver = 75,
			minTime = 15,
		},
	},
}
]]></ProtectedString>
					<string name="ScriptGuid">{F211B185-B79A-46EC-BDAC-C35C14FA9B16}</string>
