	},
	Birds = { id = 9116969794, volume = 0.22 }, -- "Morning Birds 5": 섬 위 새소리

	MusicFadeSeconds = 2,
	BirdsFadeHeight = 150, -- 섬 윗면에서 이만큼 오르면 새소리가 사라진다
	BirdsRangeScale = 1.3, -- 섬 반경의 이 배수 안에서만 새소리가 들린다
}
]]></ProtectedString>
