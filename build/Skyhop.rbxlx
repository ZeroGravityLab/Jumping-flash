					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">DataService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8e8</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXBF7217C120AF445B94208CF3B76C7E1D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 코인 증감은 여기서만 한다 (CLAUDE.md)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DataService = require(script.Parent.DataService)

local EconomyService = {}

local STUDIO_GRANT_ATTRIBUTE = "StudioGrantCoins"

function EconomyService.addCoins(player: Player, amount: number)
	if amount <= 0 then
		return
	end
	DataService.update(player, function(profile)
		profile.coins += amount
	end)
end

-- 코인이 충분할 때만 빼고 true. 확인과 차감 사이에 양보(yield)가 없어 두 번 빠지지 않는다
function EconomyService.spend(player: Player, amount: number): boolean
	local profile = DataService.get(player)
	if not profile or amount <= 0 or profile.coins < amount then
		return false
	end
	DataService.update(player, function(p)
		p.coins -= amount
	end)
	return true
end

-- Studio 테스트 전용: 서버 쪽 MCP Luau가 플레이어에 StudioGrantCoins 속성(숫자)을 쓰면 그만큼 코인을 준다.
-- 클라이언트가 쓴 속성은 서버로 복제되지 않고, 게시된 게임에서는 연결하지 않는다
function EconomyService.start()
	if not RunService:IsStudio() then
		return
	end
	local function watch(player: Player)
		player:GetAttributeChangedSignal(STUDIO_GRANT_ATTRIBUTE):Connect(function()
			local amount = player:GetAttribute(STUDIO_GRANT_ATTRIBUTE)
			if type(amount) == "number" and amount > 0 then
				player:SetAttribute(STUDIO_GRANT_ATTRIBUTE, nil)
				EconomyService.addCoins(player, math.floor(amount))
			end
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return EconomyService
]]></ProtectedString>
					<string name="ScriptGuid">{030DC145-67C2-4A56-B57E-1D89AD3BC97B}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">EconomyService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8ea</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX1DCE354DBD804562BF299F0568FD2B41">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 의뢰 시작·완료 검증과 보상. 시간은 서버 시계로만 잰다 (클라이언트가 보낸 시간은 받지 않는다)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Requests = require(ReplicatedStorage.Config.Requests)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RequestLogic = require(ReplicatedStorage.Shared.RequestLogic)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Net = require(script.Parent.Net)

local RequestService = {}

local CALL_INTERVAL = 0.5

local sessions: { [Player]: { id: string, startedAt: number } } = {}

local function start(player: Player, requestId: any): boolean
	if type(requestId) ~= "string" then
		return false
	end
	local request = RequestLogic.find(Requests, requestId)
	local profile = DataService.get(player)
	if not (request and profile and RequestLogic.isAvailable(request, profile.requests, Requests)) then
		return false
	end
	sessions[player] = { id = requestId, startedAt = os.clock() }
	return true
end

local function complete(player: Player, requestId: any)
	local session = sessions[player]
	if not session or session.id ~= requestId then
		return nil
	end
	sessions[player] = nil
	local request = RequestLogic.find(Requests, requestId)
	local profile = DataService.get(player)
	if not (request and profile) then
		return nil
	end
	local elapsed = os.clock() - session.startedAt
	if not RequestLogic.isPlausible(request, elapsed) then
		warn(
			string.format(
				"[RequestService] %s의 %s 보고가 너무 빠릅니다 (%.1fs)",
				player.Name,
				requestId,
				elapsed
			)
		)
		return nil
	end

	local medal = RequestLogic.medalFor(request, elapsed)
	local previous = profile.requests[requestId]
	local coins = RequestLogic.coinsFor(Requests, medal, previous and previous.medal)
	DataService.update(player, function(p)
		local record = p.requests[requestId]
		if not record then
			p.requests[requestId] = { medal = medal, bestTime = elapsed }
		else
			if RequestLogic.isBetter(medal, record.medal) then
				record.medal = medal
			end
			record.bestTime = math.min(record.bestTime, elapsed)
		end
	end)
	EconomyService.addCoins(player, coins)

	local bell, bellNeeded = RequestLogic.bellGauge(Requests, request.chapter, profile.requests)
	return {
		medal = medal,
		time = elapsed,
		coins = coins,
		isNew = previous == nil,
		chapter = request.chapter,
		bell = bell,
		bellNeeded = bellNeeded,
	}
end

function RequestService.start()
	Net.handleFunction(Remotes.RequestStart, CALL_INTERVAL, start)
	Net.handleFunction(Remotes.RequestComplete, CALL_INTERVAL, complete)
	Net.handleEvent(Remotes.RequestCancel, CALL_INTERVAL, function(player)
		sessions[player] = nil
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
		Net.forget(player)
	end)
end

return RequestService
]]></ProtectedString>
					<string name="ScriptGuid">{E5EB78FD-AC79-4628-946E-47AC9BE5DF6A}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RequestService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8ec</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX8E2B38EA1AF84870AA798FFECF4D68D5">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 클라우드 러시 라운드 (GDD 7.2): 허브 대기 → 탑으로 이동 → 카운트다운 → 해일 → 종·탈락 → 결과·보상.
-- 탈락·종·최고 높이·순위는 모두 서버가 위치를 보고 정한다. 진행 상태는 ReplicatedStorage.RushState 속성으로 알린다
--   Phase: "Lobby" | "Countdown" | "Running" | "Results", PhaseEndsAt·StartedAt: 서버 시간(GetServerTimeNow)
--   TowerBaseY·TowerTopY, Alive(남은 사람 수), Total(참가자 수), Rang(종을 울린 사람 수)
-- 플레이어 속성: RushJoined(다음 판 참가 신청), RushRunning(지금 탑 위에 있음)
-- 라이벌 밟기: 밟은 클라이언트의 보고를 서버가 위치·무적 시간으로 확인한 뒤 밟힌 클라이언트에 휘청을 보낸다.
-- MovementGuard (GDD 14.2): 참가자의 높이를 ServerTick마다 GuardLogic으로 보고, 걸리면 마지막 정상 위치로 되돌린다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Chunks = require(ReplicatedStorage.Config.Chunks)
local GuardLogic = require(ReplicatedStorage.Shared.GuardLogic)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Rush = require(ReplicatedStorage.Config.Rush)
local RushLogic = require(ReplicatedStorage.Shared.RushLogic)
local TowerGen = require(ReplicatedStorage.Shared.TowerGen)
local EconomyService = require(script.Parent.EconomyService)
local Net = require(script.Parent.Net)
local TowerBuilder = require(script.Parent.Parent.World.TowerBuilder)

local RoundService = {}

local JOIN_INTERVAL = 0.3
local STOMP_INTERVAL = 0.3
local FEET_OFFSET = 3 -- 루트 파트 중심에서 발까지 (R15 기본 체형 기준 근삿값)

type Runner = {
	maxHeight: number,
	rangAt: number?,
	out: boolean,
	guard: GuardLogic.State?,
	lastValid: CFrame?,
	flags: number,
}

local state: Folder
local resultRemote: RemoteEvent
local stompedRemote: RemoteEvent
local joined: { [Player]: boolean } = {}
local current: { [Player]: Runner }? = nil -- 지금 라운드의 참가자 (진행 중일 때만)
local immuneUntil: { [Player]: number } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function setPhase(phase: string, seconds: number)
	state:SetAttribute("Phase", phase)
	state:SetAttribute("PhaseEndsAt", now() + seconds)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function sendHome(player: Player)
	local character = player.Character
	local spawn = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Spawn")
	if character and spawn then
		character:PivotTo(spawn.CFrame + Vector3.new(0, 5, 0))
	end
end

local function runRound(entrants: { Player })
	local seed = Random.new():NextInteger(1, 2147483646)
	local layout = TowerGen.generate(seed, Chunks, Rush)
	local tower, info = TowerBuilder.build(layout, Rush)
	state:SetAttribute("TowerBaseY", info.origin.Y)
	state:SetAttribute("TowerTopY", info.top.Y)
	state:SetAttribute("Total", #entrants)
	state:SetAttribute("Rang", 0)

	local runners: { [Player]: Runner } = {}
	for i, player in entrants do
		-- 출발 발판 위에 둥글게 세우고 탑 가운데를 보게 한다
		local angle = i / #entrants * math.pi * 2
		local spot = info.origin + Vector3.new(math.cos(angle) * 14, 5, math.sin(angle) * 14)
		local character = player.Character
		if character then
			character:PivotTo(CFrame.lookAt(spot, Vector3.new(info.origin.X, spot.Y, info.origin.Z)))
		end
		runners[player] = { maxHeight = 0, out = false, flags = 0 }
		player:SetAttribute("RushRunning", true)
	end
	state:SetAttribute("Alive", #entrants)
	table.clear(immuneUntil)

	setPhase("Countdown", Rush.CountdownSeconds)
	task.wait(Rush.CountdownSeconds)
	local startedAt = now()
	state:SetAttribute("StartedAt", startedAt)
	setPhase("Running", Rush.MaxRoundSeconds)
	current = runners

	local firstRingAt: number? = nil
	local rang = 0
	local lastTick = now()
	while true do
		task.wait(Rush.ServerTick)
		local tickAt = now()
		local dt = tickAt - lastTick
		lastTick = tickAt
		local elapsed = tickAt - startedAt
		local tideY = info.origin.Y + RushLogic.tideHeight(Rush, elapsed)
		local alive = 0
		for player, run in runners do
			if run.out then
				continue
			end
			local root = player.Parent == Players and rootOf(player)
			if not root then
				run.out = true
				player:SetAttribute("RushRunning", false)
				continue
			end

			-- MovementGuard: 이상한 상승이면 마지막 정상 위치로 되돌리고 이번에는 높이·종을 보지 않는다
			if not run.guard then
				run.guard = GuardLogic.new(Rush, root.Position.Y)
			end
			local guard = run.guard :: GuardLogic.State
			local ok, reason = GuardLogic.step(Rush, guard, root.Position.Y, dt)
			if not ok then
				run.flags += 1
				warn(
					string.format(
						"[MovementGuard] %s: %s at %.0f (flag %d)",
						player.Name,
						tostring(reason),
						root.Position.Y,
						run.flags
					)
				)
				if run.lastValid and player.Character then
					player.Character:PivotTo(run.lastValid)
					GuardLogic.reset(guard, run.lastValid.Position.Y)
				end
				alive += 1
				continue
			end
			run.lastValid = root.CFrame

			local feetY = root.Position.Y - FEET_OFFSET
			run.maxHeight = math.max(run.maxHeight, feetY - info.origin.Y)
			if not run.rangAt and (root.Position - info.bell).Magnitude <= Rush.BellRadius then
				run.rangAt = elapsed
				firstRingAt = firstRingAt or elapsed
				rang += 1
				state:SetAttribute("Rang", rang)
			end
			if feetY < tideY - Rush.TideGrace then
				-- 해일에 잠겼다: 탈락하고 허브로 (GDD의 돌풍 관전은 v1.0)
				run.out = true
				player:SetAttribute("RushRunning", false)
				sendHome(player)
			else
				alive += 1
			end
		end
		state:SetAttribute("Alive", alive)
		if alive == 0 then
			break
		elseif firstRingAt and elapsed - firstRingAt >= Rush.EndGraceSeconds then
			break
		elseif elapsed >= Rush.MaxRoundSeconds or tideY >= info.top.Y then
			break
		end
	end
	current = nil

	local entries = {}
	for player, run in runners do
		table.insert(entries, { id = player, maxHeight = run.maxHeight, rangAt = run.rangAt })
	end
	local ranked = RushLogic.rank(entries)
	for rank, entry in ranked do
		local player = entry.id :: Player
		if player.Parent == Players then
			local meters = math.max(0, math.floor(entry.maxHeight))
			local rangBell = entry.rangAt ~= nil
			local coins = RushLogic.coins(Rush, meters, rank, #ranked, rangBell)
			EconomyService.addCoins(player, coins)
			resultRemote:FireClient(player, {
				rank = rank,
				total = #ranked,
				height = meters,
				coins = coins,
				rang = rangBell,
			})
		end
	end

	setPhase("Results", Rush.ResultsSeconds)
	task.wait(Rush.ResultsSeconds)
	for player, run in runners do
		if player.Parent == Players then
			player:SetAttribute("RushRunning", false)
			if not run.out then
				sendHome(player)
			end
		end
	end
	tower:Destroy()
end

local function loop()
	while true do
		setPhase("Lobby", Rush.LobbySeconds)
		task.wait(Rush.LobbySeconds)
		local entrants = {}
		for player in joined do
			if player.Parent == Players and rootOf(player) then
				table.insert(entrants, player)
			end
			player:SetAttribute("RushJoined", false)
		end
		-- 참가는 한 판씩 받는다 (의뢰 중에 다음 판으로 끌려가지 않게)
		table.clear(joined)
		if #entrants > 0 then
			local ok, err = pcall(runRound, entrants)
			current = nil
			if not ok then
				warn("[RoundService] round failed:", err)
				local leftover = workspace:FindFirstChild("RushTower")
				if leftover then
					leftover:Destroy()
				end
				for _, player in entrants do
					if player.Parent == Players then
						player:SetAttribute("RushRunning", false)
					end
				end
			end
		end
	end
end

function RoundService.start()
	state = Instance.new("Folder")
	state.Name = "RushState"
	state.Parent = ReplicatedStorage
	resultRemote = Net.event(Remotes.RushResult)
	Net.handleEvent(Remotes.RushJoin, JOIN_INTERVAL, function(player, wants)
		if type(wants) ~= "boolean" then
			return
		end
		joined[player] = if wants then true else nil
		player:SetAttribute("RushJoined", wants)
	end)

	-- 라이벌 밟기: 둘 다 아직 탑 위에 있고, 위치가 맞고, 밟힌 쪽이 무적이 아닐 때만
	stompedRemote = Net.event(Remotes.RushStomped)
	Net.handleEvent(Remotes.RushStomp, STOMP_INTERVAL, function(player, victim)
		if typeof(victim) ~= "Instance" or not victim:IsA("Player") or victim == player then
			return
		end
		local runners = current
		local attacker, target = runners and runners[player], runners and runners[victim :: Player]
		if not (attacker and target) or attacker.out or target.out then
			return
		end
		local from, to = rootOf(player), rootOf(victim :: Player)
		if not (from and to) then
			return
		end
		local d = from.Position - to.Position
		local at = now()
		if not RushLogic.canStomp(Rush, d.Y, Vector3.new(d.X, 0, d.Z).Magnitude, at, immuneUntil[victim :: Player]) then
			return
		end
		immuneUntil[victim :: Player] = at + Rush.StompImmunity
		stompedRemote:FireClient(victim :: Player, Rush.StompWobble, Rush.StompJumpsLost)
	end)

	Players.PlayerRemoving:Connect(function(player)
		joined[player] = nil
		immuneUntil[player] = nil
	end)
	task.spawn(loop)
end

return RoundService
]]></ProtectedString>
					<string name="ScriptGuid">{01EB77AC-8B54-480F-8B3B-FDC766AF6A12}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">RoundService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000ce95b</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX23ECE65CD6F7418CA8763EEA1D74EB7D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 코인 상점 구매·장착 검증 (GDD 9.4~9.5). 클라이언트는 "이걸 사고 싶다"만 보내고 판단은 여기서 한다.
-- 코인은 EconomyService만, 프로필은 DataService만 바꾼다. 입은 모습은 CosmeticService가 ShopEquipped 속성을 보고 갱신한다
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shop = require(ReplicatedStorage.Config.Shop)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ShopLogic = require(ReplicatedStorage.Shared.ShopLogic)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Net = require(script.Parent.Net)

local ShopService = {}

local CALL_INTERVAL = 0.3

local function buy(player: Player, itemId: any): (boolean, string?)
	local profile = DataService.get(player)
	if not profile then
		return false, "ShopUnknown"
	end
	local item = ShopLogic.find(Shop, itemId)
	local ok, reason = ShopLogic.canBuy(item, profile.coins, profile.owned)
	if not ok then
		return false, reason
	end
	if not EconomyService.spend(player, item.price) then
		return false, "ShopNoCoins"
	end
	DataService.update(player, function(p)
		p.owned[item.id] = true
		p.equipped[item.category] = item.id
	end)
	return true, nil
end

local function equip(player: Player, category: any, itemId: any): boolean
	local profile = DataService.get(player)
	if not (profile and ShopLogic.canEquip(Shop, category, itemId, profile.owned)) then
		return false
	end
	DataService.update(player, function(p)
		p.equipped[category] = itemId
	end)
	return true
end

function ShopService.start()
	Net.handleFunction(Remotes.ShopBuy, CALL_INTERVAL, buy)
	Net.handleFunction(Remotes.ShopEquip, CALL_INTERVAL, equip)
end

return ShopService
]]></ProtectedString>
					<string name="ScriptGuid">{1093EE17-4E7F-4D56-B47B-51E8E1CD304E}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">ShopService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00148fef</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3E82768E95BB4DC5B7F680F5993EA395">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 장착한 상점 외형(궤적·부츠)을 캐릭터에 입힌다 (GDD 9.4). 서버가 붙이므로 모든 플레이어에게 보인다.
-- 충돌·판정·질량이 없어서 이동과 착지에 영향을 주지 않는다
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shop = require(ReplicatedStorage.Config.Shop)
local ShopLogic = require(ReplicatedStorage.Shared.ShopLogic)
local DataService = require(script.Parent.DataService)

local CosmeticService = {}

local FOLDER = "Cosmetics"
local TRAIL_TAG = "CosmeticTrail"
local TRAIL_HALF_WIDTH = 1
local TRAIL_LIFETIME = 0.7
local APPEARANCE_TIMEOUT = 10

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function clear(character: Model)
	local folder = character:FindFirstChild(FOLDER)
	if folder then
		folder:Destroy()
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		for _, child in root:GetChildren() do
			if child.Name == TRAIL_TAG then
				child:Destroy()
			end
		end
	end
end

-- 몸 양옆 두 점 사이의 띠가 카메라를 향한 채 꼬리로 남는다 (수직으로 뛰어도 폭이 보인다)
local function addTrail(character: Model, item)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = TRAIL_TAG
	a0.Position = Vector3.new(-TRAIL_HALF_WIDTH, -0.4, 0.3)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = TRAIL_TAG
	a1.Position = Vector3.new(TRAIL_HALF_WIDTH, -0.4, 0.3)
	a1.Parent = root
	local keys = {}
	for i, c in item.colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#item.colors - 1), rgb(c)))
	end
	local trail = Instance.new("Trail")
	trail.Name = TRAIL_TAG
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(keys)
	trail.Lifetime = TRAIL_LIFETIME
	trail.MinLength = 0.15
	trail.FaceCamera = true
	trail.LightEmission = 0.5
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.35) })
	trail.Parent = root
end

local function bootPiece(
	folder: Folder,
	foot: BasePart,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	glow: boolean?,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = "Boot"
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.Color = color
	p.Material = if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.CFrame = foot.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = foot
	weld.Part1 = p
	weld.Parent = p
	p.Parent = folder
	return p
end

-- 발을 감싸는 몸통, 둥근 앞코, 조금 더 넓은 밑창, 몸통 가운데를 두르는 띠.
-- 띠를 몸통 위에 얹으면 윗면을 다 덮어 빛나는 상자처럼 보였다
local function addBoots(character: Model, folder: Folder, item)
	for _, name in { "LeftFoot", "RightFoot" } do
		local foot = character:FindFirstChild(name)
		if foot and foot:IsA("BasePart") then
			local s = foot.Size
			local bottom = -s.Y / 2
			local width, length = s.X + 0.2, s.Z + 0.1
			local body = bootPiece(
				folder,
				foot,
				Vector3.new(width, 0.62, length * 0.8),
				CFrame.new(0, bottom + 0.4, length * 0.1),
				rgb(item.body)
			)
			local toe = bootPiece(
				folder,
				foot,
				Vector3.new(width, 0.5, length * 0.45),
				CFrame.new(0, bottom + 0.3, -length * 0.3),
				rgb(item.body),
				false,
				Enum.PartType.Ball
			)
			if item.metal then
				body.Reflectance = 0.25
				toe.Reflectance = 0.25
			end
			bootPiece(
				folder,
				foot,
				Vector3.new(width + 0.1, 0.18, length + 0.12),
				CFrame.new(0, bottom + 0.06, 0),
				rgb(item.sole)
			)
			bootPiece(
				folder,
				foot,
				Vector3.new(width + 0.04, 0.1, length * 0.8 + 0.04),
				CFrame.new(0, bottom + 0.5, length * 0.1),
				rgb(item.accent),
				item.glow
			)
		end
	end
end

function CosmeticService.apply(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local profile = DataService.get(player)
	if not profile then
		return
	end
	clear(character)
	local worn = ShopLogic.worn(Shop, profile.equipped, profile.owned)
	if worn.Trail then
		addTrail(character, worn.Trail)
	end
	if worn.Boots then
		local folder = Instance.new("Folder")
		folder.Name = FOLDER
		folder.Parent = character
		addBoots(character, folder, worn.Boots)
	end
end

local function watch(player: Player)
	-- DataService가 프로필을 읽거나 장착이 바뀌면 이 속성을 새로 쓴다 (갱신 신호로만 쓰고, 판단은 프로필로 한다)
	player:GetAttributeChangedSignal("ShopEquipped"):Connect(function()
		CosmeticService.apply(player)
	end)
	player.CharacterAdded:Connect(function(character)
		-- 아바타 외형이 로드되면 발 부품이 새것으로 바뀌어, 그 전에 붙인 부츠는 떨어져 사라졌다. 로드를 기다린다
		local started = os.clock()
		while not player:HasAppearanceLoaded() and character.Parent and os.clock() - started < APPEARANCE_TIMEOUT do
			task.wait(0.2)
		end
		if player.Character ~= character then
			return
		end
		CosmeticService.apply(player)
		-- 그 뒤에도 발이 바뀌면(외형 갱신) 다시 입힌다
		character.ChildAdded:Connect(function(child)
			if child.Name == "LeftFoot" or child.Name == "RightFoot" then
				task.defer(CosmeticService.apply, player)
			end
		end)
	end)
	if player.Character then
		CosmeticService.apply(player)
	end
end

function CosmeticService.start()
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end
end

return CosmeticService
]]></ProtectedString>
					<string name="ScriptGuid">{017B886C-810F-46D5-ABC9-989213AEB6C1}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CosmeticService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00148ff1</UniqueId>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX35DEC224E51D4B16A9BBE8568D774EE1">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- 숨은 별조각 줍기 확인과 보상. 클라이언트는 "닿았다"만 보내고, 서버가 캐릭터 위치로 확인한다.
-- 코인은 EconomyService, 프로필은 DataService만 바꾼다. 결과는 Shards 속성(DataService가 쓴다)으로 클라이언트에 알린다
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Collectibles = require(ReplicatedStorage.Config.Collectibles)
local World = require(ReplicatedStorage.Config.World)
local CollectibleLogic = require(ReplicatedStorage.Shared.CollectibleLogic)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Net = require(script.Parent.Net)

local CollectibleService = {}

local CALL_INTERVAL = 0.3
-- 보고가 캐릭터 위치보다 먼저 도착할 수 있다(순간이동·지연). "멀다"면 이 간격으로 몇 번 더 위치를 본다
local RECHECK_INTERVAL = 0.25
local RECHECKS = 2

local function check(player: Player, shardId: any): (boolean, string?)
	local profile = DataService.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (profile and root and root:IsA("BasePart")) then
		return false, "nobody"
	end
	local p = root.Position
	return CollectibleLogic.canCollect(Collectibles, World, shardId, profile.shards, { p.X, p.Y, p.Z })
end

local function collect(player: Player, shardId: any)
	local ok, reason = check(player, shardId)
	for _ = 1, RECHECKS do
		if ok or reason ~= "far" then
			break
		end
		task.wait(RECHECK_INTERVAL)
		ok, reason = check(player, shardId)
	end
	if not ok then
		if reason == "far" then
			warn(
				string.format(
					"[CollectibleService] %s의 %s 보고가 너무 멉니다",
					player.Name,
					tostring(shardId)
				)
			)
		end
		return
	end
	local shard = CollectibleLogic.find(Collectibles, shardId)
	EconomyService.addCoins(player, Collectibles.ShardCoins)
	DataService.update(player, function(data)
		data.shards[shard.id] = true
		-- 그 섬을 다 모았으면 세트 보상(상점의 unlock 물건)을 준다
		local found, total = CollectibleLogic.islandProgress(Collectibles, shard.island, data.shards)
		local set = CollectibleLogic.setFor(Collectibles, shard.island)
		if set and found == total then
			data.owned[set.reward] = true
		end
	end)
end

function CollectibleService.start()
	Net.handleEvent(Remotes.ShardCollect, CALL_INTERVAL, collect)
end

return CollectibleService
]]></ProtectedString>
