						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc00171bd0</UniqueId>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="22">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">UI</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003f3</UniqueId>
				</Properties>
				<Item class="ModuleScript" referent="23">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 토이 HUD: 고도, 남은 점프, 퍼펙트·콤보 팝업, 모바일 버튼, 토이 기록(F2)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local CameraConfig = require(ReplicatedStorage.Config.Camera)
local Movement = require(ReplicatedStorage.Config.Movement)
local MovementLogic = require(ReplicatedStorage.Shared.MovementLogic)
local Strings = require(ReplicatedStorage.Shared.Strings)
local ToyStats = require(ReplicatedStorage.Shared.ToyStats)

local player = Players.LocalPlayer

local TREND_WINDOW = 180 -- 퍼펙트율 비교 구간(초): 처음 3분 vs 최근 3분
local STATS_REFRESH = 0.5

local COLOR = {
	Text = Color3.fromRGB(255, 255, 255),
	Stroke = Color3.fromRGB(40, 60, 90),
	Perfect = Color3.fromRGB(255, 205, 60),
	Drop = Color3.fromRGB(190, 225, 255),
	Stomp = Color3.fromRGB(255, 140, 210),
	Pad = Color3.fromRGB(255, 220, 90),
	Buddy = Color3.fromRGB(130, 255, 170),
	PipOn = Color3.fromRGB(255, 255, 255),
	PipOff = Color3.fromRGB(90, 110, 140),
	Panel = Color3.fromRGB(20, 30, 50),
}

local Hud = {}

local function t(key: string, ...: any): string
	return Strings.get(player.LocaleId, key, ...)
end

local function newLabel(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = COLOR.Text
	for key, value in props do
		(label :: any)[key] = value
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = COLOR.Stroke
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function newButton(parent: Instance, text: string, size: UDim2, position: UDim2): TextButton
	local button = Instance.new("TextButton")
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = COLOR.Panel
	button.BackgroundTransparency = 0.35
	button.Font = Enum.Font.FredokaOne
	button.TextColor3 = COLOR.Text
	button.TextScaled = true
	button.Text = text
	button.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = button
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.15, 0)
	padding.PaddingRight = UDim.new(0.15, 0)
	padding.PaddingTop = UDim.new(0.25, 0)
	padding.PaddingBottom = UDim.new(0.25, 0)
	padding.Parent = button
	button.Parent = parent
	return button
end

local function percent(rate: number?): string
	if rate == nil then
		return t("NoData")
	end
	return string.format("%d%%", math.floor(rate * 100 + 0.5))
end

local function clock(seconds: number): string
	local whole = math.floor(seconds)
	return string.format("%d:%02d", whole // 60, whole % 60)
end

-- 구름 바다로 떨어졌다 돌아올 때 하얗게 덮었다 걷어 낸다
local function buildFade(): Frame
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopFade"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 10
	gui.Parent = player:WaitForChild("PlayerGui")
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(248, 250, 255)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Parent = gui
	return frame
end

function Hud.start(hop, skyCamera, landingMarker, vertigo, skyMap)
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopHud"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local respawnFade = buildFade()
	hop.onRespawn:Connect(function()
		respawnFade.BackgroundTransparency = 0
		TweenService:Create(respawnFade, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 })
			:Play()
	end)

	-- 고도
	local altitude = newLabel(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(260, 52),
		TextSize = 46,
	})
	local best = newLabel(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.fromOffset(260, 24),
		TextSize = 20,
	})
	-- 발밑 깊이: 허공 위에 있을 때만 보여 아찔함을 숫자로 느끼게 한다
	local drop = newLabel(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(300, 26),
		TextSize = 22,
		TextColor3 = COLOR.Drop,
		TextTransparency = 1,
	})
	local dropStroke = drop:FindFirstChildOfClass("UIStroke")
	local dropAlpha = 0

	-- 남은 점프
	local pipRow = Instance.new("Frame")
	pipRow.AnchorPoint = Vector2.new(0.5, 1)
	pipRow.Position = UDim2.new(0.5, 0, 1, -48)
	pipRow.Size = UDim2.fromOffset(140, 26)
	pipRow.BackgroundTransparency = 1
	pipRow.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 10)
	layout.Parent = pipRow
	local pips = {}
	for index = 1, MovementLogic.maxJumps(Movement) do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.fromOffset(22, 22)
		pip.LayoutOrder = index
		pip.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = pip
		-- 흰 바닥 위에서도 보이게 외곽선을 두른다
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Color = COLOR.Stroke
		stroke.Parent = pip
		pip.Parent = pipRow
		pips[index] = pip
	end

	-- 팝업
	local popup = newLabel(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(480, 64),
		TextSize = 44,
		TextWrapped = true,
		TextTransparency = 1,
	})
	local popupStroke = popup:FindFirstChildOfClass("UIStroke")
	popupStroke.Transparency = 1

	-- 허브에서 늘 떠 있는 러시 대기 띠(RushHud: 위 116, 높이 50, 세로 터치는 64)와 겹치지 않게 그 아래에 둔다.
	-- 좁은 화면에서는 긴 팝업("DING! ...")이 두 줄로 접힌다
	local function placePopup()
		local camera = workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local height = if viewport.X < 500 then 110 else 64
		local narrowTouch = UserInputService.TouchEnabled and viewport.Y > viewport.X
		local bannerBottom = if narrowTouch then 180 else 166 -- 두 화면 모두 IgnoreGuiInset = false라 같은 기준이다
		popup.Size = UDim2.fromOffset(math.min(480, viewport.X - 16), height)
		popup.Position = UDim2.new(0.5, 0, 0, math.max(viewport.Y * 0.3, bannerBottom + 10 + height / 2))
	end
	placePopup()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(placePopup)
	end

	local function showPopup(text: string, color: Color3, scale: number?)
		local size = scale or 1
		popup.Text = text
		popup.TextColor3 = color
		popup.TextTransparency = 0
		popupStroke.Transparency = 0
		popup.TextSize = 54 * size
		TweenService:Create(popup, TweenInfo.new(0.15), { TextSize = 44 * size }):Play()
		local fade = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.5)
		TweenService:Create(popup, fade, { TextTransparency = 1 }):Play()
		TweenService:Create(popupStroke, fade, { Transparency = 1 }):Play()
	end

	-- 시점·마커 상태. 터치 화면은 왼쪽 위를 의뢰 진행 표시에 내주고, 바뀔 때만 남은 점프 표시 위에 잠깐 띄운다
	local touch = UserInputService.TouchEnabled
	local status = newLabel(gui, {
		AnchorPoint = if touch then Vector2.new(0.5, 1) else Vector2.zero,
		Position = if touch then UDim2.new(0.5, 0, 1, -80) else UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(if touch then 220 else 320, 44),
		TextSize = 18,
		TextXAlignment = if touch then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local statusStroke = status:FindFirstChildOfClass("UIStroke")
	local function refreshStatus()
		local view = if skyCamera.mode == "First" then t("ViewFirst") else t("ViewSky")
		local marker = if landingMarker.enabled then t("MarkerOn") else t("MarkerOff")
		status.Text = view .. "\n" .. marker
		if touch then
			status.TextTransparency = 0
			statusStroke.Transparency = 0
			local fade = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 1.6)
			TweenService:Create(status, fade, { TextTransparency = 1 }):Play()
			TweenService:Create(statusStroke, fade, { Transparency = 1 }):Play()
		end
	end
	refreshStatus()
	skyCamera.onModeChanged:Connect(refreshStatus)
	landingMarker.onToggled:Connect(refreshStatus)

	-- 토이 기록 (토이 게이트 측정용)
	local statsPanel = newLabel(gui, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 60),
		Size = UDim2.fromOffset(380, 172),
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundColor3 = COLOR.Panel,
		BackgroundTransparency = 0.4,
		Visible = false,
	})
	local panelPadding = Instance.new("UIPadding")
	panelPadding.PaddingLeft = UDim.new(0, 10)
	panelPadding.PaddingTop = UDim.new(0, 8)
	panelPadding.Parent = statsPanel

	local viewSeconds = { Sky = 0, First = 0 }
	local function statsText(): string
		local stats = hop.stats
		local elapsed = os.clock() - stats.startedAt
		return table.concat({
			t("StatsTitle"),
			t("StatsTime", clock(elapsed)),
			t("StatsJumps", #stats.airJumps, percent(ToyStats.perfectRate(stats.airJumps, 0, math.huge))),
			t(
				"StatsTrend",
				percent(ToyStats.perfectRate(stats.airJumps, 0, TREND_WINDOW)),
				percent(ToyStats.perfectRate(stats.airJumps, math.max(0, elapsed - TREND_WINDOW), math.huge))
			),
			t("StatsStreak", stats.bestPerfectStreak),
			t("StatsStomps", stats.stomps, stats.bells),
			t("StatsHighest", math.round(stats.maxAltitude)),
			t("StatsView", clock(viewSeconds.Sky), clock(viewSeconds.First)),
		}, "\n")
	end
	local function toggleStats()
		statsPanel.Visible = not statsPanel.Visible
		if statsPanel.Visible then
			statsPanel.Text = statsText()
		end
	end

	-- 입력 안내 (키보드)
	if UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled then
		newLabel(gui, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 12, 1, -10),
			Size = UDim2.new(0.6, 0, 0, 20),
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = t("ControlsKeyboard"),
		})
	end

	-- 모바일 버튼. 밟기 버튼은 기본 점프 버튼 바로 위에 둔다.
	-- 세로 화면은 위쪽 가운데의 고도 표시와 겹치지 않게 시점·기록 버튼을 오른쪽에 세로로 쌓는다
	if touch then
		local stompButton = newButton(gui, t("ButtonStomp"), UDim2.fromOffset(84, 84), UDim2.new(1, -110, 1, -240))
		stompButton.Activated:Connect(hop.stomp)
		local viewButton = newButton(gui, t("ButtonView"), UDim2.fromOffset(96, 40), UDim2.new(1, -70, 0, 30))
		viewButton.Activated:Connect(skyCamera.toggle)
		local statsButton = newButton(gui, t("ButtonStats"), UDim2.fromOffset(96, 40), UDim2.new(1, -176, 0, 30))
		statsButton.Activated:Connect(toggleStats)
		local mapButton = newButton(gui, t("ButtonMap"), UDim2.fromOffset(96, 40), UDim2.new(1, -282, 0, 30))
		mapButton.Name = "MapButton"
		mapButton.Activated:Connect(skyMap.toggle)

		local function placeTouch()
			local camera = workspace.CurrentCamera
			local viewport = if camera then camera.ViewportSize else Vector2.new(1000, 1000)
			local small = math.min(viewport.X, viewport.Y) <= 500
			local portrait = viewport.Y > viewport.X
			stompButton.Size = if small then UDim2.fromOffset(64, 64) else UDim2.fromOffset(96, 96)
			stompButton.Position = if small then UDim2.new(1, -60, 1, -130) else UDim2.new(1, -110, 1, -270)
			viewButton.Position = if portrait then UDim2.new(1, -58, 0, 140) else UDim2.new(1, -70, 0, 30)
			statsButton.Position = if portrait then UDim2.new(1, -58, 0, 188) else UDim2.new(1, -176, 0, 30)
			mapButton.Position = if portrait then UDim2.new(1, -58, 0, 92) else UDim2.new(1, -282, 0, 30)
			statsPanel.Position = if portrait then UDim2.new(1, -12, 0, 236) else UDim2.new(1, -12, 0, 60)
			statsPanel.Size = UDim2.fromOffset(math.min(380, viewport.X - 24), 172)
		end
		placeTouch()
		if workspace.CurrentCamera then
			workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(placeTouch)
		end
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F2 then
			toggleStats()
		end
	end)

	-- 연속 퍼펙트는 단계마다 문구·색이 바뀌고 조금씩 커진다
	hop.onJump:Connect(function(_, perfect, _, streak)
		if not perfect then
			return
		end
		local tier = MovementLogic.perfectTier(Movement, streak)
		local text = t("PerfectTier" .. tier)
		if streak > 1 then
			text = t("PerfectCombo", text, streak)
		end
		local rgb = Movement.PerfectStreakTiers[tier].color
		showPopup(text, Color3.fromRGB(rgb[1], rgb[2], rgb[3]), 1 + (tier - 1) * 0.08)
	end)
	hop.onBounce:Connect(function(kind, combo)
		if kind == "pad" then
			showPopup(t("BouncePad"), COLOR.Pad)
		elseif kind == "buddy" then
			showPopup(t("Buddy"), COLOR.Buddy)
		elseif combo >= 2 then
			showPopup(t("StompCombo", combo), COLOR.Stomp)
		end
	end)
	hop.onBell:Connect(function()
		showPopup(t("Bell"), COLOR.Perfect)
	end)
	hop.onStaggered:Connect(function(_, reason)
		if reason == "zap" then
			showPopup(t("BossZapped"), COLOR.Pad)
		else
			showPopup(t("Stomped"), COLOR.Stomp)
		end
	end)

	local sinceStatsRefresh = 0
	RunService.RenderStepped:Connect(function(dt)
		altitude.Text = t("Altitude", math.round(hop.altitude()))
		best.Text = t("Best", math.round(hop.stats.maxAltitude))

		local showDrop = vertigo.drop >= CameraConfig.DropMeterMin and (not hop.isGrounded() or vertigo.edge)
		dropAlpha += ((if showDrop then 1 else 0) - dropAlpha) * (1 - math.exp(-8 * dt))
		drop.Text = t("DropBelow", math.round(vertigo.drop))
		drop.TextTransparency = 1 - dropAlpha
		dropStroke.Transparency = 1 - dropAlpha

		local left = hop.jumpsLeft()
		for index, pip in pips do
			pip.BackgroundColor3 = if index <= left then COLOR.PipOn else COLOR.PipOff
		end

		viewSeconds[skyCamera.mode] += dt
		sinceStatsRefresh += dt
		if statsPanel.Visible and sinceStatsRefresh >= STATS_REFRESH then
			sinceStatsRefresh = 0
			statsPanel.Text = statsText()
		end
	end)
end

return Hud
]]></ProtectedString>
						<string name="ScriptGuid">{A2EC96B4-5CD5-477E-A057-2424EBCBE8A5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Hud</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">6f234ddc785d1dd50afb8a14000003f4</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0C31FDD7C78243CFB71BBF8757503FDD">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 의뢰 화면: 주민 대화창, 진행 표시, 결과 창, 주민 이야기 엔딩 카드, 실패 알림
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local COLOR = {
	Panel = Color3.fromRGB(24, 34, 58),
	Text = Color3.fromRGB(255, 255, 255),
	Soft = Color3.fromRGB(200, 214, 240),
	Accept = Color3.fromRGB(96, 186, 120),
	gold = Color3.fromRGB(255, 205, 60),
	silver = Color3.fromRGB(210, 220, 235),
	bronze = Color3.fromRGB(220, 150, 100),
	Fail = Color3.fromRGB(255, 150, 150),
}
local MEDAL_KEY = { gold = "MedalGold", silver = "MedalSilver", bronze = "MedalBronze" }
local RESULT_SECONDS = 4

local RequestUi = {}

local function t(key: string, ...: any): string
	return Strings.get(player.LocaleId, key, ...)
end

local function clock(seconds: number): string
	local whole = math.floor(seconds)
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function rounded(inst: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
end

local function panel(parent: Instance, props: { [string]: any }): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = COLOR.Panel
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Visible = false
	for key, value in props do
		(frame :: any)[key] = value
	end
	rounded(frame, 14)
	frame.Parent = parent
	return frame
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextColor3 = COLOR.Text
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextWrapped = true
	for key, value in props do
		(text :: any)[key] = value
	end
	text.Parent = parent
	return text
end

local function button(parent: Instance, color: Color3, position: UDim2): TextButton
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(1, 1)
	b.Position = position
	b.Size = UDim2.fromOffset(120, 40)
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = COLOR.Text
	b.TextSize = 22
	rounded(b, 12)
	b.Parent = parent
	return b
end

local gui: ScreenGui
local dialog, tracker, result: Frame
local dialogName, dialogLine, dialogGoal, dialogMedals, dialogBest: TextLabel
local startButton, laterButton: TextButton
local trackerGoal, trackerProgress, trackerTime: TextLabel
local resultTitle, resultMedal, resultDetail: TextLabel
local toastLabel: TextLabel
local storyCard: Frame
local storyTitle, storyLines, storyChange: TextLabel
local onStartCallback: (() -> ())? = nil
local onStoryClosed: (() -> ())? = nil
local resultToken = 0
local STORY_SECONDS = 14 -- 엔딩 카드는 이만큼 뒤에 저절로 닫힌다

-- 대화창 글자 배치: 넓은 화면과 좁은 화면(세로 휴대폰). 좁으면 메달 기준을 버튼 위 전체 폭으로 쓴다
local DIALOG_LAYOUT = {
	wide = {
		height = 200,
		name = { y = 12, h = 28, size = 26 },
		line = { y = 44, h = 52, size = 19 },
		goal = { y = 100, h = 24, size = 20 },
		medals = { y = 128, size = 16 },
		best = { y = 152, size = 16 },
		textInset = 300,
	},
	narrow = {
		height = 250,
		name = { y = 10, h = 24, size = 22 },
		line = { y = 38, h = 66, size = 16 },
		goal = { y = 106, h = 40, size = 17 },
		medals = { y = 150, size = 15 },
		best = { y = 170, size = 15 },
		textInset = 40,
	},
}

-- 화면 크기에 맞춘 배치. 터치 기기는 오른쪽 아래(밟기·점프 버튼)를 비우고,
-- 세로 화면에서는 위쪽 고도 표시 아래로 내린다
local function layout()
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local touch = UserInputService.TouchEnabled
	local portrait = viewport.Y > viewport.X

	local width = math.min(560, viewport.X - 24)
	local spec = if width < 520 then DIALOG_LAYOUT.narrow else DIALOG_LAYOUT.wide
	dialog.Size = UDim2.fromOffset(width, spec.height)
	for _, item in
		{
			{ dialogName, spec.name },
			{ dialogLine, spec.line },
			{ dialogGoal, spec.goal },
		}
	do
		item[1].Position = UDim2.fromOffset(20, item[2].y)
		item[1].Size = UDim2.new(1, -40, 0, item[2].h)
		item[1].TextSize = item[2].size
	end
	for _, item in { { dialogMedals, spec.medals }, { dialogBest, spec.best } } do
		item[1].Position = UDim2.fromOffset(20, item[2].y)
		item[1].Size = UDim2.new(1, -spec.textInset, 0, 20)
		item[1].TextSize = item[2].size
	end

	if not touch then
		tracker.AnchorPoint = Vector2.new(1, 0)
		tracker.Position = UDim2.new(1, -12, 0, 220)
		tracker.Size = UDim2.fromOffset(320, 84)
	elseif portrait then
		tracker.AnchorPoint = Vector2.new(0, 0)
		tracker.Position = UDim2.fromOffset(12, 118)
		tracker.Size = UDim2.fromOffset(math.min(280, viewport.X - 134), 84)
	else
		tracker.AnchorPoint = Vector2.new(0, 0)
		tracker.Position = UDim2.fromOffset(12, 8)
		tracker.Size = UDim2.fromOffset(250, 84)
	end
	trackerGoal.TextSize = if touch then 15 else 17

	result.Size = UDim2.fromOffset(math.min(380, viewport.X - 24), 170)
	storyCard.Size = UDim2.fromOffset(math.min(540, viewport.X - 24), if viewport.X < 520 then 330 else 290)
	-- 허브에서는 러시 대기 띠(위 116, 높이 50~64)가 늘 떠 있고 그 바로 밑에 Hud의 퍼펙트 팝업이 뜬다. 그 아래에 띄운다
	toastLabel.Position = UDim2.new(0.5, 0, 0, if touch and portrait then 310 else 250)
	toastLabel.Size = UDim2.fromOffset(math.min(600, viewport.X - 24), 56)
	toastLabel.TextSize = if viewport.X < 600 then 20 else 24
end

function RequestUi.start()
	gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopRequests"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")

	dialog = panel(gui, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(560, 200),
	})
	dialogName = label(dialog, {})
	dialogLine = label(dialog, { TextColor3 = COLOR.Soft, TextYAlignment = Enum.TextYAlignment.Top })
	dialogGoal = label(dialog, { TextYAlignment = Enum.TextYAlignment.Top })
	dialogMedals = label(dialog, { TextColor3 = COLOR.gold })
	dialogBest = label(dialog, { TextColor3 = COLOR.Soft })
	dialog.Name = "Dialog"
	startButton = button(dialog, COLOR.Accept, UDim2.new(1, -16, 1, -16))
	startButton.Name = "StartButton"
	laterButton = button(dialog, Color3.fromRGB(90, 100, 130), UDim2.new(1, -146, 1, -16))
	laterButton.Name = "LaterButton"
	startButton.Activated:Connect(function()
		dialog.Visible = false
		local callback = onStartCallback
		onStartCallback = nil
		if callback then
			callback()
		end
	end)
	laterButton.Activated:Connect(RequestUi.hideDialog)

	tracker = panel(gui, {})
	trackerGoal = label(tracker, { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 40) })
	trackerProgress = label(tracker, {
		Position = UDim2.fromOffset(14, 52),
		Size = UDim2.new(0.5, -14, 0, 24),
		TextSize = 22,
		TextColor3 = COLOR.gold,
	})
	trackerTime = label(tracker, {
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.new(0.5, -14, 0, 24),
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	result = panel(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
	})
	resultTitle = label(result, {
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 34),
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	resultMedal = label(result, {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 36),
		TextSize = 32,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	resultDetail = label(result, {
		Position = UDim2.fromOffset(20, 96),
		Size = UDim2.new(1, -40, 0, 60),
		TextSize = 18,
		TextColor3 = COLOR.Soft,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	-- 주민 이야기 엔딩 카드
	storyCard = panel(gui, {
		Name = "Story",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
	})
	label(storyCard, {
		Position = UDim2.fromOffset(20, 14),
		Size = UDim2.new(1, -40, 0, 22),
		TextSize = 18,
		TextColor3 = COLOR.gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = t("StoryComplete"),
	})
	storyTitle = label(storyCard, {
		Position = UDim2.fromOffset(20, 38),
		Size = UDim2.new(1, -40, 0, 34),
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	-- 대사는 남는 높이를 모두 쓰고, 바뀐 것 안내는 버튼 바로 위
	storyLines = label(storyCard, {
		Position = UDim2.fromOffset(24, 80),
		Size = UDim2.new(1, -48, 1, -196),
		TextSize = 17,
		TextColor3 = COLOR.Soft,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	storyChange = label(storyCard, {
		Position = UDim2.new(0, 24, 1, -108),
		Size = UDim2.new(1, -48, 0, 46),
		TextSize = 16,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	local storyOk = button(storyCard, COLOR.Accept, UDim2.new(1, -16, 1, -12))
	storyOk.Name = "OkButton"
	storyOk.Text = t("Ok")
	storyOk.Activated:Connect(RequestUi.hideStory)

	tracker.Name = "Tracker"
	result.Name = "Result"
	toastLabel = label(gui, {
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 0),
		Text = "",
		TextColor3 = COLOR.Fail,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
	})
	-- 외곽선도 숨겨 두어야 빈 알림이 비쳐 보이지 않는다
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(60, 30, 40)
	stroke.Transparency = 1
	stroke.Parent = toastLabel

	layout()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	end
end

function RequestUi.text(key: string, ...: any): string
	return t(key, ...)
end

-- 주민 대화. request가 nil이면 부탁할 게 없다는 인사만
function RequestUi.showDialog(residentId: string, request, record, onStart: () -> ())
	dialogName.Text = residentId
	if not request then
		dialogLine.Text = t("ResidentDone")
		dialogGoal.Text = ""
		dialogMedals.Text = ""
		dialogBest.Text = ""
		startButton.Visible = false
		laterButton.Text = t("Ok")
	else
		dialogLine.Text = t("Req_" .. request.id .. "_Line")
		dialogGoal.Text = t("Goal", t("Req_" .. request.id .. "_Goal"))
		dialogMedals.Text = t("MedalTimes", request.gold, request.silver)
		dialogBest.Text = if record then t("BestRecord", t(MEDAL_KEY[record.medal]), clock(record.bestTime)) else ""
		startButton.Visible = true
		startButton.Text = t("Start")
		laterButton.Text = t("Later")
	end
	onStartCallback = onStart
	dialog.Visible = true
end

function RequestUi.hideDialog()
	dialog.Visible = false
	onStartCallback = nil
end

function RequestUi.isDialogOpen(): boolean
	return dialog.Visible
end

function RequestUi.showTracker(request)
	trackerGoal.Text = t("Req_" .. request.id .. "_Goal")
	trackerProgress.Text = ""
	trackerTime.Text = clock(0)
	tracker.Visible = true
end

function RequestUi.setProgress(done: number, total: number)
	trackerProgress.Text = t("Progress", done, total)
end

function RequestUi.setCountdown(seconds: number)
	trackerProgress.Text = t("RaceCountdown", seconds)
end

function RequestUi.setTime(seconds: number)
	trackerTime.Text = clock(seconds)
end

function RequestUi.hideTracker()
	tracker.Visible = false
end

function RequestUi.showResult(data)
	resultToken += 1
	local token = resultToken
	resultTitle.Text = t("ResultTitle")
	resultMedal.Text = t(MEDAL_KEY[data.medal])
	resultMedal.TextColor3 = COLOR[data.medal]
	local lines = { t("ResultTime", clock(data.time)) }
	if data.coins > 0 then
		table.insert(lines, t("ResultCoins", data.coins))
	end
	if data.bellNeeded > 0 then
		table.insert(lines, t("ResultBell", data.bell, data.bellNeeded))
	end
	resultDetail.Text = table.concat(lines, "\n")
	result.Visible = true
	task.delay(RESULT_SECONDS, function()
		if token == resultToken then
			result.Visible = false
		end
	end)
end

-- 주민 이야기 엔딩: 제목, 주민들의 대사, 허브에서 바뀐 것. 닫히면 onClosed를 부른다
function RequestUi.showStory(storyId: string, onClosed: (() -> ())?)
	storyTitle.Text = t("Story_" .. storyId .. "_Title")
	storyLines.Text = t("Story_" .. storyId .. "_Line")
	storyChange.Text = t("Story_" .. storyId .. "_Change")
	onStoryClosed = onClosed
	storyCard.Visible = true
	task.delay(STORY_SECONDS, function()
		if storyCard.Visible and onStoryClosed == onClosed then
			RequestUi.hideStory()
		end
	end)
end

-- 대화창이나 엔딩 카드가 떠 있는가 (다른 화면이 그 뒤에 비치지 않게 숨길 때)
function RequestUi.isBusy(): boolean
	return dialog.Visible or storyCard.Visible
end

function RequestUi.hideStory()
	storyCard.Visible = false
	local callback = onStoryClosed
	onStoryClosed = nil
	if callback then
		callback()
	end
end

function RequestUi.toast(text: string)
	toastLabel.Text = text
	toastLabel.TextTransparency = 0
	local stroke = toastLabel:FindFirstChildOfClass("UIStroke")
	stroke.Transparency = 0
	local fade = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 2.2)
	TweenService:Create(toastLabel, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
end

return RequestUi
]]></ProtectedString>
						<string name="ScriptGuid">{C94A4B43-B311-411D-A3ED-D8FA6ACC80D2}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RequestUi</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0002a8f0</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX5A6F86A4E9A0404591739CCDF312BFA5">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 하늘 지도 (GDD 6.2·6.4·7.1): 섬과 장 진행, 의뢰가 있는 주민 위치, 길 안내 빛기둥.
-- 튜토리얼(0장)을 끝내거나 1장 이후 의뢰를 하나라도 끝내면 열린다 (RequestLogic.isMapUnlocked).
-- M 키, 터치 지도 버튼(Hud), 허브 광장의 지도 탁자로 연다
local GuiService = game:GetService("GuiService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Collectibles = require(ReplicatedStorage.Config.Collectibles)
local Requests = require(ReplicatedStorage.Config.Requests)
local World = require(ReplicatedStorage.Config.World)
local CollectibleLogic = require(ReplicatedStorage.Shared.CollectibleLogic)
local RequestLogic = require(ReplicatedStorage.Shared.RequestLogic)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local COLOR = {
	Backdrop = Color3.fromRGB(8, 14, 28),
	Panel = Color3.fromRGB(24, 34, 58),
	Sky = Color3.fromRGB(92, 146, 206),
	Text = Color3.fromRGB(255, 255, 255),
	Soft = Color3.fromRGB(200, 214, 240),
	Hub = Color3.fromRGB(170, 222, 140),
	Island = Color3.fromRGB(120, 196, 110),
	Upcoming = Color3.fromRGB(96, 110, 138),
	Rim = Color3.fromRGB(255, 255, 255),
	Ink = Color3.fromRGB(40, 32, 20),
	Guide = Color3.fromRGB(255, 210, 70),
	Accept = Color3.fromRGB(96, 186, 120),
	Close = Color3.fromRGB(90, 100, 130),
	-- 주민 상태 (RequestLogic.residentState)와 최고 메달
	new = Color3.fromRGB(255, 210, 70),
	boss = Color3.fromRGB(255, 120, 90),
	storm = Color3.fromRGB(96, 98, 122),
	locked = Color3.fromRGB(120, 130, 150),
	gold = Color3.fromRGB(255, 205, 60),
	silver = Color3.fromRGB(210, 220, 235),
	bronze = Color3.fromRGB(220, 150, 100),
}
local MEDAL_KEY = { gold = "MedalGold", silver = "MedalSilver", bronze = "MedalBronze" }
local MEDAL_RANK = { bronze = 1, silver = 2, gold = 3 }
local GUIDE_CLEAR_DISTANCE = 16 -- 이만큼 다가가면 빛기둥이 사라진다
local GUIDE_HEIGHT = 400

local SkyMap = {}

local hop, ui
local gui: ScreenGui
local window, mapArea, side: Frame
local chapterLabel, detailName, detailState, detailGoal: TextLabel
local guideButton, closeButton: TextButton
local you: Frame
local drawn: { Instance } = {}
local selected: string? = nil
local unlocked = false
local loaded = false
local guideBeam: BasePart? = nil
local guideTarget: string? = nil
local guidePosition: Vector3? = nil
local toMap: ((x: number, z: number) -> Vector2)? = nil

local function t(key: string, ...: any): string
	return Strings.get(player.LocaleId, key, ...)
end

local function progress(): RequestLogic.Progress
	local raw = player:GetAttribute("RequestProgress")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok then decoded else {}
end

local function shardsFound(): { [string]: boolean }
	local raw = player:GetAttribute("Shards")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else {}
end

local function rounded(inst: GuiObject, radius: UDim)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = inst
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextColor3 = COLOR.Text
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextYAlignment = Enum.TextYAlignment.Top
	text.TextWrapped = true
	for key, value in props do
		(text :: any)[key] = value
	end
	text.Parent = parent
	return text
end

local function button(parent: Instance, text: string, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = COLOR.Text
	b.TextSize = 18
	b.Text = text
	rounded(b, UDim.new(0, 10))
	b.Parent = parent
	return b
end

local function residentSpec(id: string)
	for _, resident in Requests.Residents do
		if resident.id == id then
			return resident
		end
	end
	return nil
end

local function islandSpec(id: string)
	for _, island in World.Islands do
		if island.id == id then
			return island
		end
	end
	return nil
end

-- 지도 핀은 주민 id 또는 장 보스 의뢰 id다
local function bossOf(id: string)
	local request = RequestLogic.find(Requests, id)
	return if request and request.boss then request else nil
end

local function displayName(id: string): string
	local boss = bossOf(id)
	return if boss then t(boss.name) else id
end

-- 길 안내 목적지: 주민이 서 있는 곳, 보스는 정상의 폭풍 받침대
local function targetPosition(id: string): Vector3?
	local boss = bossOf(id)
	if boss then
		local island = islandSpec(boss.island)
		local air = boss.gate.air
		return Vector3.new(island.center[1] + air[1], island.center[2] + air[2], island.center[3] + air[3])
	end
	local folder = workspace:FindFirstChild("World")
	local residents = folder and folder:FindFirstChild("Residents")
	local model = residents and residents:FindFirstChild(id)
	return if model and model:IsA("Model") then model:GetPivot().Position else nil
end

-- 지도에 그릴 섬: 월드의 섬과 아직 없는 섬
local function mapEntries()
	local list = {}
	for _, island in World.Islands do
		table.insert(list, {
			id = island.id,
			x = island.center[1],
			z = island.center[3],
			radius = island.radius,
			chapter = island.chapter,
		})
	end
	for _, upcoming in World.MapUpcoming do
		table.insert(list, {
			id = upcoming.id,
			x = upcoming.x,
			z = upcoming.z,
			radius = World.MapUpcomingRadius,
			chapter = upcoming.chapter,
			upcoming = true,
		})
	end
	return list
end

-- 월드 x, z → 지도 픽셀 (위쪽이 -Z). 모든 섬이 들어가게 맞춘다
local function fit(entries, size: number, padding: number): (x: number, z: number) -> Vector2
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for _, e in entries do
		minX = math.min(minX, e.x - e.radius)
		maxX = math.max(maxX, e.x + e.radius)
		minZ = math.min(minZ, e.z - e.radius)
		maxZ = math.max(maxZ, e.z + e.radius)
	end
	local s = (size - padding * 2) / math.max(maxX - minX, maxZ - minZ)
	local cx, cz = (minX + maxX) / 2, (minZ + maxZ) / 2
	return function(x: number, z: number): Vector2
		return Vector2.new(size / 2 + (x - cx) * s, size / 2 + (z - cz) * s)
	end
end

-- 한 섬 안의 주민 핀이 겹치지 않게 서로 밀어낸다
local function spread(points: { Vector2 }, minDistance: number)
	for _ = 1, 12 do
		for i = 1, #points do
			for j = i + 1, #points do
				local d = points[j] - points[i]
				local gap = d.Magnitude
				if gap < minDistance then
					local dir = if gap > 1e-3 then d / gap else Vector2.new(1, 0)
					local push = dir * (minDistance - gap) / 2
					points[i] -= push
					points[j] += push
				end
			end
		end
	end
end

local function clearGuide()
	if guideBeam then
		guideBeam:Destroy()
		guideBeam = nil
	end
	guideTarget = nil
	guidePosition = nil
end

function SkyMap.close()
	gui.Enabled = false
end

local function placeBeam(position: Vector3)
	local beam = Instance.new("Part")
	beam.Name = "GuideBeam"
	beam.Shape = Enum.PartType.Cylinder
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = COLOR.Guide
	beam.Transparency = 0.35
	beam.Size = Vector3.new(GUIDE_HEIGHT, 6, 6)
	beam.CFrame = CFrame.new(position + Vector3.new(0, GUIDE_HEIGHT / 2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	beam.Parent = hop.localFolder
	guideBeam = beam
	SkyMap.close()
end

-- 그 주민(또는 보스 받침대) 위로 빛기둥을 세운다 (이 플레이어에게만 보인다)
function SkyMap.guide(residentId: string)
	clearGuide()
	local position = targetPosition(residentId)
	if not position then
		return
	end
	placeBeam(position)
	guideTarget = residentId
	ui.toast(t("MapGuiding", displayName(residentId)))
end

-- 주민이 아닌 장소(이야기 끝에 생긴 등대 등)로 안내한다
function SkyMap.guideAt(position: Vector3, name: string)
	clearGuide()
	placeBeam(position)
	guidePosition = position
	ui.toast(t("MapGuidingPlace", name))
end

-- 보스 핀을 골랐을 때: 열렸으면 의뢰처럼, 아직이면 종 게이지가 얼마나 남았는지
local function showBossDetail(boss, current)
	detailName.Text = string.format("%s · %s", t(boss.name), t("Island_" .. boss.island))
	local record = current[boss.id]
	if not RequestLogic.isAvailable(boss, current, Requests) then
		local done, needed = RequestLogic.bellGauge(Requests, boss.chapter, current)
		detailState.Text = t("MapStateLocked")
		detailState.TextColor3 = COLOR.locked
		detailGoal.Text = t("BossLocked", done, needed)
	else
		if not record then
			detailState.Text = t("MapStateNew")
			detailState.TextColor3 = COLOR.new
		elseif record.medal ~= "gold" then
			detailState.Text = t("MapStateImprove", t(MEDAL_KEY[record.medal]))
			detailState.TextColor3 = COLOR[record.medal]
		else
			detailState.Text = t("MapStateDone")
			detailState.TextColor3 = COLOR.gold
		end
		detailGoal.Text = t("Req_" .. boss.id .. "_Goal")
	end
	guideButton.Visible = true
end

local function showDetail()
	local current = progress()
	if not selected then
		detailName.Text = ""
		detailState.Text = ""
		detailGoal.Text = t("MapPick")
		guideButton.Visible = false
		closeButton.Position = UDim2.fromOffset(0, 196)
		return
	end
	closeButton.Position = UDim2.fromOffset(138, 196)
	local boss = bossOf(selected)
	if boss then
		showBossDetail(boss, current)
		return
	end
	local resident = residentSpec(selected)
	local state = RequestLogic.residentState(Requests, selected, current)
	detailName.Text = string.format("%s · %s", selected, t("Island_" .. resident.island))
	local request = RequestLogic.nextFor(Requests, selected, current)
	if state == "new" then
		detailState.Text = t("MapStateNew")
		detailState.TextColor3 = COLOR.new
	elseif state == "improve" then
		local medal = current[request.id].medal
		detailState.Text = t("MapStateImprove", t(MEDAL_KEY[medal]))
		detailState.TextColor3 = COLOR[medal]
	elseif state == "done" then
		detailState.Text = t("MapStateDone")
		detailState.TextColor3 = COLOR.gold
	else
		detailState.Text = t("MapStateLocked")
		detailState.TextColor3 = COLOR.locked
	end
	detailGoal.Text = if request then t("Req_" .. request.id .. "_Goal") else ""
	guideButton.Visible = true
end

-- 주민 핀 색: 새 의뢰는 노란 "!", 그 밖에는 그 주민 의뢰의 가장 낮은 메달 색.
-- 보스 핀: 열렸으면 주홍 "!", 아직이면 먹구름색, 이겼으면 그 메달 색
local function pinLook(residentId: string, current): (Color3, string)
	local boss = bossOf(residentId)
	if boss then
		local record = current[boss.id]
		if record then
			return COLOR[record.medal], ""
		end
		return if RequestLogic.isAvailable(boss, current, Requests) then COLOR.boss else COLOR.storm,
			if RequestLogic.isAvailable(boss, current, Requests) then "!" else ""
	end
	local state = RequestLogic.residentState(Requests, residentId, current)
	if state == "new" then
		return COLOR.new, "!"
	elseif state == "locked" then
		return COLOR.locked, ""
	end
	local lowest = "gold"
	for _, request in Requests.Requests do
		local record = request.resident == residentId and current[request.id]
		if record and MEDAL_RANK[record.medal] < MEDAL_RANK[lowest] then
			lowest = record.medal
		end
	end
	return COLOR[lowest], ""
end

local function redraw(mapSize: number)
	for _, inst in drawn do
		inst:Destroy()
	end
	table.clear(drawn)
	local current = progress()
	local entries = mapEntries()
	local position = fit(entries, mapSize, mapSize * 0.08)
	toMap = position
	local scale = (position(1000, 0) - position(0, 0)).X / 1000
	-- 터치 기기는 손가락으로 누를 만큼 키운다
	local minPin = if UserInputService.TouchEnabled then 26 else 18
	local pinSize = math.clamp(math.floor(mapSize * 0.06), minPin, 28)

	for _, e in entries do
		local center = position(e.x, e.z)
		local radius = if e.upcoming
			then math.max(e.radius * scale, mapSize * 0.05)
			else math.max(e.radius * scale, mapSize * 0.1)
		local circle = Instance.new("Frame")
		circle.AnchorPoint = Vector2.new(0.5, 0.5)
		circle.Position = UDim2.fromOffset(center.X, center.Y)
		circle.Size = UDim2.fromOffset(radius * 2, radius * 2)
		circle.BackgroundColor3 = if e.upcoming then COLOR.Upcoming elseif e.chapter then COLOR.Island else COLOR.Hub
		circle.BackgroundTransparency = if e.upcoming then 0.35 else 0
		rounded(circle, UDim.new(0.5, 0))
		-- 되살린 섬은 금빛 테두리
		local restored = e.chapter ~= nil and not e.upcoming and RequestLogic.isRestored(Requests, e.chapter, current)
		local rim = Instance.new("UIStroke")
		rim.Color = if restored then COLOR.gold else COLOR.Rim
		rim.Thickness = if e.upcoming then 1 elseif restored then 4 else 2
		rim.Transparency = if e.upcoming then 0.6 else 0.1
		rim.Parent = circle
		circle.Parent = mapArea
		table.insert(drawn, circle)

		local lines = { t("Island_" .. e.id) }
		if e.upcoming then
			table.insert(lines, t("MapUpcoming"))
		else
			-- 숨은 별조각: 찾은 개수 (어디 있는지는 알려 주지 않는다)
			local found, total = CollectibleLogic.islandProgress(Collectibles, e.id, shardsFound())
			if total > 0 then
				table.insert(lines, t("MapShards", found, total))
			end
			if restored then
				table.insert(lines, t("MapRestored"))
			end
		end
		local caption = label(mapArea, {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromOffset(center.X, center.Y + radius + 2),
			Size = UDim2.fromOffset(150, 17 * #lines),
			TextSize = if e.upcoming then 12 else 15,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if e.upcoming then COLOR.Soft else COLOR.Text,
			Text = table.concat(lines, "\n"),
		})
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1.5
		stroke.Color = COLOR.Backdrop
		stroke.Parent = caption
		table.insert(drawn, caption)

		if not e.upcoming then
			-- 주민 핀: 섬 안의 실제 자리에서 출발해 겹치지 않게 벌린다
			local residents, points = {}, {}
			local island = islandSpec(e.id)
			for _, resident in Requests.Residents do
				if resident.island == e.id then
					table.insert(residents, resident)
					local offset = Vector2.new(resident.x, resident.z) / island.radius * (radius - pinSize / 2)
					table.insert(points, center + offset)
				end
			end
			-- 장 보스 핀은 섬 가운데(정상)에. 섬을 되살리면 금빛 테두리가 대신한다
			local chapterSpec = e.chapter and Requests.Chapters[e.chapter]
			if chapterSpec and chapterSpec.boss and not restored then
				table.insert(residents, { id = chapterSpec.boss })
				table.insert(points, center)
			end
			spread(points, pinSize + 4)
			for i, resident in residents do
				local color, mark = pinLook(resident.id, current)
				local pin = Instance.new("TextButton")
				pin.Name = "Pin_" .. resident.id
				pin.AnchorPoint = Vector2.new(0.5, 0.5)
				pin.Position = UDim2.fromOffset(points[i].X, points[i].Y)
				pin.Size = UDim2.fromOffset(pinSize, pinSize)
				pin.BackgroundColor3 = color
				pin.Font = Enum.Font.FredokaOne
				pin.Text = mark
				pin.TextColor3 = COLOR.Ink
				pin.TextSize = pinSize - 4
				pin.ZIndex = 3
				rounded(pin, UDim.new(0.5, 0))
				local ring = Instance.new("UIStroke")
				ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				ring.Thickness = if selected == resident.id then 3 else 1.5
				ring.Color = if selected == resident.id then COLOR.Rim else COLOR.Ink
				ring.Parent = pin
				pin.Activated:Connect(function()
					selected = resident.id
					redraw(mapSize)
				end)
				pin.Parent = mapArea
				table.insert(drawn, pin)
			end
		end
	end

	local lines = {}
	for chapter, spec in Requests.Chapters do
		local bell, needed = RequestLogic.bellGauge(Requests, chapter, current)
		local done, total = RequestLogic.chapterCount(Requests, chapter, current)
		local title = t("MapChapter", chapter, t("Island_" .. spec.island))
		if RequestLogic.isRestored(Requests, chapter, current) then
			title ..= " · " .. t("MapRestored")
		end
		table.insert(lines, title)
		table.insert(lines, t("MapChapterProgress", bell, needed, done, total))
	end
	chapterLabel.Text = table.concat(lines, "\n")
	showDetail()
end

-- 화면 크기에 맞춘 배치. 가로 화면은 지도 왼쪽·설명 오른쪽, 세로 화면은 지도 위·설명 아래.
-- 목표 문장은 설명 칸 맨 위에 두어 짧은 가로 화면(휴대폰)에서도 지도를 크게 쓴다
local HEADER = 46
local SIDE_HEIGHT = 236

local function layout(): number
	-- 화면 위쪽 Roblox 버튼 줄은 비워 둔다 (IgnoreGuiInset = false)
	local camera = workspace.CurrentCamera
	local topLeft, bottomRight = GuiService:GetGuiInset()
	local viewport = (if camera then camera.ViewportSize else Vector2.new(1280, 720)) - topLeft - bottomRight
	local portrait = viewport.Y > viewport.X
	local width, height, mapSize
	if portrait then
		width = math.min(480, viewport.X - 16)
		height = math.min(viewport.Y - 16, HEADER + (width - 24) + 12 + SIDE_HEIGHT + 12)
		mapSize = math.min(width - 24, height - HEADER - SIDE_HEIGHT - 24)
		mapArea.Position = UDim2.fromOffset((width - mapSize) / 2, HEADER)
		side.Position = UDim2.fromOffset(16, HEADER + mapSize + 12)
		side.Size = UDim2.fromOffset(width - 32, SIDE_HEIGHT)
	else
		width = math.min(780, viewport.X - 24)
		height = math.min(500, viewport.Y - 16)
		mapSize = height - HEADER - 12
		local sideWidth = width - mapSize - 40
		if sideWidth < 220 then
			mapSize = width - 40 - 220
			sideWidth = 220
		end
		mapArea.Position = UDim2.fromOffset(12, HEADER)
		side.Position = UDim2.fromOffset(28 + mapSize, HEADER)
		side.Size = UDim2.fromOffset(sideWidth, mapSize)
	end
	window.Size = UDim2.fromOffset(width, height)
	mapArea.Size = UDim2.fromOffset(mapSize, mapSize)
	return mapSize
end

function SkyMap.open()
	if not unlocked then
		ui.toast(t("MapLockedHint"))
		return
	end
	gui.Enabled = true
	redraw(layout())
end

function SkyMap.toggle()
	if gui.Enabled then
		SkyMap.close()
	else
		SkyMap.open()
	end
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopMap"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.DisplayOrder = 8
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- 바깥을 누르면 닫힌다
	local backdrop = Instance.new("TextButton")
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.BackgroundColor3 = COLOR.Backdrop
	backdrop.BackgroundTransparency = 0.45
	backdrop.Text = ""
	backdrop.AutoButtonColor = false
	backdrop.Parent = gui
	backdrop.Activated:Connect(SkyMap.close)

	window = Instance.new("Frame")
	window.Name = "Window"
	window.AnchorPoint = Vector2.new(0.5, 0.5)
	window.Position = UDim2.fromScale(0.5, 0.5)
	window.BackgroundColor3 = COLOR.Panel
	window.BackgroundTransparency = 0.05
	window.Active = true
	rounded(window, UDim.new(0, 16))
	window.Parent = gui

	label(window, {
		Position = UDim2.fromOffset(16, 10),
		Size = UDim2.new(1, -32, 0, 30),
		TextSize = 26,
		Text = t("MapTitle"),
	})
	mapArea = Instance.new("Frame")
	mapArea.Name = "Map"
	mapArea.BackgroundColor3 = COLOR.Sky
	mapArea.ClipsDescendants = true
	rounded(mapArea, UDim.new(0, 12))
	mapArea.Parent = window

	you = Instance.new("Frame")
	you.Name = "You"
	you.AnchorPoint = Vector2.new(0.5, 0.5)
	you.Size = UDim2.fromOffset(14, 14)
	you.BackgroundColor3 = COLOR.Rim
	you.ZIndex = 4
	rounded(you, UDim.new(0.5, 0))
	local youRing = Instance.new("UIStroke")
	youRing.Thickness = 2
	youRing.Color = COLOR.Ink
	youRing.Parent = you
	local facing = Instance.new("Frame")
	facing.AnchorPoint = Vector2.new(0.5, 1)
	facing.Position = UDim2.fromScale(0.5, 0.5)
	facing.Size = UDim2.fromOffset(4, 16)
	facing.BackgroundColor3 = COLOR.Ink
	facing.BorderSizePixel = 0
	facing.ZIndex = 5
	facing.Parent = you
	you.Parent = mapArea

	side = Instance.new("Frame")
	side.Name = "Side"
	side.BackgroundTransparency = 1
	side.Parent = window
	label(side, {
		Size = UDim2.new(1, 0, 0, 40),
		TextSize = 14,
		TextColor3 = COLOR.Soft,
		Text = t("MapGoal"),
	})
	chapterLabel = label(side, { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 44), TextSize = 16 })
	detailName = label(side, { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 24), TextSize = 20 })
	detailState = label(side, { Position = UDim2.fromOffset(0, 124), Size = UDim2.new(1, 0, 0, 20), TextSize = 15 })
	detailGoal = label(side, {
		Position = UDim2.fromOffset(0, 146),
		Size = UDim2.new(1, 0, 0, 44),
		TextSize = 15,
		TextColor3 = COLOR.Soft,
	})
	guideButton = button(side, t("MapGuide"), COLOR.Accept)
	guideButton.Name = "GuideButton"
	guideButton.Position = UDim2.fromOffset(0, 196)
	guideButton.Size = UDim2.fromOffset(128, 36)
	guideButton.Activated:Connect(function()
		if selected then
			SkyMap.guide(selected)
		end
	end)
	closeButton = button(side, t("MapClose"), COLOR.Close)
	closeButton.Name = "CloseButton"
	closeButton.Position = UDim2.fromOffset(138, 196)
	closeButton.Size = UDim2.fromOffset(96, 36)
	closeButton.Activated:Connect(SkyMap.close)
end

-- 막 열렸을 때만 알린다 (이미 열린 플레이어가 들어올 때는 조용히 연다)
local function refreshUnlock()
	if type(player:GetAttribute("RequestProgress")) ~= "string" then
		return
	end
	local now = RequestLogic.isMapUnlocked(Requests, progress())
	if now and not unlocked and loaded then
		ui.toast(t("MapUnlocked"))
	end
	unlocked = now
	loaded = true
end

local function attachPrompt(prompt: Instance)
	if prompt:IsA("ProximityPrompt") and prompt:GetAttribute("SkyMap") then
		prompt.ActionText = t("MapView")
		prompt.ObjectText = t("MapTitle")
	end
end

function SkyMap.start(hopController, requestUi)
	hop = hopController
	ui = requestUi
	build()

	refreshUnlock()
	player:GetAttributeChangedSignal("RequestProgress"):Connect(function()
		refreshUnlock()
		if gui.Enabled then
			redraw(layout())
		end
	end)
	player:GetAttributeChangedSignal("Shards"):Connect(function()
		if gui.Enabled then
			redraw(layout())
		end
	end)

	for _, inst in workspace:GetDescendants() do
		attachPrompt(inst)
	end
	workspace.DescendantAdded:Connect(attachPrompt)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt:GetAttribute("SkyMap") then
			SkyMap.open()
		elseif
			guideTarget
			and (prompt:GetAttribute("Resident") == guideTarget or prompt:GetAttribute("Boss") == guideTarget)
		then
			clearGuide()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			SkyMap.toggle()
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if gui.Enabled then
				redraw(layout())
			end
		end)
	end

	RunService.RenderStepped:Connect(function()
		local root = hop.rootPart()
		if (guideTarget or guidePosition) and root then
			local target = if guideTarget then targetPosition(guideTarget) else guidePosition
			if target and (root.Position - target).Magnitude <= GUIDE_CLEAR_DISTANCE then
				clearGuide()
			end
		end
		if gui.Enabled and root and toMap then
			-- 내 위치와 카메라가 보는 방향 (위쪽이 -Z)
			local at = toMap(root.Position.X, root.Position.Z)
			local size = mapArea.Size.X.Offset
			you.Position = UDim2.fromOffset(math.clamp(at.X, 8, size - 8), math.clamp(at.Y, 8, size - 8))
			local look = workspace.CurrentCamera.CFrame.LookVector
			you.Rotation = math.deg(math.atan2(look.X, -look.Z))
		end
	end)
end

return SkyMap
]]></ProtectedString>
						<string name="ScriptGuid">{85422980-8166-4BB9-8AF8-2EBB422DB4C9}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">SkyMap</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0009fd8d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX48B67B9BD4E84496B711FFE4244391F2">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 클라우드 러시 화면 (GDD 7.2, 13): 대기 중에는 구석의 작은 참가 버튼, 참가했거나 탑 위에 있으면
-- 위쪽 가운데 띠(남은 시간·남은 사람·해일까지 거리), 결과 창.
-- 작은 버튼은 튜토리얼을 끝낸 뒤(하늘 지도가 열린 뒤)에만 보인다. 첫 접속에서는 핍의 첫 의뢰에 집중하게 한다.
-- 해일은 서버 시간과 Config로 각자 계산해 부드럽게 그린다 (탈락 판정은 서버 RoundService)
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local RequestLogic = require(ReplicatedStorage.Shared.RequestLogic)
local Requests = require(ReplicatedStorage.Config.Requests)
local Rush = require(ReplicatedStorage.Config.Rush)
local RushLogic = require(ReplicatedStorage.Shared.RushLogic)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local COLOR = {
	Panel = Color3.fromRGB(24, 34, 58),
	Text = Color3.fromRGB(255, 255, 255),
	Soft = Color3.fromRGB(200, 214, 240),
	Join = Color3.fromRGB(96, 186, 120),
	Leave = Color3.fromRGB(90, 100, 130),
	Danger = Color3.fromRGB(255, 120, 120),
	Gold = Color3.fromRGB(255, 205, 60),
	Stroke = Color3.fromRGB(40, 60, 90),
	-- 아래 흰 구름 바다와 구분되게 연보랏빛 회색 폭풍 구름으로 (2026-11-04 Studio 확인)
	Tide = Color3.fromRGB(172, 164, 214),
	TidePuff = Color3.fromRGB(198, 192, 232),
}
-- 탑(허브에서 380)과 허브 가장자리(170) 사이에서 멈춘다. 900이면 허브 하늘까지 덮었다
local TIDE_DIAMETER = 400
local TIDE_WARNING = 30 -- 해일이 발밑 이 거리 안이면 빨갛게
local TIDE_PUFFS = 12

local RushHud = {}

local function t(key: string, ...: any): string
	return Strings.get(player.LocaleId, key, ...)
end

local function clock(seconds: number): string
	local whole = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

local function rounded(inst: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
end

local function label(parent: Instance, props: { [string]: any }): TextLabel
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.FredokaOne
	text.TextColor3 = COLOR.Text
	text.TextWrapped = true
	for key, value in props do
		(text :: any)[key] = value
	end
	text.Parent = parent
	return text
end

-- 구름 해일: 탑을 둘러싼 넓은 원판과 그 위의 솜뭉치 (이 클라이언트에만)
local function buildTide(): (BasePart, { BasePart })
	local folder = Instance.new("Folder")
	folder.Name = "RushLocal"
	folder.Parent = workspace
	local function cloudPart(props: { [string]: any }): Part
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = COLOR.Tide
		for key, value in props do
			(p :: any)[key] = value
		end
		p.Parent = folder
		return p
	end
	local tide = cloudPart({
		Name = "Tide",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(8, TIDE_DIAMETER, TIDE_DIAMETER),
	})
	local puffs = {}
	for i = 1, TIDE_PUFFS do
		local size = 50 + (i % 4) * 22
		local puff = cloudPart({
			Name = "TidePuff",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(size, size * 0.45, size),
			Color = COLOR.TidePuff,
		})
		puff:SetAttribute("Angle", i / TIDE_PUFFS * math.pi * 2)
		puff:SetAttribute("Radius", 70 + (i * 53) % 120)
		table.insert(puffs, puff)
	end
	return tide, puffs
end

function RushHud.start(hop, ui, requestController, skyCamera)
	local state = ReplicatedStorage:WaitForChild("RushState")
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local joinRemote = remotes:WaitForChild(Remotes.RushJoin) :: RemoteEvent
	local resultRemote = remotes:WaitForChild(Remotes.RushResult) :: RemoteEvent
	local stompRemote = remotes:WaitForChild(Remotes.RushStomp) :: RemoteEvent
	local stompedRemote = remotes:WaitForChild(Remotes.RushStomped) :: RemoteEvent

	-- 라이벌 밟기: 탑 위에서 다른 참가자의 머리를 밟으면 서버에 알린다 (밟힌 쪽 효과는 서버가 확인한 뒤 보낸다)
	hop.onBounce:Connect(function(kind, _, _, part)
		if kind ~= "buddy" or not part or player:GetAttribute("RushRunning") ~= true then
			return
		end
		local model = part:FindFirstAncestorOfClass("Model")
		local victim = model and Players:GetPlayerFromCharacter(model)
		if victim then
			stompRemote:FireServer(victim)
		end
	end)
	stompedRemote.OnClientEvent:Connect(function(seconds, jumpsLost)
		if type(seconds) == "number" and type(jumpsLost) == "number" then
			hop.stagger(seconds, jumpsLost)
		end
	end)

	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopRush"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false -- Hud와 같은 기준 (고도·최고·아래 거리 표시 바로 밑에 띠를 둔다)
	gui.DisplayOrder = 4
	gui.Parent = player:WaitForChild("PlayerGui")

	-- 고도 표시 아래의 띠: 상태 한두 줄 + 참가 버튼
	local banner = Instance.new("Frame")
	banner.Name = "Banner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, 116)
	banner.BackgroundColor3 = COLOR.Panel
	banner.BackgroundTransparency = 0.25
	rounded(banner, 12)
	banner.Parent = gui
	local bannerText = label(banner, {
		Position = UDim2.fromOffset(12, 4),
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	local bannerSub = label(banner, {
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -24, 0, 18),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = COLOR.Soft,
	})
	local joinButton = Instance.new("TextButton")
	joinButton.Name = "JoinButton"
	joinButton.AnchorPoint = Vector2.new(1, 0.5)
	joinButton.Position = UDim2.new(1, -6, 0.5, 0)
	joinButton.Size = UDim2.fromOffset(78, 32)
	joinButton.Font = Enum.Font.FredokaOne
	joinButton.TextSize = 17
	joinButton.TextColor3 = COLOR.Text
	rounded(joinButton, 10)
	joinButton.Parent = banner
	joinButton.Activated:Connect(function()
		joinRemote:FireServer(not player:GetAttribute("RushJoined"))
	end)

	-- 대기 중 작은 참가 버튼 (누르면 바로 참가하고, 그때부터 위쪽 띠가 보인다)
	local pill = Instance.new("TextButton")
	pill.Name = "RushPill"
	pill.BackgroundColor3 = COLOR.Panel
	pill.BackgroundTransparency = 0.2
	pill.Font = Enum.Font.FredokaOne
	pill.TextSize = 16
	pill.TextColor3 = COLOR.Text
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.Size = UDim2.fromOffset(0, 34)
	pill.Visible = false
	rounded(pill, 17)
	local pillPadding = Instance.new("UIPadding")
	pillPadding.PaddingLeft = UDim.new(0, 14)
	pillPadding.PaddingRight = UDim.new(0, 14)
	pillPadding.Parent = pill
	local pillStroke = Instance.new("UIStroke")
	pillStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	pillStroke.Color = COLOR.Join
	pillStroke.Thickness = 2
	pillStroke.Parent = pill
	pill.Parent = gui
	pill.Activated:Connect(function()
		joinRemote:FireServer(true)
	end)

	-- 튜토리얼을 끝냈는가 (하늘 지도와 같은 조건)
	local unlocked = false
	local function refreshUnlock()
		local raw = player:GetAttribute("RequestProgress")
		local ok, progress = pcall(HttpService.JSONDecode, HttpService, if type(raw) == "string" then raw else "{}")
		unlocked = ok and RequestLogic.isMapUnlocked(Requests, progress)
	end
	refreshUnlock()
	player:GetAttributeChangedSignal("RequestProgress"):Connect(refreshUnlock)

	-- 화면 가운데 큰 글씨 (카운트다운, 출발)
	local center = label(gui, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(600, 70),
		TextSize = 44,
		TextColor3 = COLOR.Gold,
		Visible = false,
	})
	local centerStroke = Instance.new("UIStroke")
	centerStroke.Thickness = 3
	centerStroke.Color = COLOR.Stroke
	centerStroke.Parent = center

	-- 결과 창
	local result = Instance.new("Frame")
	result.Name = "Result"
	result.AnchorPoint = Vector2.new(0.5, 0.5)
	result.Position = UDim2.fromScale(0.5, 0.45)
	result.BackgroundColor3 = COLOR.Panel
	result.BackgroundTransparency = 0.1
	result.Visible = false
	rounded(result, 14)
	result.Parent = gui
	label(result, {
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 30),
		TextSize = 26,
		Text = t("RushResultTitle"),
	})
	local resultRank = label(result, {
		Position = UDim2.fromOffset(0, 48),
		Size = UDim2.new(1, 0, 0, 40),
		TextSize = 34,
		TextColor3 = COLOR.Gold,
	})
	local resultDetail = label(result, {
		Position = UDim2.fromOffset(16, 94),
		Size = UDim2.new(1, -32, 0, 80),
		TextSize = 18,
		TextColor3 = COLOR.Soft,
	})
	local resultToken = 0
	resultRemote.OnClientEvent:Connect(function(data)
		resultToken += 1
		local token = resultToken
		resultRank.Text = t("RushResultRank", data.rank, data.total)
		local lines = { t("RushResultHeight", data.height), t("ResultCoins", data.coins) }
		if data.rang then
			table.insert(lines, 1, t("RushResultBell"))
		end
		resultDetail.Text = table.concat(lines, "\n")
		result.Visible = true
		task.delay(Rush.ResultsSeconds, function()
			if token == resultToken then
				result.Visible = false
			end
		end)
	end)

	-- 세로 터치 화면은 오른쪽 버튼 줄(지도·시점·기록)을 피해 왼쪽에 두고 두 줄로 접는다
	local function layout()
		local camera = workspace.CurrentCamera
		local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local narrow = UserInputService.TouchEnabled and viewport.Y > viewport.X
		if narrow then
			banner.AnchorPoint = Vector2.new(0, 0)
			banner.Position = UDim2.fromOffset(12, 116)
			banner.Size = UDim2.fromOffset(viewport.X - 124, 64)
			bannerText.Size = UDim2.new(1, -100, 0, 38)
			bannerText.TextSize = 15
			bannerSub.Position = UDim2.fromOffset(12, 42)
			bannerSub.TextSize = 14
		else
			banner.AnchorPoint = Vector2.new(0.5, 0)
			banner.Position = UDim2.new(0.5, 0, 0, 116)
			banner.Size = UDim2.fromOffset(math.min(400, viewport.X - 24), 50)
			bannerText.Size = UDim2.new(1, -110, 0, 22)
			bannerText.TextSize = 17
			bannerSub.Position = UDim2.fromOffset(12, 26)
			bannerSub.TextSize = 15
		end
		bannerSub.Size = UDim2.new(1, -110, 0, 18)
		-- 작은 버튼: PC는 왼쪽 위 시점·마커 표시 아래, 터치는 왼쪽 위 (의뢰 중에는 그 자리를 의뢰 진행 표시가 쓰고 버튼은 숨는다)
		local touch = UserInputService.TouchEnabled
		pill.Position = if not touch
			then UDim2.fromOffset(12, 58)
			elseif narrow then UDim2.fromOffset(12, 118)
			else UDim2.fromOffset(12, 8)
		result.Size = UDim2.fromOffset(math.min(340, viewport.X - 24), 186)
		center.Size = UDim2.fromOffset(math.min(600, viewport.X - 24), 70)
		center.TextSize = if viewport.X < 600 then 32 else 44
	end
	layout()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
	end

	local tide, puffs = buildTide()
	local hiddenCFrame = CFrame.new(0, -5000, 0)
	local function placeTide(y: number?)
		if not y then
			tide.CFrame = hiddenCFrame
			for _, puff in puffs do
				puff.CFrame = hiddenCFrame
			end
			return
		end
		local origin = Rush.TowerOrigin
		tide.CFrame = CFrame.new(origin[1], y - 4, origin[3]) * CFrame.Angles(0, 0, math.rad(90))
		local wobble = os.clock() * 0.3
		for _, puff in puffs do
			local angle = puff:GetAttribute("Angle") + wobble * 0.05
			local radius = puff:GetAttribute("Radius")
			puff.CFrame = CFrame.new(
				origin[1] + math.cos(angle) * radius,
				y + math.sin(wobble + angle * 3) * 2,
				origin[3] + math.sin(angle) * radius
			)
		end
	end
	placeTide(nil)

	-- 탑에 올라가면 하던 의뢰를 그만두고, 진행 중에 내려오면(해일에 잠기면) 알린다
	local lastPhase = state:GetAttribute("Phase")
	player:GetAttributeChangedSignal("RushRunning"):Connect(function()
		if player:GetAttribute("RushRunning") then
			requestController.cancelActive()
			-- 서버가 옮긴 위치가 도착한 뒤 탑 가운데를 보게 한다
			task.delay(0.3, function()
				local root = hop.rootPart()
				if root then
					local origin = Rush.TowerOrigin
					skyCamera.faceToward(Vector3.new(origin[1], root.Position.Y, origin[3]))
				end
			end)
		elseif state:GetAttribute("Phase") == "Running" then
			ui.toast(t("RushOut"))
		end
	end)

	local goUntil = 0
	RunService.RenderStepped:Connect(function()
		local phase = state:GetAttribute("Phase")
		local now = workspace:GetServerTimeNow()
		local left = math.max(0, math.ceil((state:GetAttribute("PhaseEndsAt") or now) - now))
		local running = player:GetAttribute("RushRunning") == true
		local joined = player:GetAttribute("RushJoined") == true
		local alive = state:GetAttribute("Alive") or 0

		if phase ~= lastPhase then
			if phase == "Running" and running then
				goUntil = os.clock() + 1.6
			end
			lastPhase = phase
		end

		local main, sub, subColor = "", "", COLOR.Soft
		if phase == "Lobby" then
			main = if joined then t("RushJoined", left) else t("RushLobby", left)
		elseif phase == "Countdown" then
			main = if running then t("RushCountdown", left) else t("RushStarting")
		elseif phase == "Running" then
			local elapsed = now - (state:GetAttribute("StartedAt") or now)
			if running then
				main = t("RushRunning", clock(elapsed), alive)
				local tideIn = Rush.TideDelay - elapsed
				if tideIn > 0 then
					sub = t("RushTideIn", math.ceil(tideIn))
				else
					local tideY = (state:GetAttribute("TowerBaseY") or 0) + RushLogic.tideHeight(Rush, elapsed)
					local root = hop.rootPart()
					local gap = if root then math.floor(hop.feetPosition().Y - tideY) else 0
					sub = t("RushTideBelow", math.max(0, gap))
					if gap < TIDE_WARNING then
						subColor = COLOR.Danger
					end
				end
			else
				main = t("RushWatching", alive)
			end
		elseif phase == "Results" then
			main = t("RushResults")
		end
		bannerText.Text = main
		bannerSub.Text = sub
		bannerSub.TextColor3 = subColor
		-- 큰 띠는 참가했거나 탑 위에 있을 때만. 그 밖의 대기 중에는 구석의 작은 버튼만 (튜토리얼을 끝낸 뒤)
		-- 의뢰 중이거나 대화창·엔딩 카드가 떠 있으면 둘 다 숨긴다 (탑 위에 있을 때는 의뢰가 이미 취소됐다)
		local busy = requestController.isActive() or ui.isBusy()
		banner.Visible = phase ~= nil and (running or (joined and not busy))
		pill.Visible = phase == "Lobby" and not joined and not running and unlocked and not busy
		if pill.Visible then
			pill.Text = t("RushPill", left)
		end
		joinButton.Visible = not running
		joinButton.Text = if joined then t("RushLeave") else t("RushJoin")
		joinButton.BackgroundColor3 = if joined then COLOR.Leave else COLOR.Join

		if phase == "Countdown" and running then
			center.Text = t("RushCountdown", left)
			center.Visible = true
		elseif os.clock() < goUntil then
			center.Text = t("RushGo")
			center.Visible = true
		else
			center.Visible = false
		end

		if phase == "Running" or phase == "Results" then
			local startedAt = state:GetAttribute("StartedAt") or now
			placeTide((state:GetAttribute("TowerBaseY") or 0) + RushLogic.tideHeight(Rush, now - startedAt))
		else
			placeTide(nil)
		end
	end)
end

return RushHud
]]></ProtectedString>
						<string name="ScriptGuid">{ADBBC528-ABA6-4447-AC9F-D54BB9CB7BB5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">RushHud</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc000ce95d</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX94AEFA652037467C9CB46B1766A993C5">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 의뢰 목표 표시 (GDD 6.4): 남은 목표 위에 아이콘과 거리, 가장 가까운 목표가 화면 밖이면 그쪽 가장자리에 화살표.
-- 이 클라이언트에만 그린다. 숨은 수집품처럼 찾는 재미가 핵심인 것에는 쓰지 않는다
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local COLOR = {
	Icon = Color3.fromRGB(255, 205, 60),
	Stroke = Color3.fromRGB(70, 46, 20),
	Text = Color3.fromRGB(255, 255, 255),
	TextStroke = Color3.fromRGB(40, 60, 90),
	Badge = Color3.fromRGB(30, 40, 62),
}
local NEAR = 16 -- 이보다 가까우면 표시를 숨겨 목표물 자체를 보게 한다
local LIFT = 5 -- 목표 위로 띄우는 높이
local EDGE_MARGIN = 48 -- 화면 밖 화살표가 가장자리에서 떨어진 거리(px)

type Mark = { position: Vector3, billboard: BillboardGui, label: TextLabel }

local Waypoints = {}

local hop
local anchor: Part
local arrow: Frame
local arrowLabel: TextLabel
local marks: { Mark } = {}

local function stroke(parent: GuiObject, color: Color3, thickness: number)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
end

local function distanceLabel(parent: Instance): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 15
	label.TextColor3 = COLOR.Text
	label.TextStrokeColor3 = COLOR.TextStroke
	label.TextStrokeTransparency = 0
	label.Parent = parent
	return label
end

local function diamond(parent: Instance, size: number, y: number)
	local icon = Instance.new("Frame")
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.new(0.5, 0, 0, y)
	icon.Size = UDim2.fromOffset(size, size)
	icon.Rotation = 45
	icon.BackgroundColor3 = COLOR.Icon
	icon.BorderSizePixel = 0
	stroke(icon, COLOR.Stroke, 2)
	icon.Parent = parent
end

-- 목표 위치 목록을 통째로 바꾼다 (빈 목록이면 모두 지운다)
function Waypoints.set(positions: { Vector3 })
	for _, mark in marks do
		mark.billboard.Parent:Destroy()
	end
	table.clear(marks)
	for _, position in positions do
		local attachment = Instance.new("Attachment")
		attachment.Position = position + Vector3.new(0, LIFT, 0) -- anchor가 원점이라 월드 좌표와 같다
		attachment.Parent = anchor
		local billboard = Instance.new("BillboardGui")
		billboard.AlwaysOnTop = true
		billboard.LightInfluence = 0
		billboard.MaxDistance = math.huge
		billboard.Size = UDim2.fromOffset(64, 46)
		billboard.Parent = attachment
		diamond(billboard, 16, 12)
		local label = distanceLabel(billboard)
		label.Position = UDim2.fromOffset(0, 24)
		label.Size = UDim2.new(1, 0, 0, 18)
		table.insert(marks, { position = position, billboard = billboard, label = label })
	end
	if #marks == 0 then
		arrow.Visible = false
		arrowLabel.Visible = false
	end
end

function Waypoints.clear()
	Waypoints.set({})
end

local function meters(d: number): string
	return string.format("%d m", math.floor(d + 0.5))
end

-- 화면 밖 목표 쪽 가장자리 표시: 원 위로 뾰족한 끝이 튀어나온 핀 모양을 목표 쪽으로 돌린다.
-- 꺾쇠(^)를 쓰면 기울었을 때 "7"이나 모서리처럼 읽혔다
local function buildArrow(gui: ScreenGui)
	arrow = Instance.new("Frame")
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Size = UDim2.fromOffset(44, 44)
	arrow.BackgroundTransparency = 1
	arrow.Visible = false
	arrow.Parent = gui
	-- 원 뒤에 놓은 마름모의 윗부분만 보여 끝이 된다 (형제 ZIndex로 순서를 정한다)
	local tip = Instance.new("Frame")
	tip.AnchorPoint = Vector2.new(0.5, 0.5)
	tip.Position = UDim2.new(0.5, 0, 0, 6)
	tip.Size = UDim2.fromOffset(18, 18)
	tip.Rotation = 45
	tip.BackgroundColor3 = COLOR.Icon
	tip.BorderSizePixel = 0
	tip.ZIndex = 1
	stroke(tip, COLOR.Stroke, 2)
	tip.Parent = arrow
	local disc = Instance.new("Frame")
	disc.AnchorPoint = Vector2.new(0.5, 0.5)
	disc.Position = UDim2.new(0.5, 0, 0.5, 3)
	disc.Size = UDim2.fromOffset(34, 34)
	disc.BackgroundColor3 = COLOR.Badge
	disc.BorderSizePixel = 0
	disc.ZIndex = 2
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = disc
	stroke(disc, COLOR.Icon, 2)
	disc.Parent = arrow
	local dot = Instance.new("Frame")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(12, 12)
	dot.Rotation = 45
	dot.BackgroundColor3 = COLOR.Icon
	dot.BorderSizePixel = 0
	dot.ZIndex = 3
	dot.Parent = disc
	arrowLabel = distanceLabel(gui)
	arrowLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	arrowLabel.Size = UDim2.fromOffset(70, 20)
	arrowLabel.Visible = false
end

local function update()
	if #marks == 0 then
		return
	end
	local root = hop.rootPart()
	local camera = workspace.CurrentCamera
	if not (root and camera) then
		return
	end
	local nearest: Mark? = nil
	local nearestDistance = math.huge
	for _, mark in marks do
		local d = (mark.position - root.Position).Magnitude
		mark.billboard.Enabled = d > NEAR
		mark.label.Text = meters(d)
		if d < nearestDistance then
			nearest, nearestDistance = mark, d
		end
	end
	if not nearest then
		return
	end

	local point, onScreen = camera:WorldToViewportPoint(nearest.position + Vector3.new(0, LIFT, 0))
	if (onScreen and point.Z > 0) or nearestDistance <= NEAR then
		arrow.Visible = false
		arrowLabel.Visible = false
		return
	end
	-- 화면 가운데에서 목표 쪽으로 뻗은 방향이 가장자리 사각형과 만나는 곳 (카메라 뒤면 방향을 뒤집는다)
	local center = camera.ViewportSize / 2
	local direction = Vector2.new(point.X, point.Y) - center
	if point.Z < 0 then
		direction = -direction
	end
	direction = if direction.Magnitude > 1e-3 then direction.Unit else Vector2.new(0, -1)
	local half = center - Vector2.new(EDGE_MARGIN, EDGE_MARGIN)
	local reach =
		math.min(half.X / math.max(math.abs(direction.X), 1e-3), half.Y / math.max(math.abs(direction.Y), 1e-3))
	local at = center + direction * reach
	arrow.Position = UDim2.fromOffset(at.X, at.Y)
	arrow.Rotation = math.deg(math.atan2(direction.Y, direction.X)) + 90
	arrow.Visible = true
	local labelAt = at - direction * 34
	arrowLabel.Position = UDim2.fromOffset(labelAt.X, labelAt.Y)
	arrowLabel.Text = meters(nearestDistance)
	arrowLabel.Visible = true
end

function Waypoints.start(hopController)
	hop = hopController
	anchor = Instance.new("Part")
	anchor.Name = "WaypointAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.CFrame = CFrame.identity
	anchor.Parent = hop.localFolder

	-- 화살표는 화면 전체 좌표(WorldToViewportPoint)를 쓰므로 상단 인셋을 무시한다
	local gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopWaypoints"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 3
	gui.Parent = player:WaitForChild("PlayerGui")
	buildArrow(gui)

	RunService.RenderStepped:Connect(update)
end

return Waypoints
]]></ProtectedString>
						<string name="ScriptGuid">{30EEAA48-9B42-44E4-8106-C4E878959B9E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Waypoints</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">16cd9601f6d8de080afb8adc0013d6c9</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX85A846A550D340E68541FA9306C47259">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- 코인 상점 화면 (GDD 9.4): 궤적·부츠 탭, 색 미리보기 카드, 구매·장착. 판단은 서버 ShopService가 한다.
-- 허브 상점 가판대의 프롬프트(Shop 속성)나 B 키로 연다
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Collectibles = require(ReplicatedStorage.Config.Collectibles)
local Shop = require(ReplicatedStorage.Config.Shop)
local CollectibleLogic = require(ReplicatedStorage.Shared.CollectibleLogic)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Strings = require(ReplicatedStorage.Shared.Strings)

local player = Players.LocalPlayer

local COLOR = {
	Panel = Color3.fromRGB(24, 34, 58),
	Card = Color3.fromRGB(40, 54, 88),
	Preview = Color3.fromRGB(70, 110, 170),
	Text = Color3.fromRGB(255, 255, 255),
	Soft = Color3.fromRGB(200, 214, 240),
	Gold = Color3.fromRGB(255, 205, 60),
	Buy = Color3.fromRGB(240, 170, 50),
	Equip = Color3.fromRGB(96, 186, 120),
	Equipped = Color3.fromRGB(90, 150, 230),
	Locked = Color3.fromRGB(96, 104, 126),
	Tab = Color3.fromRGB(52, 66, 100),
	Fail = Color3.fromRGB(255, 150, 150),
}
local STATUS_SECONDS = 3

local ShopUi = {}

local gui: ScreenGui
local frame: Frame
local coinsLabel: TextLabel
local grid: ScrollingFrame
local gridLayout: UIGridLayout
local statusLabel: TextLabel
local tabButtons: { [string]: TextButton } = {}
local cards: { { item: any, button: TextButton } } = {}
local currentTab = Shop.Categories[1]
local busy = false
local statusToken = 0
local buyRemote: RemoteFunction
local equipRemote: RemoteFunction

local function t(key: string, ...: any): string
	return Strings.get(player.LocaleId, key, ...)
end

local function decode(name: string): { [string]: any }
	local raw = player:GetAttribute(name)
	if type(raw) ~= "string" then
		return {}
	end
	local ok, value = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(value) == "table" then value else {}
end

local function coins(): number
	local value = player:GetAttribute("Coins")
	return if type(value) == "number" then value else 0
end

local function rgb(c: { number }): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function rounded(inst: GuiObject, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = inst
end

local function box(parent: Instance, color: Color3, size: UDim2, position: UDim2, radius: number?): Frame
	local f = Instance.new("Frame")
	f.BackgroundColor3 = color
	f.BorderSizePixel = 0
	f.Size = size
	f.Position = position
	if radius then
		rounded(f, radius)
	end
	f.Parent = parent
	return f
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = COLOR.Text
	label.TextWrapped = true
	for key, value in props do
		(label :: any)[key] = value
	end
	label.Parent = parent
	return label
end

local function button(parent: Instance, color: Color3): TextButton
	local b = Instance.new("TextButton")
	b.BackgroundColor3 = color
	b.Font = Enum.Font.FredokaOne
	b.TextColor3 = COLOR.Text
	b.TextSize = 17
	b.AutoButtonColor = true
	rounded(b, 10)
	b.Parent = parent
	return b
end

local function status(message: string, color: Color3)
	statusToken += 1
	local token = statusToken
	statusLabel.Text = message
	statusLabel.TextColor3 = color
	task.delay(STATUS_SECONDS, function()
		if token == statusToken then
			statusLabel.Text = t("ShopNote")
			statusLabel.TextColor3 = COLOR.Soft
		end
	end)
end

-- 미리보기: 궤적은 색이 이어지는 띠, 부츠는 작은 부츠 한 켤레
local function trailPreview(parent: Instance, item)
	local band = box(parent, Color3.new(1, 1, 1), UDim2.new(1, -24, 0, 22), UDim2.new(0, 12, 0.5, -11), 11)
	local keys = {}
	for i, c in item.colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#item.colors - 1), rgb(c)))
	end
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(keys)
	gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	gradient.Parent = band
end

local function bootsPreview(parent: Instance, item)
	for _, x in { -18, 6 } do
		local left = UDim.new(0.5, x)
		box(parent, rgb(item.body), UDim2.fromOffset(18, 24), UDim2.new(left, UDim.new(0.5, -16)), 4)
		box(parent, rgb(item.accent), UDim2.fromOffset(20, 5), UDim2.new(left - UDim.new(0, 1), UDim.new(0.5, -18)), 2)
		box(parent, rgb(item.sole), UDim2.fromOffset(24, 6), UDim2.new(left - UDim.new(0, 2), UDim.new(0.5, 8)), 3)
	end
end

local function refresh()
	if not gui.Enabled then
		return
	end
	coinsLabel.Text = t("ShopCoins", coins())
	local owned, equipped, balance = decode("ShopOwned"), decode("ShopEquipped"), coins()
	for _, card in cards do
		local item = card.item
		if equipped[item.category] == item.id then
			card.button.Text = t("ShopEquipped")
			card.button.BackgroundColor3 = COLOR.Equipped
		elseif owned[item.id] then
			card.button.Text = t("ShopEquip")
			card.button.BackgroundColor3 = COLOR.Equip
		elseif item.unlock then
			-- 팔지 않는 물건: 그 섬의 별조각을 몇 개 찾았는지
			local found, total = CollectibleLogic.islandProgress(Collectibles, item.unlock, decode("Shards"))
			card.button.Text = t("ShopShardCount", found, total)
			card.button.BackgroundColor3 = COLOR.Locked
		else
			card.button.Text = t("ShopBuy", item.price)
			card.button.BackgroundColor3 = if balance >= item.price then COLOR.Buy else COLOR.Locked
		end
	end
	for category, tab in tabButtons do
		tab.BackgroundColor3 = if category == currentTab then COLOR.Equipped else COLOR.Tab
	end
end

-- 안 가졌으면 사고(사면 바로 입는다), 가졌으면 입고, 입고 있으면 벗는다
local function press(item)
	if busy then
		return
	end
	local owned, equipped = decode("ShopOwned"), decode("ShopEquipped")
	if not owned[item.id] and item.unlock then
		status(t("ShopLocked", t("Island_" .. item.unlock)), COLOR.Gold)
		return
	end
	if not owned[item.id] and coins() < item.price then
		status(t("ShopNoCoins"), COLOR.Fail)
		return
	end
	busy = true
	if not owned[item.id] then
		local ok, reason = buyRemote:InvokeServer(item.id)
		if ok then
			status(t("ShopBought", t("Item_" .. item.id)), COLOR.Gold)
		elseif reason then
			status(t(reason), COLOR.Fail)
		end
	elseif equipped[item.category] == item.id then
		equipRemote:InvokeServer(item.category, nil)
	else
		equipRemote:InvokeServer(item.category, item.id)
	end
	busy = false
	refresh()
end

local function rebuild()
	for _, card in cards do
		card.button.Parent:Destroy()
	end
	table.clear(cards)
	for index, item in Shop.Items do
		if item.category ~= currentTab then
			continue
		end
		local card = box(grid, COLOR.Card, UDim2.new(), UDim2.new(), 12)
		card.Name = "Card_" .. item.id
		card.LayoutOrder = index
		local preview = box(card, COLOR.Preview, UDim2.new(1, -16, 0, 56), UDim2.fromOffset(8, 8), 10)
		if item.category == "Trail" then
			trailPreview(preview, item)
		else
			bootsPreview(preview, item)
		end
		text(card, {
			Text = t("Item_" .. item.id),
			TextSize = 15,
			Size = UDim2.new(1, -12, 0, 30),
			Position = UDim2.fromOffset(6, 66),
		})
		local b = button(card, COLOR.Buy)
		b.Name = item.id
		b.AnchorPoint = Vector2.new(0.5, 1)
		b.Position = UDim2.new(0.5, 0, 1, -8)
		b.Size = UDim2.new(1, -16, 0, 34)
		b.Activated:Connect(function()
			press(item)
		end)
		table.insert(cards, { item = item, button = b })
	end
	refresh()
end

local function layout()
	local camera = workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local width = math.min(600, viewport.X - 24)
	frame.Size = UDim2.fromOffset(width, math.min(440, viewport.Y - 24))
	-- 좁은 화면에서는 카드를 줄여 한 줄에 둘 이상 들어가게 한다
	local narrow = width < 480
	gridLayout.CellSize = if narrow then UDim2.fromOffset(124, 140) else UDim2.fromOffset(170, 140)
end

function ShopUi.open()
	gui.Enabled = true
	layout()
	rebuild()
end

function ShopUi.close()
	gui.Enabled = false
end

function ShopUi.toggle()
	if gui.Enabled then
		ShopUi.close()
	else
		ShopUi.open()
	end
end

local function build()
	gui = Instance.new("ScreenGui")
	gui.Name = "SkyhopShop"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 6
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	frame = box(gui, COLOR.Panel, UDim2.fromOffset(600, 440), UDim2.fromScale(0.5, 0.5), 16)
	frame.Name = "Panel"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 0.08

	text(frame, {
		Text = t("ShopTitle"),
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0.5, 0, 0, 40),
		Position = UDim2.fromOffset(16, 8),
	})
	coinsLabel = text(frame, {
		TextSize = 20,
		TextColor3 = COLOR.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(0.5, -70, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 8),
	})
	local close = button(frame, COLOR.Tab)
	close.Text = "X"
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, -10, 0, 10)
	close.Size = UDim2.fromOffset(40, 36)
	close.Activated:Connect(ShopUi.close)

	for i, category in Shop.Categories do
		local tab = button(frame, COLOR.Tab)
		tab.Name = "Tab_" .. category
		tab.Text = t("ShopTab" .. category)
		tab.Size = UDim2.fromOffset(110, 34)
		tab.Position = UDim2.fromOffset(16 + (i - 1) * 118, 54)
		tab.Activated:Connect(function()
			currentTab = category
			rebuild()
		end)
		tabButtons[category] = tab
	end

	grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Position = UDim2.fromOffset(12, 98)
	grid.Size = UDim2.new(1, -24, 1, -140)
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.ScrollingDirection = Enum.ScrollingDirection.Y
	grid.ScrollBarThickness = 6
	grid.Parent = frame
	gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellPadding = UDim2.fromOffset(10, 10)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	gridLayout.Parent = grid
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = grid

	statusLabel = text(frame, {
		Text = t("ShopNote"),
		TextSize = 15,
		TextColor3 = COLOR.Soft,
		Size = UDim2.new(1, -24, 0, 34),
		Position = UDim2.new(0, 12, 1, -40),
	})
end

local function attachPrompt(inst: Instance)
	if inst:IsA("ProximityPrompt") and inst:GetAttribute("Shop") then
		inst.ActionText = t("ShopPrompt")
		inst.ObjectText = t("ShopTitle")
	end
end

function ShopUi.start()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	buyRemote = remotes:WaitForChild(Remotes.ShopBuy) :: RemoteFunction
	equipRemote = remotes:WaitForChild(Remotes.ShopEquip) :: RemoteFunction
	build()

	for _, name in { "Coins", "ShopOwned", "ShopEquipped", "Shards" } do
		player:GetAttributeChangedSignal(name):Connect(refresh)
	end
	for _, inst in workspace:GetDescendants() do
		attachPrompt(inst)
	end
	workspace.DescendantAdded:Connect(attachPrompt)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		if prompt:GetAttribute("Shop") then
			ShopUi.open()
		end
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.B then
			ShopUi.toggle()
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if gui.Enabled then
				layout()
			end
		end)
	end
end

return ShopUi
]]></ProtectedString>
